# =====================================================================
# Sohba environment template
#
# COPY this file to ".env" (git-ignored) or supply the same values through
# real environment variables / dotnet user-secrets. NEVER commit real values.
#
# ".env" is consumed by both docker-compose.yml (full app + SQL Server stack)
# and docker-compose.dev.yml (optional Elasticsearch log tooling).
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED by docker-compose.yml
# ---------------------------------------------------------------------

# SQL Server SA password inside the db container. SQL Server enforces the
# standard complexity rule (min 8 chars, upper + lower + digit + symbol).
MSSQL_SA_PASSWORD=

# Name of the database the app migrates and uses.
MSSQL_DATABASE=Sohba

# JWT signing key - minimum 32 characters (JwtSettings.Validate enforces this).
JWT_KEY=

# Token issuer/audience. Used for local review defaults; set them to the
# public URL of a real deployment.
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=http://localhost:8080

# Platform Owner bootstrap account. Outside Development the app refuses to
# start when Sohba__Owner__InitialPassword is missing.
SOHBA_OWNER_EMAIL=owner@sohba.local
SOHBA_OWNER_INITIAL_PASSWORD=

# Production by default. Set to Development to also seed demo accounts and
# sample content (DBInitializer development-only seeding).
ASPNETCORE_ENVIRONMENT=Production

# ---------------------------------------------------------------------
# OPTIONAL - Elasticsearch log shipping (Sohba runs fine without it)
# ---------------------------------------------------------------------
SOHBA_ES_URL=http://localhost:9200
SOHBA_ES_USER=elastic
SOHBA_ES_PASSWORD=change-me-dev-password

# Optional: name of an ILM policy to apply to the logs-sohba-* data
# streams for retention (must already exist in Elasticsearch).
# See ELASTICSEARCH.md for a 7-day dev / 30-day prod policy example.
# SOHBA_ES_ILM_POLICY=sohba-logs-dev

# ---------------------------------------------------------------------
# OPTIONAL - Kibana profile in docker-compose.dev.yml
# ---------------------------------------------------------------------
# Service-account token and encryption keys required by Kibana 8.x containers.
# KIBANA_SERVICE_ACCOUNT_TOKEN=
# KIBANA_SECURITY_ENCRYPTION_KEY=
# KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=
# KIBANA_REPORTING_ENCRYPTION_KEY=
