@model Sohba.Application.DTOs.Common.PagedResult<Sohba.Application.DTOs.PostAggregate.SavedPostsGroupedDto>
@{
    ViewData["Title"] = "Saved Posts";
    Layout = "_AppLayout";
}

<div class="max-w-6xl mx-auto px-4 py-6 page-transition space-y-8">

    <!-- Hero Header -->
    <div class="relative overflow-hidden bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-amber-500/10 border border-amber-500/20 rounded-2xl flex items-center justify-center text-amber-600 shadow-sm shrink-0">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Saved Posts & Collections</h1>
                    <p class="text-slate-500 text-sm sm:text-base mt-1">Organize and browse your bookmarked posts by collections</p>
                </div>
            </div>

            @if (Model != null && Model.TotalCount > 0)
            {
                <div class="flex items-center gap-3 bg-slate-50 px-4 py-2.5 rounded-2xl border border-slate-200/60 self-start sm:self-auto">
                    <span class="flex h-2.5 w-2.5 rounded-full bg-amber-500"></span>
                    <span class="text-xs font-bold text-slate-600">@Model.TotalCount @(Model.TotalCount == 1 ? "Post" : "Posts") Saved</span>
                </div>
            }
        </div>
    </div>

    <!-- Collections Feed -->
    @if (Model != null && Model.Items != null && Model.Items.Any())
    {
        <div class="space-y-10">
            @foreach (var group in Model.Items)
            {
                <div class="bg-white/80 backdrop-blur-md rounded-3xl border border-slate-200/70 p-5 sm:p-7 shadow-sm hover:shadow-md transition-shadow" id="collection-group-@group.CollectionId">

                    <!-- Collection Header -->
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4 mb-6">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-2.5 h-6 bg-[#345e69] rounded-full shrink-0"></div>
                            <h2 class="text-xl font-bold text-slate-900 tracking-tight truncate max-w-[60vw] sm:max-w-none">@group.CollectionName</h2>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-500 rounded-lg">
                                @group.Posts.Count @(group.Posts.Count == 1 ? "Item" : "Items")
                            </span>
                            @if (group.CollectionId != Guid.Empty)
                            {
                                <button type="button"
                                        data-action="delete-collection"
                                        data-collection-id="@group.CollectionId"
                                        data-collection-name="@group.CollectionName"
                                        class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-colors"
                                        title="Delete Collection">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Posts Grid -->
                    @if (group.Posts.Any())
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            @foreach (var post in group.Posts)
                            {
                                <partial name="Partials/_PostCard" model="new[] { post }" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-10 bg-slate-50/50 rounded-2xl border border-dashed border-slate-200">
                            <p class="text-sm font-medium text-slate-400">No posts in this collection yet.</p>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-200/80">
                <span class="text-sm font-medium text-slate-500 order-2 sm:order-1">
                    Showing page <span class="font-bold text-slate-800">@Model.Page</span> of <span class="font-bold text-slate-800">@Model.TotalPages</span>
                </span>

                <div class="flex items-center gap-2 order-1 sm:order-2">
                    <!-- Previous Button -->
                    @if (Model.HasPreviousPage)
                    {
                        <a href="/Posts/SavedPosts?page=@(Model.Page - 1)&pageSize=@Model.PageSize"
                           class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all shadow-sm active:scale-95">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                            <span>Previous</span>
                        </a>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-100 text-slate-400 font-semibold rounded-xl cursor-not-allowed opacity-60">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                            <span>Previous</span>
                        </span>
                    }

                    <!-- Page Indicator Badge -->
                    <div class="px-4 py-2.5 bg-[#345e69] text-white font-bold text-sm rounded-xl shadow-sm">
                        @Model.Page
                    </div>

                    <!-- Next Button -->
                    @if (Model.HasNextPage)
                    {
                        <a href="/Posts/SavedPosts?page=@(Model.Page + 1)&pageSize=@Model.PageSize"
                           class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-all shadow-sm active:scale-95">
                            <span>Next</span>
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-100 text-slate-400 font-semibold rounded-xl cursor-not-allowed opacity-60">
                            <span>Next</span>
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </span>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <!-- Empty State View -->
        <div class="text-center py-20 bg-white rounded-3xl border border-slate-100 shadow-sm p-8">
            <div class="w-20 h-20 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-5 shadow-inner">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900">No saved posts yet</h3>
            <p class="text-slate-500 mt-2 max-w-sm mx-auto text-sm">When you save posts or bookmark collections, they will show up organized here.</p>
            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center gap-2 mt-6 px-6 py-3 bg-[#345e69] text-white font-bold rounded-2xl hover:bg-[#2a4b55] transition-all shadow-md active:scale-95">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m7-7l-7 7 7 7" />
                </svg>
                <span>Browse Feed</span>
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-action="delete-collection"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    const collectionId = this.dataset.collectionId;
                    const collectionName = this.dataset.collectionName || 'this collection';

                    window.showConfirmModal({
                        title: 'Delete Collection',
                        message: `Are you sure you want to delete "${collectionName}"? The collection will be removed, but your posts will remain in All Saved.`,
                        type: 'delete',
                        confirmText: 'Delete',
                        onConfirm: async () => {
                            try {
                                const result = await SohbaApp.post('/Posts/DeleteCollection', { collectionId: collectionId });
                                if (result.success) {
                                    SohbaApp.toast('Collection deleted successfully.', 'success');
                                    const groupEl = document.getElementById(`collection-group-${collectionId}`);
                                    if (groupEl) {
                                        groupEl.style.transition = 'opacity 0.3s ease';
                                        groupEl.style.opacity = '0';
                                        setTimeout(() => groupEl.remove(), 300);
                                    }
                                } else {
                                    SohbaApp.toast(result.error || 'Failed to delete collection.', 'error');
                                }
                            } catch (err) {
                                console.error('Delete collection error:', err);
                                SohbaApp.toast('Network error.', 'error');
                            }
                        }
                    });
                });
            });
        });
    </script>
}
