@model Sohba.ViewModels.Post.PostEditViewModel
@{
    ViewData["Title"] = "Edit Post";
    Layout = "_AppLayout";
}

<div class="max-w-3xl mx-auto page-transition">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover-lift">
        <div class="bg-gradient-to-br from-[#345e69] via-[#407380] to-[#4a8291] p-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
            <div class="relative z-10">
                <h1 class="text-3xl font-black text-white tracking-tight">Edit Post</h1>
                <p class="text-white/80 mt-1 font-medium italic opacity-90">Update your post content.</p>
            </div>
        </div>

        <form id="editPostForm" class="p-6 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" id="postId" value="@Model.Id" />

            <div id="editPostError" class="hidden text-red-600 text-sm bg-red-50 border border-red-100 rounded-xl p-3"></div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Title</label>
                <input type="text" id="postTitle" value="@Model.Title"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all"
                       placeholder="Post title..." />
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Content</label>
                <textarea id="postContent" rows="6"
                          class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all resize-none"
                          placeholder="What's on your mind?">@Model.Content</textarea>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Privacy</label>
                <select id="postPrivacy" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all">
                    <option value="0" selected="@(Model.Privacy == Sohba.Domain.Enums.PostPrivacy.Public)">Public</option>
                    <option value="1" selected="@(Model.Privacy == Sohba.Domain.Enums.PostPrivacy.Friends)">Friends Only</option>
                    <option value="2" selected="@(Model.Privacy == Sohba.Domain.Enums.PostPrivacy.Private)">Private (Only Me)</option>
                </select>
            </div>

            <!-- Existing Images Section -->
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Current Images (<span id="existingCount">@Model.ExistingImageUrls.Count</span>)</label>
                <div id="existingImagesGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-3 bg-slate-50 rounded-2xl border border-slate-200">
                    @for (int i = 0; i < Model.ExistingImageUrls.Count; i++)
                    {
                        var imgUrl = Model.ExistingImageUrls[i];
                        <div class="relative bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200 existing-image-card" data-url="@imgUrl">
                            <img src="@imgUrl" class="w-full h-28 object-cover" />
                            <div class="p-1.5 flex justify-between items-center bg-white text-xs">
                                <span class="text-slate-400 font-bold">#@(i + 1)</span>
                                <button type="button" onclick="removeExistingImage(this, '@imgUrl')" class="p-1 text-red-600 hover:bg-red-50 rounded font-bold" title="Remove image">✕</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Add New Images Section -->
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Add New Images</label>
                <input type="file" id="newImageFiles" accept="image/*" multiple
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer" />
                <div id="newImagesPreviewGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-3 hidden"></div>
            </div>

            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Details" asp-route-id="@Model.Id" class="flex-1 py-2.5 border border-gray-200 text-gray-600 font-semibold rounded-xl hover:bg-gray-50 transition-colors text-center">
                    Cancel
                </a>
                <button type="submit" id="editPostSubmitBtn" class="flex-1 py-2.5 bg-[#345e69] hover:bg-[#2a4b55] text-white font-semibold rounded-xl shadow-lg shadow-[#345e69]/30 transform active:scale-95 transition-all">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
         let retainedUrls = Array.from(document.querySelectorAll('.existing-image-card')).map(el => el.dataset.url);
        let selectedNewFiles = [];

        function removeExistingImage(button, url) {
            retainedUrls = retainedUrls.filter(u => u !== url);
            button.closest('.existing-image-card').remove();
            document.getElementById('existingCount').textContent = retainedUrls.length;
        }

        document.getElementById('newImageFiles')?.addEventListener('change', function (e) {
            const files = Array.from(e.target.files || []);
            const grid = document.getElementById('newImagesPreviewGrid');
            grid.innerHTML = '';
            selectedNewFiles = [];

            if (files.length === 0) {
                grid.classList.add('hidden');
                return;
            }
            grid.classList.remove('hidden');

            files.forEach(file => {
                if (file.size > 5 * 1024 * 1024) {
                    window.SohbaApp.toast(`File ${file.name} exceeds 5MB`, 'error');
                    return;
                }
                selectedNewFiles.push(file);
                const reader = new FileReader();
                reader.onload = function (ev) {
                    const card = document.createElement('div');
                    card.className = 'bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200';
                    card.innerHTML = `<img src="${ev.target.result}" class="w-full h-28 object-cover" /><div class="p-1 text-xs text-emerald-600 font-bold text-center">New</div>`;
                    grid.appendChild(card);
                };
                reader.readAsDataURL(file);
            });
        });

        document.getElementById('editPostForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const errorBox = document.getElementById('editPostError');
            errorBox.classList.add('hidden');

            const submitBtn = document.getElementById('editPostSubmitBtn');
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Saving...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append('Id', document.getElementById('postId').value);
                formData.append('Title', document.getElementById('postTitle').value.trim());
                formData.append('Content', document.getElementById('postContent').value.trim());
                formData.append('Privacy', document.getElementById('postPrivacy').value);

                retainedUrls.forEach(url => {
                    formData.append('RetainedImageUrls', url);
                });

                selectedNewFiles.forEach(file => {
                    formData.append('NewImageFiles', file);
                });

                const response = await fetch('/Posts/Edit', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    window.SohbaApp.toast('Post updated successfully', 'success');
                    setTimeout(() => {
                        window.location.href = `/Posts/Details/${document.getElementById('postId').value}`;
                    }, 800);
                } else {
                    errorBox.textContent = result.error || 'Failed to update post';
                    errorBox.classList.remove('hidden');
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;
                }
            } catch (error) {
                console.error('Edit post error:', error);
                errorBox.textContent = 'Network error, please try again';
                errorBox.classList.remove('hidden');
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            }
        });
    </script>
}
