@model Sohba.Application.DTOs.Common.PagedResult<Sohba.Application.DTOs.GroupAndPageAggregate.GroupJoinRequestDto>
@{
    var groupId = ViewBag.GroupId;
}

<div class="bg-white rounded-2xl p-4 sm:p-6 shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-lg sm:text-xl font-black text-gray-900">Pending Join Requests (@Model.TotalCount)</h2>
            <p class="text-xs text-gray-500 mt-0.5">Review users requesting to join this private community</p>
        </div>
    </div>

    <div class="space-y-3" id="joinRequestsList">
        @if (Model.Items != null && Model.Items.Any())
        {
            @foreach (var request in Model.Items)
            {
                <div class="p-4 bg-slate-50/80 rounded-2xl border border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all" id="request-card-@request.Id">
                    <div class="flex items-start gap-3.5 min-w-0">
                        <img src="@(request.UserAvatarUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(request.UserName)}&background=345e69&color=fff")"
                             class="w-12 h-12 rounded-full object-cover shadow-sm border-2 border-white shrink-0" alt="@request.UserName" />
                        
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <a href="/Profile/Index/@request.UserId" class="font-bold text-gray-900 text-sm hover:text-[#345e69] transition-colors">
                                    @request.UserName
                                </a>
                                <span class="text-[11px] text-gray-400">• @request.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(request.Reason))
                            {
                                <p class="text-xs text-gray-600 mt-1 bg-white p-2.5 rounded-xl border border-slate-100 whitespace-pre-line">
                                    <span class="font-semibold text-slate-700">Reason:</span> @request.Reason
                                </p>
                            }
                            else
                            {
                                <p class="text-xs text-gray-400 italic mt-1">No reason provided.</p>
                            }
                        </div>
                    </div>

                    <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
                        <button type="button" onclick="reviewJoinRequest('@groupId', '@request.Id', true)"
                                class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow-sm transition active:scale-95">
                            Accept
                        </button>
                        <button type="button" onclick="reviewJoinRequest('@groupId', '@request.Id', false)"
                                class="px-4 py-2 bg-slate-200 hover:bg-red-50 hover:text-red-600 text-slate-700 font-bold rounded-xl text-xs transition active:scale-95">
                            Reject
                        </button>
                    </div>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <div class="flex items-center justify-between border-t border-slate-100 pt-4 mt-6">
                    <span class="text-xs text-slate-500">Page @Model.Page of @Model.TotalPages</span>
                    <div class="flex gap-2">
                        @if (Model.HasPreviousPage)
                        {
                            <button type="button" onclick="loadJoinRequestsTab('@groupId', @(Model.Page - 1))"
                                    class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-100">
                                Previous
                            </button>
                        }
                        @if (Model.HasNextPage)
                        {
                            <button type="button" onclick="loadJoinRequestsTab('@groupId', @(Model.Page + 1))"
                                    class="px-3 py-1.5 bg-[#345e69] text-white rounded-xl text-xs font-bold hover:bg-[#2a4b55]">
                                Next
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-12 text-gray-500">
                <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-2">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-800 text-sm">No pending requests</h3>
                <p class="text-xs text-gray-400 mt-0.5">All membership applications have been reviewed.</p>
            </div>
        }
    </div>
</div>