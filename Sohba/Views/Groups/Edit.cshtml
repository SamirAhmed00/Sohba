@model Sohba.ViewModels.Group.GroupEditViewModel
@{
    ViewData["Title"] = "Edit Group";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover-lift">
        <div class="bg-gradient-to-br from-[#345e69] via-[#407380] to-[#4a8291] p-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 left-10 w-24 h-24 bg-black/5 rounded-full blur-2xl"></div>

            <div class="relative z-10">
                <div class="flex items-center gap-4">
                    <div class="p-3 bg-white rounded-2xl shadow-xl shadow-black/10 transition-transform hover:scale-105 duration-300">
                        <svg class="w-8 h-8 text-[#345e69]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">Edit Group</h1>
                        <p class="text-white/80 mt-1 font-medium italic opacity-90">Update your group information.</p>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="p-6 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-red-500 text-sm space-y-1"></div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Group Name</label>
                <input asp-for="Name"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all"
                       placeholder="Enter group name..." />
            </div>

            <input type="hidden" asp-for="ImageUrl" />
            <input type="hidden" asp-for="BackgroundImageUrl" />

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Description</label>
                <textarea asp-for="Description" rows="4"
                          class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all resize-none"
                          placeholder="What's this group about?"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Group Rules (Optional)</label>
                <textarea asp-for="Rules" rows="3"
                          class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all resize-none"
                          placeholder="Update community rules..."></textarea>
                <span asp-validation-for="Rules" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Privacy</label>
                <select asp-for="IsPrivate" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all">
                    <option value="false">Public - Anyone can see and join</option>
                    <option value="true">Private - Only members can see group posts</option>
                </select>
            </div>

            <!-- Current Avatar Preview -->
            <div id="currentImagePreviewContainer" class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "hidden" : "")">
                <label class="block text-sm font-bold text-gray-700 mb-2">Current Avatar</label>
                <img id="currentImagePreview" src="@Model.ImageUrl" class="w-32 h-32 rounded-xl object-cover border border-slate-200" />
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Group Avatar (Optional)</label>
                <input asp-for="ImageFile" type="file" accept="image/*"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer" />
                <p class="text-xs text-gray-500 mt-2">Leave empty to keep current avatar. PNG, JPG up to 5MB.</p>
            </div>

            <!-- Current Cover Preview -->
            <div id="currentBackgroundPreviewContainer" class="@(string.IsNullOrEmpty(Model.BackgroundImageUrl) ? "hidden" : "")">
                <label class="block text-sm font-bold text-gray-700 mb-2">Current Cover Image</label>
                <img id="currentBackgroundPreview" src="@Model.BackgroundImageUrl" class="w-full h-36 rounded-xl object-cover border border-slate-200" />
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Cover Image (Optional)</label>
                <input asp-for="BackgroundImageFile" type="file" accept="image/*"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer" />
                <p class="text-xs text-gray-500 mt-2">Leave empty to keep current cover image. PNG, JPG up to 5MB.</p>
            </div>


            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Details" asp-route-id="@Model.Id" class="flex-1 py-2.5 border border-gray-200 text-gray-600 font-semibold rounded-xl hover:bg-gray-50 transition-colors text-center">
                    Cancel
                </a>
                <button type="submit" class="flex-1 py-2.5 bg-[#345e69] hover:bg-[#2a4b55] text-white font-semibold rounded-xl shadow-lg shadow-[#345e69]/30 transform active:scale-95 transition-all">
                    Update Group
                </button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('ImageFile')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (ev) {
                document.getElementById('currentImagePreview').src = ev.target.result;
                document.getElementById('currentImagePreviewContainer').classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        });

        document.getElementById('BackgroundImageFile')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (ev) {
                document.getElementById('currentBackgroundPreview').src = ev.target.result;
                document.getElementById('currentBackgroundPreviewContainer').classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        });
    </script>
}