@using Sohba.Domain.Enums
@model Sohba.Application.DTOs.Common.PagedResult<Sohba.Application.DTOs.GroupAndPageAggregate.GroupMemberDto>

@{
    var groupId = ViewBag.GroupId;

    var currentUserId =
        ViewBag.CurrentUserId != null
            ? (Guid)ViewBag.CurrentUserId
            : Guid.Empty;

    var groupAdminId =
        ViewBag.GroupAdminId != null
            ? (Guid)ViewBag.GroupAdminId
            : Guid.Empty;

    var isCurrentOwner =
        currentUserId != Guid.Empty &&
        currentUserId == groupAdminId;

    var currentUserRole = ViewBag.CurrentUserRole as GroupRole?;

    var isCurrentAdmin =
        isCurrentOwner ||
        currentUserRole == GroupRole.Admin;

    var isCurrentCoAdmin =
        isCurrentAdmin ||
        currentUserRole == GroupRole.CoAdmin;

    var searchTerm =
        ViewBag.SearchTerm as string ?? string.Empty;
}

<div class="bg-white rounded-2xl p-4 sm:p-6 shadow-sm border border-slate-100">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">

        <div>
            <h2 class="text-lg sm:text-xl font-black text-gray-900">
                All Members (@Model.TotalCount)
            </h2>

            <p class="text-xs text-gray-500 mt-0.5">
                Community leaders and participants
            </p>
        </div>

        <!-- Server-Side Search Form -->
        <div class="flex items-center gap-2 w-full sm:w-auto">

            <div class="relative flex-1 sm:w-64">

                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-4 h-4"
                         fill="none"
                         viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>

                <input type="text"
                       id="memberSearchInput"
                       value="@searchTerm"
                       placeholder="Search members..."
                       onkeydown="if(event.key==='Enter'){ executeMemberSearch('@groupId'); }"
                       class="w-full pl-9 pr-8 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition" />

                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button type="button"
                            onclick="clearMemberSearch('@groupId')"
                            class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-gray-400 hover:text-gray-600">

                        <svg class="w-4 h-4"
                             fill="none"
                             viewBox="0 0 24 24">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
            </div>

            <button type="button"
                    onclick="executeMemberSearch('@groupId')"
                    class="px-4 py-2 bg-[#345e69] hover:bg-[#2a4b55] text-white text-xs font-bold rounded-xl transition-colors shrink-0">
                Search
            </button>
        </div>
    </div>

    <!-- Members Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4"
         id="membersGrid">

        @if (Model.Items != null && Model.Items.Any())
        {
            foreach (var member in Model.Items)
            {
                var isMemberOwner = member.IsOwner;
                var memberRole = member.Role;

                var isTargetAdmin =
                    memberRole == GroupRole.Admin;

                var isTargetCoAdmin =
                    memberRole == GroupRole.CoAdmin;

                var isTargetMember =
                    memberRole == GroupRole.Member;

                <div class="member-card bg-slate-50/70 hover:bg-slate-50 p-4 rounded-2xl border border-slate-100 transition-all flex flex-col items-center justify-between text-center"
                     id="member-card-@member.UserId">

                    <a asp-controller="Profile"
                       asp-action="Index"
                       asp-route-id="@member.UserId"
                       class="cursor-pointer block w-full">

                        <div class="relative w-16 h-16 mx-auto mb-2.5">

                            <img src="@(member.UserAvatarUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(member.UserName)}&background=345e69&color=fff")"
                                 class="w-16 h-16 rounded-full object-cover shadow-sm border-2 border-white mx-auto"
                                 alt="@member.UserName" />

                            @if (isMemberOwner)
                            {
                                <span class="absolute -top-1 -right-1 w-5 h-5 bg-amber-500 text-white text-[10px] rounded-full flex items-center justify-center font-bold border-2 border-white shadow-sm"
                                      title="Group Owner">
                                    ★
                                </span>
                            }
                            else if (isTargetAdmin)
                            {
                                <span class="absolute -top-1 -right-1 w-5 h-5 bg-[#345e69] text-white text-[10px] rounded-full flex items-center justify-center font-bold border-2 border-white shadow-sm"
                                      title="Admin">
                                    🛡
                                </span>
                            }
                            else if (isTargetCoAdmin)
                            {
                                <span class="absolute -top-1 -right-1 w-5 h-5 bg-teal-500 text-white text-[10px] rounded-full flex items-center justify-center font-bold border-2 border-white shadow-sm"
                                      title="Co-Admin">
                                    ✦
                                </span>
                            }
                        </div>

                        <p class="text-sm font-bold text-gray-900 truncate hover:text-[#345e69] transition-colors"
                           title="@member.UserName">
                            @member.UserName
                        </p>

                        <div class="mt-0.5">

                            @if (isMemberOwner)
                            {
                                <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
                                    Owner
                                </span>
                            }
                            else if (isTargetAdmin)
                            {
                                <span class="text-xs font-bold text-[#345e69] bg-[#345e69]/10 px-2 py-0.5 rounded-full">
                                    Admin
                                </span>
                            }
                            else if (isTargetCoAdmin)
                            {
                                <span class="text-xs font-bold text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full border border-teal-200">
                                    Co-Admin
                                </span>
                            }
                            else
                            {
                                <span class="text-xs font-semibold text-gray-500">
                                    Member
                                </span>
                            }
                        </div>

                        <p class="text-[11px] text-gray-400 mt-1.5">
                            Joined @member.JoinedAt.ToString("MMM yyyy")
                        </p>

                    </a>

                    <!-- Management Actions (Authority-Enforced) -->
                    @if (currentUserId != member.UserId && !isMemberOwner)
                    {
                        <div class="flex items-center gap-1.5 mt-3 pt-3 border-t border-slate-200/60 w-full justify-center flex-wrap">

                            @if (isCurrentOwner)
                            {
                                @if (isTargetAdmin)
                                {
                                    <button type="button"
                                            onclick="demoteMember('@groupId', '@member.UserId', 'Co-Admin')"
                                            class="text-xs px-2.5 py-1 bg-amber-50 text-amber-700 hover:bg-amber-100 rounded-lg font-semibold transition"
                                            title="Demote to Co-Admin">
                                        Demote
                                    </button>

                                    <button type="button"
                                            onclick="kickMember('@groupId', '@member.UserId')"
                                            class="text-xs px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg font-semibold transition"
                                            title="Remove from group">
                                        Kick
                                    </button>
                                }
                                else if (isTargetCoAdmin)
                                {
                                    <button type="button"
                                            onclick="promoteMember('@groupId', '@member.UserId', 'Admin')"
                                            class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 rounded-lg font-semibold transition"
                                            title="Promote to Admin">
                                        Promote
                                    </button>

                                    <button type="button"
                                            onclick="demoteMember('@groupId', '@member.UserId', 'Member')"
                                            class="text-xs px-2.5 py-1 bg-amber-50 text-amber-700 hover:bg-amber-100 rounded-lg font-semibold transition"
                                            title="Demote to Member">
                                        Demote
                                    </button>

                                    <button type="button"
                                            onclick="kickMember('@groupId', '@member.UserId')"
                                            class="text-xs px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg font-semibold transition"
                                            title="Remove from group">
                                        Kick
                                    </button>
                                }
                                else if (isTargetMember)
                                {
                                    <button type="button"
                                            onclick="promoteMember('@groupId', '@member.UserId', 'Co-Admin')"
                                            class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 rounded-lg font-semibold transition"
                                            title="Promote to Co-Admin">
                                        Promote
                                    </button>

                                    <button type="button"
                                            onclick="kickMember('@groupId', '@member.UserId')"
                                            class="text-xs px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg font-semibold transition"
                                            title="Remove from group">
                                        Kick
                                    </button>
                                }
                            }
                            else if (currentUserRole == GroupRole.Admin)
                            {
                                @if (isTargetCoAdmin)
                                {
                                    <button type="button"
                                            onclick="demoteMember('@groupId', '@member.UserId', 'Member')"
                                            class="text-xs px-2.5 py-1 bg-amber-50 text-amber-700 hover:bg-amber-100 rounded-lg font-semibold transition"
                                            title="Demote to Member">
                                        Demote
                                    </button>

                                    <button type="button"
                                            onclick="kickMember('@groupId', '@member.UserId')"
                                            class="text-xs px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg font-semibold transition"
                                            title="Remove from group">
                                        Kick
                                    </button>
                                }
                                else if (isTargetMember)
                                {
                                    <button type="button"
                                            onclick="promoteMember('@groupId', '@member.UserId', 'Co-Admin')"
                                            class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 rounded-lg font-semibold transition"
                                            title="Promote to Co-Admin">
                                        Promote
                                    </button>

                                    <button type="button"
                                            onclick="kickMember('@groupId', '@member.UserId')"
                                            class="text-xs px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg font-semibold transition"
                                            title="Remove from group">
                                        Kick
                                    </button>
                                }
                            }
                            else if (isCurrentCoAdmin && isTargetMember)
                            {
                                <button type="button"
                                        onclick="kickMember('@groupId', '@member.UserId')"
                                        class="text-xs px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg font-semibold transition"
                                        title="Remove from group">
                                    Kick
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="col-span-full text-center py-12 text-gray-500">
                <p class="text-sm">
                    No members found matching your search.
                </p>
            </div>
        }
    </div>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-slate-100 pt-4 mt-6">

            <span class="text-xs text-slate-500">
                Page @Model.Page of @Model.TotalPages
                (@Model.TotalCount members)
            </span>

            <div class="flex gap-2">

                @if (Model.HasPreviousPage)
                {
                    <button type="button"
                            onclick="loadMembersPaged('@groupId', '@searchTerm', @(Model.Page - 1))"
                            class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-100">
                        Previous
                    </button>
                }

                @if (Model.HasNextPage)
                {
                    <button type="button"
                            onclick="loadMembersPaged('@groupId', '@searchTerm', @(Model.Page + 1))"
                            class="px-3 py-1.5 bg-[#345e69] text-white rounded-xl text-xs font-bold hover:bg-[#2a4b55]">
                        Next
                    </button>
                }

            </div>
        </div>
    }
</div>