@model Sohba.Application.DTOs.GroupAndPageAggregate.GroupResponseDto

<div id="joinRequestModal" class="fixed inset-0 z-[1000] hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeJoinRequestModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="flex items-center justify-between p-4 sm:p-5 border-b border-slate-100 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                        🔒
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-gray-900">Request to Join @Model.Name</h3>
                        <p class="text-xs text-gray-500">Private Community</p>
                    </div>
                </div>
                <button type="button" onclick="closeJoinRequestModal()" class="p-1.5 text-gray-400 hover:text-gray-600 rounded-xl hover:bg-gray-100">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Body -->
            <div class="p-5 space-y-4 overflow-y-auto">
                @if (!string.IsNullOrWhiteSpace(Model.Rules))
                {
                    <div class="p-4 bg-amber-50/80 rounded-2xl border border-amber-100">
                        <h4 class="text-xs font-bold text-amber-900 uppercase tracking-wider mb-1">📜 Group Rules</h4>
                        <p class="text-xs text-amber-800 leading-relaxed whitespace-pre-line">
                            @Model.Rules
                        </p>
                    </div>
                }

                <div>
                    <label for="joinRequestReasonInput" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        Why do you want to join this group? (Optional)
                    </label>
                    <textarea id="joinRequestReasonInput" rows="3"
                              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] resize-none"
                              placeholder="Tell the group admins why you'd like to be part of this community..."></textarea>
                </div>
            </div>

            <!-- Footer -->
            <div class="p-4 border-t border-slate-100 bg-slate-50/50 flex gap-3 shrink-0">
                <button type="button" onclick="closeJoinRequestModal()"
                        class="flex-1 py-2.5 border border-gray-200 text-gray-600 font-semibold rounded-xl hover:bg-gray-100 transition">
                    Cancel
                </button>
                <button type="button" id="submitJoinRequestBtn" onclick="submitJoinRequest('@Model.Id')"
                        class="flex-1 py-2.5 bg-[#345e69] hover:bg-[#2a4b55] text-white font-bold rounded-xl shadow-md shadow-[#345e69]/20 transition active:scale-95">
                    Send Request
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function openJoinRequestModal() {
        document.getElementById('joinRequestReasonInput').value = '';
        document.getElementById('joinRequestModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeJoinRequestModal() {
        document.getElementById('joinRequestModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    async function submitJoinRequest(groupId) {
        const btn = document.getElementById('submitJoinRequestBtn');
        const reason = document.getElementById('joinRequestReasonInput').value.trim();

        btn.disabled = true;
        btn.textContent = 'Submitting...';

        try {
            const result = await SohbaApp.post('/Groups/SubmitJoinRequest', {
                groupId: groupId,
                reason: reason
            });

            if (result.success) {
                SohbaApp.toast('Join request sent successfully!', 'success');
                closeJoinRequestModal();
                const reqBtn = document.getElementById('groupRequestBtn');
                if (reqBtn) {
                    reqBtn.outerHTML = `<button type="button" disabled class="px-6 sm:px-8 py-2.5 bg-amber-50 text-amber-700 border border-amber-200 text-xs sm:text-sm font-bold rounded-xl opacity-80 cursor-not-allowed">⏳ Request Pending</button>`;
                }
            } else {
                SohbaApp.toast(result.error || 'Failed to submit request', 'error');
            }
        } catch (err) {
            console.error(err);
            SohbaApp.toast('Network error while sending request', 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Send Request';
        }
    }
</script>