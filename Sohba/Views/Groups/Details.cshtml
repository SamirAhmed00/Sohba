@using Sohba.Domain.Enums
@model Sohba.ViewModels.Group.GroupDetailsViewModel

@{
    ViewData["Title"] = Model.Group.Name;
    Layout = "_AppLayout";

    var isMember = Model.Group.IsCurrentUserMember;
    var currentUserId = ViewBag.CurrentUserId != null ? (Guid)ViewBag.CurrentUserId : Guid.Empty;
    var isOwner = currentUserId != Guid.Empty && currentUserId == Model.Group.AdminId;

    // IMPORTANT:
    // - Group Owner is determined by Group.AdminId.
    // - Global/system Admin is determined by User.IsInRole("Admin").
    // - Group-level Admin is determined by GroupRole.Admin.
    var currentUserRole = ViewBag.CurrentUserRole as GroupRole?;

    var isAdminOrOwner =
        isOwner ||
        User.IsInRole("Admin") ||
        currentUserRole == GroupRole.Admin;
}

@Html.AntiForgeryToken()

<div class="max-w-7xl mx-auto page-transition px-2 sm:px-4">
    <!-- Header Card -->
    <div class="bg-white rounded-2xl sm:rounded-3xl shadow-sm border border-slate-100 overflow-hidden mb-6">

        <!-- Cover Banner (Overflow Hidden isolated here) -->
        <div class="h-44 sm:h-64 bg-gradient-to-r from-[#345e69] via-[#407380] to-[#4a8291] relative overflow-hidden @(!string.IsNullOrEmpty(Model.Group.BackgroundImageUrl) ? "cursor-pointer group" : "")"
            @if (!string.IsNullOrEmpty(Model.Group.BackgroundImageUrl))
            {
                <text>onclick="SohbaApp.openImageLightbox('@Model.Group.BackgroundImageUrl')"</text>
            }
            >
                @if (!string.IsNullOrEmpty(Model.Group.BackgroundImageUrl))
                {
                    <img src="@Model.Group.BackgroundImageUrl"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                         alt="Group background" />

                    <div class="absolute inset-0 bg-black/15 group-hover:bg-black/25 transition-colors"></div>
                }
            </div>

    <!-- Unclipped Avatar Wrapper & Header Info Bar -->
    <div class="px-4 sm:px-8 pb-5">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 -mt-12 sm:-mt-16 mb-2 relative z-20">

            <!-- Overlapping Avatar -->
            <div class="w-24 h-24 sm:w-32 sm:h-32 bg-white p-1.5 sm:p-2 rounded-2xl sm:rounded-3xl shadow-xl ring-4 ring-white shrink-0 @(!string.IsNullOrEmpty(Model.Group.ImageUrl) ? "cursor-pointer" : "")"
                @if (!string.IsNullOrEmpty(Model.Group.ImageUrl))
                {
                    <text>onclick="SohbaApp.openImageLightbox('@Model.Group.ImageUrl')"</text>
                }
                >
                    @if (!string.IsNullOrEmpty(Model.Group.ImageUrl))
                    {
                        <img src="@Model.Group.ImageUrl"
                                class="w-full h-full rounded-xl sm:rounded-2xl object-cover hover:scale-105 transition-transform duration-300"
                                alt="@Model.Group.Name" />
                    }
                    else
                    {
                        <div class="w-full h-full bg-slate-100 rounded-xl sm:rounded-2xl flex items-center justify-center text-[#345e69] text-3xl sm:text-4xl font-black">
                            @(string.IsNullOrWhiteSpace(Model.Group.Name)
                                ? "G"
                                : Model.Group.Name[0].ToString().ToUpper())
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-2 sm:gap-3 flex-wrap">

                    @if (isAdminOrOwner)
                    {
                        <a asp-action="Edit"
                            asp-route-id="@Model.Group.Id"
                            class="px-4 sm:px-5 py-2.5 bg-slate-100 text-gray-700 text-xs sm:text-sm font-bold rounded-xl hover:bg-slate-200 transition-all flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            Edit
                        </a>

                        <button type="button"
                                onclick="openGroupDeleteReasonModal()"
                                class="px-4 sm:px-5 py-2.5 bg-red-50 text-red-600 text-xs sm:text-sm font-bold rounded-xl hover:bg-red-100 transition-all flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Delete
                        </button>
                    }

                    @if (isMember)
                    {
                        <button type="button"
                                onclick="leaveGroup('@Model.Group.Id')"
                                class="px-4 sm:px-5 py-2.5 bg-slate-100 hover:bg-red-50 text-slate-700 hover:text-red-600 text-xs sm:text-sm font-bold rounded-xl transition-all">
                            Leave Group
                        </button>
                    }
                    else if (Model.Group.IsPrivate)
                    {
                        @if (Model.UserJoinRequestStatus == GroupJoinRequestStatus.Pending)
                        {
                            <button type="button"
                                    disabled
                                    class="px-6 sm:px-8 py-2.5 bg-amber-50 text-amber-700 border border-amber-200 text-xs sm:text-sm font-bold rounded-xl opacity-80 cursor-not-allowed">
                                ⏳ Request Pending
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    id="groupRequestBtn"
                                    onclick="openJoinRequestModal()"
                                    class="px-6 sm:px-8 py-2.5 bg-[#345e69] text-white text-xs sm:text-sm font-bold rounded-xl hover:bg-[#2a4b55] shadow-md shadow-[#345e69]/20 transition-all active:scale-95">
                                Request to Join
                            </button>
                        }
                    }
                    else
                    {
                        <button type="button"
                                id="groupJoinBtn"
                                onclick="joinGroup('@Model.Group.Id', this)"
                                class="px-6 sm:px-8 py-2.5 bg-[#345e69] text-white text-xs sm:text-sm font-bold rounded-xl hover:bg-[#2a4b55] shadow-md shadow-[#345e69]/20 transition-all active:scale-95">
                            Join Group
                        </button>
                    }
                </div>
            </div>

            <!-- Group Info -->
            <div class="mt-2">
                <div class="flex items-center gap-2.5 flex-wrap">
                    <h1 class="text-2xl sm:text-3xl font-black text-gray-900 truncate">
                        @Model.Group.Name
                    </h1>

                    @if (Model.Group.IsPrivate)
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                            🔒 Private Group
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            🌐 Public Group
                        </span>
                    }
                </div>

                <p class="text-gray-500 mt-1 flex items-center gap-2 text-xs sm:text-sm flex-wrap">
                    <span class="font-bold text-[#345e69]">
                        @Model.Group.MembersCount Members
                    </span>

                    <span>•</span>

                    <span>
                        Admin:
                        <span class="font-semibold text-slate-700">
                            @Model.Group.AdminName
                        </span>
                    </span>

                    <span>•</span>

                    <span>
                        Created @Model.Group.CreatedAt.ToString("MMM yyyy")
                    </span>
                </p>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="px-4 sm:px-8 border-t border-slate-100 flex gap-6 sm:gap-8 overflow-x-auto hide-scrollbar"
                id="groupTabsBar">

            <button type="button"
                    data-group-tab="posts"
                    onclick="Group_SwitchTab('posts')"
                    class="py-3.5 sm:py-4 border-b-2 border-[#345e69] text-[#345e69] font-bold text-sm whitespace-nowrap transition-colors">
                Posts
            </button>

            <button type="button"
                    data-group-tab="members"
                    onclick="Group_SwitchTab('members')"
                    class="py-3.5 sm:py-4 border-b-2 border-transparent text-gray-400 hover:text-gray-600 font-bold text-sm whitespace-nowrap transition-colors">
                Members (@Model.Group.MembersCount)
            </button>

            <button type="button"
                    data-group-tab="about"
                    onclick="Group_SwitchTab('about')"
                    class="py-3.5 sm:py-4 border-b-2 border-transparent text-gray-400 hover:text-gray-600 font-bold text-sm whitespace-nowrap transition-colors">
                About
            </button>

            @if (Model.CanManageRequests && Model.Group.IsPrivate)
            {
                <button type="button"
                        data-group-tab="requests"
                        onclick="Group_SwitchTab('requests')"
                        class="py-3.5 sm:py-4 border-b-2 border-transparent text-gray-400 hover:text-gray-600 font-bold text-sm whitespace-nowrap transition-colors flex items-center gap-1.5">

                    <span>Requests</span>

                    <span id="pendingRequestsBadge"
                            class="@(Model.PendingRequestsCount > 0 ? "" : "hidden") px-2 py-0.5 bg-red-500 text-white rounded-full text-[10px] font-black">
                        @Model.PendingRequestsCount
                    </span>
                </button>
            }
        </div>
    </div>

<!-- Main Content Grid -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left: Active Content Section -->
    <div class="lg:col-span-2 space-y-6">

        @if (isMember)
        {
            <!-- Groups-Specific Composer Trigger -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex items-center gap-3 sm:gap-4">

                <div class="w-10 h-10 rounded-full bg-[#345e69]/10 flex items-center justify-center text-[#345e69] font-bold shrink-0">
                    @(User.Identity?.Name?.Length > 0
                        ? User.Identity.Name[0].ToString().ToUpper()
                        : "U")
                </div>

                <button type="button"
                        onclick="openGroupCreatePostModal('@Model.Group.Id', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Group.Name))')"
                        class="flex-1 bg-slate-50 hover:bg-slate-100 text-left px-4 sm:px-5 py-2.5 rounded-xl text-gray-500 text-sm transition-all border border-slate-100 cursor-pointer">
                    Share something with @Model.Group.Name...
                </button>
            </div>
        }

        <div id="group-content-area">
            <div class="bg-white rounded-2xl p-12 text-center text-gray-400 border border-slate-100">
                <div class="w-8 h-8 border-2 border-[#345e69] border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
                <p class="text-sm">Loading content...</p>
            </div>
        </div>
    </div>

    <!-- Right: Sidebar Information -->
    <div class="space-y-6">

        <!-- About Card -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            <h3 class="font-black text-gray-900 mb-3 text-base">
                About Community
            </h3>

            <p class="text-gray-600 text-sm leading-relaxed whitespace-pre-line">
                @Model.Group.Description
            </p>

            <div class="mt-4 pt-4 border-t border-slate-100 space-y-2.5 text-xs text-gray-600">

                <div class="flex items-center justify-between">
                    <span class="text-gray-400">Privacy</span>
                    <span class="font-bold text-gray-700">
                        @(Model.Group.IsPrivate ? "🔒 Private" : "🌐 Public")
                    </span>
                </div>

                <div class="flex items-center justify-between">
                    <span class="text-gray-400">Members</span>
                    <span class="font-bold text-[#345e69]">
                        @Model.Group.MembersCount members
                    </span>
                </div>

                <div class="flex items-center justify-between">
                    <span class="text-gray-400">Created</span>
                    <span class="font-bold text-gray-700">
                        @Model.Group.CreatedAt.ToString("MMM dd, yyyy")
                    </span>
                </div>
            </div>
        </div>

        <!-- Group Rules Card -->
        @if (!string.IsNullOrWhiteSpace(Model.Group.Rules))
        {
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <h3 class="font-black text-gray-900 mb-3 text-base">
                    📜 Community Rules
                </h3>

                <p class="text-gray-600 text-xs leading-relaxed whitespace-pre-line">
                    @Model.Group.Rules
                </p>
            </div>
        }
    </div>
</div>
</div>

<!-- Render Group-Specific Modals --> 
        <partial name="Partials/_CreatePost" model="Model.Group" />
<partial name="_JoinRequestModal" model="Model.Group" />

<!-- Group Delete Reason Modal -->
<div id="groupDeleteReasonModal" class="fixed inset-0 z-[1000] hidden">

    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"
            onclick="closeGroupDeleteReasonModal()"></div>

    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden">

            <div class="flex items-center gap-3 p-4 border-b border-slate-100">
                <div class="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center">
                    <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </div>

                <h3 class="text-lg font-bold text-gray-900">
                    Delete Group
                </h3>
            </div>

            <div class="p-6">
                <label class="block text-sm font-semibold text-slate-700 mb-2">
                    Reason for deletion <span class="text-red-500">*</span>
                </label>

                <textarea id="groupDeleteReasonInput"
                            rows="3"
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500/20 focus:border-red-500 resize-none text-sm"
                            placeholder="Explain why this group is being deleted..."></textarea>

                <p id="groupDeleteReasonError"
                    class="hidden text-xs text-red-600 font-medium mt-2">
                    A deletion reason is required.
                </p>
            </div>

            <div class="flex gap-3 p-4 border-t border-slate-100 bg-slate-50/50">

                <button type="button"
                        onclick="closeGroupDeleteReasonModal()"
                        class="flex-1 py-2.5 border border-gray-200 text-gray-600 font-semibold rounded-xl hover:bg-gray-100 transition-colors">
                    Cancel
                </button>

                <button type="button"
                        onclick="confirmGroupDeleteReason()"
                        class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl transition-colors shadow-lg shadow-red-600/30">
                    Delete Group
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadGroupPosts('@Model.Group.Id');
            updateActiveTab('posts');
        });

        function openGroupCreatePostModal(groupId, groupName) {
            if (window.SohbaApp &&
                typeof SohbaApp.openCreatePostModal === 'function') {

                SohbaApp.openCreatePostModal({
                    groupId: groupId,
                    sourceType: 'Group',
                    sourceName: groupName
                });
            }
            else {
                console.error('Create Post Modal is not initialized.');
            }
        }

        function updateActiveTab(tabName) {
            const buttons = document.querySelectorAll(
                '#groupTabsBar button[data-group-tab]'
            );

            buttons.forEach(btn => {
                const target = btn.getAttribute('data-group-tab');

                if (target === tabName) {
                    btn.classList.remove(
                        'border-transparent',
                        'text-gray-400'
                    );

                    btn.classList.add(
                        'border-[#345e69]',
                        'text-[#345e69]'
                    );
                }
                else {
                    btn.classList.remove(
                        'border-[#345e69]',
                        'text-[#345e69]'
                    );

                    btn.classList.add(
                        'border-transparent',
                        'text-gray-400'
                    );
                }
            });
        }

        async function loadGroupPosts(groupId) {
            const container =
                document.getElementById('group-content-area');

            if (!container) return;

            try {
                const response =
                    await fetch(`/Groups/GetGroupPosts?groupId=${groupId}`);

                if (!response.ok) {
                    throw new Error('Failed to load group posts');
                }

                const html = await response.text();
                container.innerHTML = html;
            }
            catch (error) {
                console.error(error);

                container.innerHTML =
                    '<div class="bg-white rounded-2xl p-10 text-center text-red-500 border border-slate-100">' +
                    'Failed to load posts. Please refresh the page.' +
                    '</div>';
            }
        }

        function Group_SwitchTab(tabName) {
            updateActiveTab(tabName);

            const container =
                document.getElementById('group-content-area');

            if (!container) return;

            container.innerHTML =
                '<div class="bg-white rounded-2xl p-12 text-center text-gray-400 border border-slate-100">' +
                '<div class="w-8 h-8 border-2 border-[#345e69] border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>' +
                '<p class="text-sm">Loading...</p>' +
                '</div>';

            if (tabName === 'members') {
                loadMembersPaged('@Model.Group.Id', '', 1);
            }
            else if (tabName === 'about') {
                loadAboutTab('@Model.Group.Id');
            }
            else if (tabName === 'requests') {
                loadJoinRequestsTab('@Model.Group.Id', 1);
            }
            else {
                loadGroupPosts('@Model.Group.Id');
            }
        }

        async function loadMembersPaged(
            groupId,
            search = '',
            page = 1
        ) {
            const container =
                document.getElementById('group-content-area');

            try {
                const response =
                    await fetch(
                        `/Groups/GetMembersPaged?groupId=${groupId}` +
                        `&search=${encodeURIComponent(search)}` +
                        `&page=${page}`
                    );

                if (!response.ok) {
                    throw new Error('Failed to load members tab');
                }

                const html = await response.text();
                container.innerHTML = html;
            }
            catch (error) {
                console.error(error);

                container.innerHTML =
                    '<div class="bg-white rounded-2xl p-10 text-center text-red-500 border border-slate-100">' +
                    'Failed to load members.' +
                    '</div>';
            }
        }

        function executeMemberSearch(groupId) {
            const input = document.getElementById('memberSearchInput');
            const search = input ? input.value.trim() : '';
            loadMembersPaged(groupId, search, 1);
        }

        function clearMemberSearch(groupId) {
            const input = document.getElementById('memberSearchInput');
            if (input) input.value = '';
            loadMembersPaged(groupId, '', 1);
        }

        async function loadAboutTab(groupId) {
            const container =
                document.getElementById('group-content-area');

            try {
                const response =
                    await fetch(`/Groups/GetAboutTab?groupId=${groupId}`);

                if (!response.ok) {
                    throw new Error('Failed to load about tab');
                }

                const html = await response.text();
                container.innerHTML = html;
            }
            catch (error) {
                console.error(error);

                container.innerHTML =
                    '<div class="bg-white rounded-2xl p-10 text-center text-red-500 border border-slate-100">' +
                    'Failed to load about information.' +
                    '</div>';
            }
        }

        async function loadJoinRequestsTab(
            groupId,
            page = 1
        ) {
            const container =
                document.getElementById('group-content-area');

            try {
                const response =
                    await fetch(
                        `/Groups/GetJoinRequests?groupId=${groupId}&page=${page}`
                    );

                if (!response.ok) {
                    throw new Error('Failed to load join requests tab');
                }

                const html = await response.text();
                container.innerHTML = html;
            }
            catch (error) {
                console.error(error);

                container.innerHTML =
                    '<div class="bg-white rounded-2xl p-10 text-center text-red-500 border border-slate-100">' +
                    'Failed to load join requests.' +
                    '</div>';
            }
        }

        async function joinGroup(groupId, button) {
            try {
                const result =
                    await SohbaApp.post('/Groups/Join', {
                        id: groupId
                    });

                if (result.success) {
                    SohbaApp.toast(
                        'Joined group successfully!',
                        'success'
                    );

                    setTimeout(
                        () => window.location.reload(),
                        500
                    );
                }
                else {
                    SohbaApp.toast(
                        result.error || 'Failed to join group',
                        'error'
                    );
                }
            }
            catch (error) {
                console.error(error);
                SohbaApp.toast(
                    'Network error',
                    'error'
                );
            }
        }

        async function leaveGroup(groupId) {
            showConfirmModal({
                title: 'Leave Group',
                message:
                    'Are you sure you want to leave this group? You will no longer see updates from this community.',
                type: 'warning',
                confirmText: 'Leave Group',

                onConfirm: async function () {
                    try {
                        const result =
                            await SohbaApp.post(
                                '/Groups/Leave',
                                { groupId }
                            );

                        if (result.success) {
                            SohbaApp.toast(
                                'Left group successfully',
                                'success'
                            );

                            setTimeout(
                                () => window.location.href = '/Groups',
                                600
                            );
                        }
                        else {
                            SohbaApp.toast(
                                result.error || 'Failed to leave group',
                                'error'
                            );
                        }
                    }
                    catch (error) {
                        console.error(error);

                        SohbaApp.toast(
                            'Network error',
                            'error'
                        );
                    }
                }
            });
        }

        window.openGroupDeleteReasonModal = function () {
            document.getElementById(
                'groupDeleteReasonInput'
            ).value = '';

            document.getElementById(
                'groupDeleteReasonError'
            ).classList.add('hidden');

            document.getElementById(
                'groupDeleteReasonModal'
            ).classList.remove('hidden');

            document.body.style.overflow = 'hidden';
        };

        window.closeGroupDeleteReasonModal = function () {
            document.getElementById(
                'groupDeleteReasonModal'
            ).classList.add('hidden');

            document.body.style.overflow = '';
        };

        window.confirmGroupDeleteReason = function () {
            const reason =
                document.getElementById(
                    'groupDeleteReasonInput'
                ).value.trim();

            if (!reason) {
                document.getElementById(
                    'groupDeleteReasonError'
                ).classList.remove('hidden');

                return;
            }

            closeGroupDeleteReasonModal();

            showConfirmModal({
                title: 'Delete Group',
                message:
                    'Are you sure you want to permanently delete this group? All group posts and membership data will be removed.',
                type: 'delete',
                confirmText: 'Delete Group',

                onConfirm: async function () {
                    const result =
                        await SohbaApp.post(
                            '/Groups/Delete',
                            {
                                groupId: '@Model.Group.Id',
                                reason: reason
                            }
                        );

                    if (result.success) {
                        SohbaApp.toast(
                            'Group deleted successfully',
                            'success'
                        );

                        setTimeout(
                            () => window.location.href = '/Groups',
                            600
                        );
                    }
                    else {
                        SohbaApp.toast(
                            result.error || 'Failed to delete group',
                            'error'
                        );
                    }
                }
            });
        };
    </script>
}
