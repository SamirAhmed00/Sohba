<section class="stack-section has-deco" id="stack">
    @Deco("3d-camera.webp", "camera", "left:-1%;top:10%;--d:120px", "0.5", "-10")
    @Deco("3d-bookmark.webp", "bookmark", "right:-1%;bottom:8%;--d:110px", "0.6", "12")
    <div class="container">
        <div class="section-head center" data-anim="fade-up">
            <span class="eyebrow">Why Sohba</span>
            <h2>A social platform that puts people first.</h2>
            <p>No engagement games, no noise — just thoughtful features that respect your time, your privacy, and your community.</p>
        </div>
        <div class="stack-grid">
            @foreach (var tech in techs)
            {
                <div class="stack-chip" data-anim="reveal">
                    <div class="stack-icon">@Html.Raw(tech.Svg)</div>
                    <span class="name">@tech.Name</span><span class="role">@tech.Role</span>
                </div>
            }
        </div>
    </div>
</section>
