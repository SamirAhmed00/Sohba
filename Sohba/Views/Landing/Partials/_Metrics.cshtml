@{
    // 3D-icon / image slot. If the image is missing the CSS fallback tile (lucide icon) stays visible,
    // so the sides are never empty. Positioning comes from the inline style.
    Microsoft.AspNetCore.Html.IHtmlContent Deco(string file, string icon, string style, string depth = "0.3", string rot = "0", bool dark = false)
    {
        var src = Url.Content("~/images/landing/" + file);
        return Html.Raw($"<span class=\"deco{(dark ? " deco-dark" : "")}\" style=\"{style}\" data-depth=\"{depth}\" data-rot=\"{rot}\" aria-hidden=\"true\"><span class=\"deco-in\"><span class=\"deco-fb\"><i data-lucide=\"{icon}\"></i></span><img src=\"{src}\" alt=\"\" loading=\"lazy\" decoding=\"async\" onload=\"this.parentNode.classList.add('has-img')\" onerror=\"this.remove()\" /></span></span>");
    }
}

@* File: Sohba/Views/Landing/Partials/_Metrics.cshtml — animated product counters *@
@{
    var stats = new[]
    {
        new { Value = 6,  Suffix = "",  Label = "Ways to react" },
        new { Value = 24, Suffix = "h", Label = "Stories stay live" },
        new { Value = 4,  Suffix = "",  Label = "Reply levels per thread" },
        new { Value = 3,  Suffix = "",  Label = "Sources in one feed" },
        new { Value = 5,  Suffix = "",  Label = "Things you can search" },
        new { Value = 4,  Suffix = "",  Label = "Roles in every group" },
        new { Value = 7,  Suffix = "",  Label = "Real-time notification types" },
        new { Value = 1,  Suffix = "",  Label = "Home for your social life" }
    };
}

<section class="metrics-section" id="metrics">
    <div class="container">
        <div class="metrics-card has-deco">
            @Deco("3d-sparkle.webp", "sparkles", "left:-12px;top:-30px;--d:110px", "0.3", "-10", dark: true)
            @Deco("3d-heart.webp", "heart", "right:-10px;bottom:-26px;--d:120px", "0.4", "12", dark: true)
        <div class="metrics-grid">
            @foreach (var stat in stats)
            {
                <div class="metric-block" data-anim="fade-up">
                    <div class="metric-number counter" data-value="@stat.Value" data-suffix="@stat.Suffix">0</div>
                    <div class="metric-label">@stat.Label</div>
                </div>
            }
        </div>
        </div>
    </div>
</section>
