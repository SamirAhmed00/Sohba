@* File: Sohba/Views/Landing/Index.cshtml *@
@using Sohba.ViewModels.Landing
@model LandingIndexViewModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Sohba — Where Real Connections Live";
    ViewData["Description"] = "A privacy-first social platform: real-time notifications, 24h stories, threaded conversations, groups & pages — a social network that puts people first.";
}

<div class="landing-wrapper">

    <!-- Scroll progress bar -->
    <div class="scroll-progress" aria-hidden="true"></div>

    <!-- ================= 1. HEADER ================= -->
    <partial name="Partials/_Header" model="Model" />

    <!-- ================= 2. HERO ================= -->
    <partial name="Partials/_Hero" model="Model" />

    <!-- ================= 3. MARQUEE ================= -->
    <partial name="Partials/_Marquee" />

    <!-- ================= 4. BENTO SHOWCASE ================= -->
    <partial name="Partials/_Showcase" />

    <!-- ================= 5. COMMUNITY ================= -->
    <partial name="Partials/_Community" />

    <!-- ================= 6-8. DEEP DIVES (realtime / security / admin) ================= -->
    <partial name="Partials/_DeepDive" />

    <!-- ================= 9. WHY SOHBA ================= -->
    <partial name="Partials/_Stack" />

    <!-- ================= 10. METRICS ================= -->
    <partial name="Partials/_Metrics" />

    <!-- ================= 11. BENEFITS ================= -->
    <partial name="Partials/_Topics" />

    <!-- ================= 12. GET STARTED ================= -->
    <partial name="Partials/_ShipReady" />

    <!-- ================= 13. CREDITS ================= -->
    <partial name="Partials/_Credits" />

    <!-- ================= 14. FOOTER ================= -->
    <partial name="Partials/_Footer" />

</div>

@section Scripts {
    <script src="~/js/features/landing.js" asp-append-version="true" defer></script>
}
