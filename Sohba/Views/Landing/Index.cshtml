@{
    ViewData["Title"] = "Sohba - Connect with the world";
}

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    primary: {
                        DEFAULT: '#3d8b8b', [cite: 1, 2]
                        50: '#f0f9f9', [cite: 1, 2]
                        100: '#d9f0f0', [cite: 1, 2]
                        200: '#b3e0e0', [cite: 1, 2]
                        300: '#80c9c9', [cite: 1, 2]
                        400: '#5aadad', [cite: 1, 2]
                        500: '#3d8b8b', [cite: 1, 2]
                        600: '#317070', [cite: 1, 2]
                        700: '#295959', [cite: 1, 2]
                        800: '#234848', [cite: 1, 2]
                        900: '#1d3c3c', [cite: 1, 2]
                    },
                    background: '#f7fafa', [cite: 1, 2]
                    foreground: '#1a2e35', [cite: 1, 2]
                    card: '#ffffff', [cite: 1, 2]
                    muted: '#f1f5f5', [cite: 1, 2]
                    'muted-foreground': '#64748b', [cite: 1, 2]
                    border: '#e2eaea', [cite: 1, 2]
                },
            },
        },
    }
</script>

<!-- Three.js & GSAP -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<style>
    :root {
    --brand-color: #345e69;
    --brand-light: #4a8291;
    --brand-dark: #2a4a52;
    --accent-color: #4a8291;
    --soft-bg: #f8fafc;
    --surface: #ffffff;
    --text-primary: #1e293b;
    --text-secondary: #64748b;
    }

    * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    }

    html {
    scroll-behavior: smooth;
    }

    body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background-color: var(--soft-bg);
    color: var(--text-primary);
    line-height: 1.6;
    overflow-x: hidden;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
    width: 6px;
    }

    ::-webkit-scrollbar-track {
    background: transparent;
    }

    ::-webkit-scrollbar-thumb {
    background: var(--brand-color);
    border-radius: 3px;
    }

    /* Language Toggle Button */
    .lang-toggle {
    /* position: fixed; --> Removed */
    /* top: 24px; --> Removed */
    /* left: 24px; --> Removed */
    /* z-index: 100; --> Removed */
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(52, 94, 105, 0.1);
    padding: 8px 16px;
    /* Optimized padding */
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    /* Add these properties: */
    display: inline-block;
    color: var(--text-primary);
    text-decoration: none;
    }

    .lang-toggle:hover {
    background: var(--brand-color);
    color: white;
    transform: translateY(-2px);
    }

    /* Glass Header - Always LTR */
    .glass-header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(52, 94, 105, 0.08);
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 50;
    height: 72px;
    }

    .glass-header .nav-container {
    direction: ltr !important;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    }

    /* Logo Styles - Exact Match */
    .logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    cursor: pointer;
    }

    .logo-icon {
    width: 40px;
    height: 40px;
    background: var(--brand-color);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 900;
    font-size: 20px;
    box-shadow: 0 10px 15px -3px rgba(52, 94, 105, 0.3);
    transition: all 0.3s ease-in-out;
    }

    .logo-link:hover .logo-icon {
    transform: rotate(12deg) scale(1.1);
    }

    .logo-text {
    margin-left: 12px;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.025em;
    background: linear-gradient(to right, var(--brand-color) 0%, var(--brand-color) 20%, var(--brand-light) 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: all 0.3s ease;
    display: none;
    }

    @@media (min-width: 768px) {
    .logo-text {
    display: block;
    }
    }

    .logo-link:hover .logo-text {
    background-position: right center;
    }

    /* Auth Buttons */
    .auth-links {
    display: flex;
    align-items: center;
    gap: 16px;
    }

    .auth-link-login {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition: color 0.2s;
    }

    .auth-link-login:hover {
    color: var(--brand-color);
    }

    .auth-link-register {
    background: var(--brand-color);
    color: white;
    padding: 10px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(52, 94, 105, 0.2);
    }

    .auth-link-register:hover {
    background: var(--brand-light);
    transform: translateY(-1px);
    box-shadow: 0 10px 15px -3px rgba(52, 94, 105, 0.3);
    }

    /* Hero Section */
    .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 72px;
    position: relative;
    background: radial-gradient(circle at top right, rgba(52, 94, 105, 0.05), transparent), radial-gradient(circle at bottom left, rgba(74, 130, 145, 0.05), transparent), linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    overflow: hidden;
    }

    #canvas-container {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    pointer-events: none;
    }

    .hero-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 10;
    }

    .hero-text h1 {
    font-size: 56px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 24px;
    letter-spacing: -1.5px;
    }

    .hero-text .highlight {
    background: linear-gradient(to right, var(--brand-color), var(--brand-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    }

    .hero-text p {
    font-size: 18px;
    color: var(--text-secondary);
    margin-bottom: 32px;
    max-width: 480px;
    line-height: 1.7;
    }

    .hero-cta {
    display: flex;
    gap: 16px;
    }

    .btn-large {
    padding: 16px 32px;
    font-size: 16px;
    border-radius: 12px;
    }

    .btn-secondary {
    background: white;
    color: var(--text-primary);
    border: 1px solid rgba(52, 94, 105, 0.15);
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    transition: all 0.3s ease;
    }

    .btn-secondary:hover {
    background: var(--soft-bg);
    border-color: var(--brand-color);
    color: var(--brand-color);
    }

    .btn-primary {
    background: var(--brand-color);
    color: white;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    display: inline-block;
    }

    .btn-primary:hover {
    background: var(--brand-light);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -5px rgba(52, 94, 105, 0.3);
    }

    /* Hero Visual */
    .hero-visual {
    position: relative;
    perspective: 1000px;
    }

    .phone-mockup {
    background: white;
    border-radius: 24px;
    padding: 16px;
    box-shadow: 0 25px 50px -12px rgba(52, 94, 105, 0.2), 0 0 0 1px rgba(52, 94, 105, 0.05);
    transform: rotateY(-8deg) rotateX(4deg);
    transition: transform 0.6s ease;
    }

    .phone-mockup:hover {
    transform: rotateY(-4deg) rotateX(2deg);
    }

    .phone-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 16px;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 16px;
    }

    .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    }

    .dot-red {
    background: #ef4444;
    }

    .dot-yellow {
    background: #f59e0b;
    }

    .dot-green {
    background: #10b981;
    }

    .post-skeleton {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
    }

    .avatar {
    width: 40px;
    height: 40px;
    background: #e2e8f0;
    border-radius: 50%;
    flex-shrink: 0;
    }

    .post-lines {
    flex: 1;
    }

    .line {
    height: 8px;
    background: #f1f5f9;
    border-radius: 4px;
    margin-bottom: 8px;
    }

    .line-short {
    width: 40%;
    }

    .image-placeholder {
    height: 160px;
    background: linear-gradient(135deg, #e2e8f0 0%, #f1f5f9 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    }

    /* Features Section */
    .features {
    padding: 120px 24px;
    background: white;
    }

    .container {
    max-width: 1200px;
    margin: 0 auto;
    }

    .section-header {
    text-align: center;
    margin-bottom: 64px;
    }

    .section-header h2 {
    font-size: 40px;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 16px;
    }

    .section-header p {
    color: var(--text-secondary);
    font-size: 18px;
    }

    .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    }

    .feature-card {
    padding: 32px;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
    background: white;
    }

    .feature-card:hover {
    border-color: var(--brand-color);
    box-shadow: 0 10px 40px -10px rgba(52, 94, 105, 0.15);
    transform: translateY(-4px);
    }

    .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    font-size: 24px;
    }

    .feature-card h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-primary);
    }

    .feature-card p {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.6;
    }

    /* Control Section */
    .control-section {
    padding: 120px 24px;
    background: #f8fafc;
    }

    .control-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    }

    .control-content h2 {
    font-size: 40px;
    font-weight: 800;
    margin-bottom: 40px;
    line-height: 1.2;
    }

    .control-item {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    }

    .control-number {
    width: 32px;
    height: 32px;
    background: var(--brand-color);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
    }

    .control-item h4 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 6px;
    }

    .control-item p {
    color: var(--text-secondary);
    font-size: 15px;
    }

    .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    }

    .stat-card {
    background: white;
    padding: 24px;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    }

    .stat-card:nth-child(2) {
    margin-top: 32px;
    }

    .stat-icon {
    font-size: 32px;
    margin-bottom: 12px;
    }

    .stat-card h4 {
    font-size: 16px;
    font-weight: 700;
    color: var(--brand-color);
    margin-bottom: 4px;
    }

    .stat-card p {
    font-size: 13px;
    color: var(--text-secondary);
    }

    /* Detailed Features */
    .detailed-features {
    padding: 120px 24px;
    background: white;
    }

    .features-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    }

    .story-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px;
    max-height: 400px;
    overflow-y: auto;
    }

    .story-card::-webkit-scrollbar {
    width: 4px;
    }

    .story-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid #f1f5f9;
    position: sticky;
    top: 0;
    background: white;
    }

    .story-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    }

    .story-card h3 {
    font-size: 16px;
    font-weight: 700;
    }

    .story-item {
    margin-bottom: 16px;
    }

    .story-item-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    }

    .story-dot {
    width: 6px;
    height: 6px;
    background: var(--brand-color);
    border-radius: 50%;
    }

    .story-dot.admin {
    background: #ef4444;
    }

    .story-code {
    font-family: 'Monaco', 'Consolas', monospace;
    font-size: 11px;
    color: var(--brand-color);
    font-weight: 600;
    }

    .story-desc {
    font-size: 12px;
    color: var(--text-secondary);
    padding-right: 14px;
    }

    /* About Section */
    .about {
    padding: 120px 24px;
    background: #f8fafc;
    text-align: center;
    }

    .about-avatar {
    width: 120px;
    height: 120px;
    background: white;
    border: 3px solid var(--brand-color);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 32px;
    font-size: 48px;
    font-weight: 800;
    color: var(--brand-color);
    transform: rotate(-6deg);
    box-shadow: 0 20px 40px -10px rgba(52, 94, 105, 0.15);
    }

    .about h2 {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 16px;
    }

    .about p {
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto 32px;
    font-size: 16px;
    line-height: 1.7;
    }

    .github-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--brand-color);
    color: white;
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    }

    .github-link:hover {
    background: var(--brand-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(52, 94, 105, 0.25);
    }

    /* Stats Bar */
    .stats-bar {
    background: var(--brand-color);
    color: white;
    padding: 60px 24px;
    }

    .stats-bar-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    text-align: center;
    }

    .stats-bar-item .number {
    font-size: 48px;
    font-weight: 800;
    margin-bottom: 8px;
    }

    .stats-bar-item .label {
    font-size: 13px;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 1px;
    }

    /* Footer */
    footer {
    background: white;
    padding: 40px 24px;
    border-top: 1px solid #e2e8f0;
    }

    .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    }

    .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    }

    .footer-logo-icon {
    width: 32px;
    height: 32px;
    background: var(--brand-color);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    }

    .footer-logo-text {
    font-weight: 700;
    color: var(--text-primary);
    }

    .copyright {
    color: var(--text-secondary);
    font-size: 14px;
    }

    /* RTL Specific Styles */
    [dir="rtl"] .hero-text h1,
    [dir="rtl"] .hero-text p {
    text-align: right;
    }

    [dir="rtl"] .hero-cta {
    justify-content: flex-start;
    }

    [dir="rtl"] .control-content {
    text-align: right;
    }

    [dir="rtl"] .control-item {
    flex-direction: row-reverse;
    }

    [dir="rtl"] .story-desc {
    padding-right: 0;
    padding-left: 14px;
    }

    [dir="rtl"] .logo-text {
    margin-left: 0;
    margin-right: 12px;
    }

    /* Responsive */
    @@media (max-width: 1024px) {

    .hero-content,
    .control-grid {
    grid-template-columns: 1fr;
    gap: 40px;
    }

    .hero-visual {
    display: none;
    }

    .features-grid {
    grid-template-columns: 1fr;
    }

    .features-cards-grid {
    grid-template-columns: 1fr 1fr;
    }

    .stats-bar-grid {
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    }

    .hero-text h1 {
    font-size: 40px;
    }
    }

    @@media (max-width: 640px) {
    .features-cards-grid {
    grid-template-columns: 1fr;
    }

    .stats-bar-grid {
    grid-template-columns: 1fr 1fr;
    }

    .auth-links {
    gap: 12px;
    }

    .auth-link-login {
    font-size: 13px;
    }

    .auth-link-register {
    padding: 8px 16px;
    font-size: 13px;
    }

    .lang-toggle {
    top: 80px;
    left: 16px;
    }

    .hero-text h1 {
    font-size: 32px;
    }

    .hero-cta {
    flex-direction: column;
    }

    .btn-large,
    .btn-secondary {
    width: 100%;
    text-align: center;
    }

    .footer-content {
    flex-direction: column;
    gap: 16px;
    text-align: center;
    }

    /* User Welcome Style */
    .auth-links span {
    padding: 8px 16px;
    background: rgba(52, 94, 105, 0.1);
    border-radius: 20px;
    color: var(--brand-color);
    font-weight: 600;
    font-size: 14px;
    }
    }

    .bg-gradient-hero {
    background: linear-gradient(135deg, rgba(61, 139, 139, 0.08) 0%, rgba(61, 139, 139, 0.02) 50%, transparent 100%);
    }

    .animate-float {
    animation: float 3s ease-in-out infinite;
    }

    .animate-float-delayed {
    animation: float 3s ease-in-out infinite 1s;
    }

    @@keyframes float {

    0%,
    100% {
    transform: translateY(0);
    }

    50% {
    transform: translateY(-10px);
    }
    }

    /* تنسيق حاوية الـ Canvas بتاعة الـ 3D Particles القديمة */
    #bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.4;
    }

    /* التأكد من أن محتوى الصفحة يظهر فوق الـ Canvas */
    .content-wrapper {
    position: relative;
    z-index: 10;
    }
</style>


<!-- Header - Always LTR with New Logo -->
<nav class="glass-header">
    <div class="nav-container">
        <!-- Logo -->
        <a asp-controller="Landing" asp-action="Index" class="flex-shrink-0 flex items-center group cursor-pointer">
            <div
                class="bg-[#345e69] w-10 h-10 flex items-center justify-center rounded-xl shadow-lg group-hover:rotate-12 group-hover:scale-110 transition-all duration-300 ease-in-out">
                <span class="text-white text-2xl font-black">S</span>
            </div>
            <span
                class="ml-3 text-2xl font-black tracking-tighter bg-gradient-to-r from-[#345e69] via-[#345e69] via-[20%] to-[#4a8291] bg-[length:200%_auto] hover:bg-right transition-all duration-300 bg-clip-text text-transparent hidden md:block">
                SOHBA
            </span>
        </a>

        <!-- Auth Buttons / User Info -->
        <div class="auth-links">
            @if (ViewBag.IsAuthenticated == true)
            {
                <!-- If User Are Login Show Him -->
                <span class="text-gray-600 font-bold text-sm" data-en="Welcome, @ViewBag.UserName"
                        data-ar="مرحباً، @ViewBag.UserName">
                    Welcome, @ViewBag.UserName
                </span>
                <a asp-controller="Home" asp-action="Index" class="auth-link-register" data-en="Go to Feed"
                    data-ar="الصفحة الرئيسية">
                    Go to Feed
                </a>
            }
            else
            {
                <!-- If User Not In System -- Login/Register -->
