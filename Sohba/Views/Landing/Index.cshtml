@{
    ViewData["Title"] = "Sohba - Connect with the world";
}

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    primary: {
                        DEFAULT: '#3d8b8b', [cite: 1, 2]
                        50: '#f0f9f9', [cite: 1, 2]
                        100: '#d9f0f0', [cite: 1, 2]
                        200: '#b3e0e0', [cite: 1, 2]
                        300: '#80c9c9', [cite: 1, 2]
                        400: '#5aadad', [cite: 1, 2]
                        500: '#3d8b8b', [cite: 1, 2]
                        600: '#317070', [cite: 1, 2]
                        700: '#295959', [cite: 1, 2]
                        800: '#234848', [cite: 1, 2]
                        900: '#1d3c3c', [cite: 1, 2]
                    },
                    background: '#f7fafa', [cite: 1, 2]
                    foreground: '#1a2e35', [cite: 1, 2]
                    card: '#ffffff', [cite: 1, 2]
                    muted: '#f1f5f5', [cite: 1, 2]
                    'muted-foreground': '#64748b', [cite: 1, 2]
                    border: '#e2eaea', [cite: 1, 2]
                },
            },
        },
    }
</script>

<!-- Three.js & GSAP -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}
<!-- Header - Always LTR with New Logo -->
<nav class="glass-header">
    <div class="nav-container">
        <!-- Logo -->
        <a asp-controller="Landing" asp-action="Index" class="flex-shrink-0 flex items-center group cursor-pointer">
            <div
                class="bg-[#345e69] w-10 h-10 flex items-center justify-center rounded-xl shadow-lg group-hover:rotate-12 group-hover:scale-110 transition-all duration-300 ease-in-out">
                <span class="text-white text-2xl font-black">S</span>
            </div>
            <span
                class="ml-3 text-2xl font-black tracking-tighter bg-gradient-to-r from-[#345e69] via-[#345e69] via-[20%] to-[#4a8291] bg-[length:200%_auto] hover:bg-right transition-all duration-300 bg-clip-text text-transparent hidden md:block">
                SOHBA
            </span>
        </a>

        <!-- Auth Buttons / User Info -->
        <div class="auth-links">
            @if (ViewBag.IsAuthenticated == true)
            {
                <!-- If User Are Login Show Him -->
                <span class="text-gray-600 font-bold text-sm" data-en="Welcome, @ViewBag.UserName"
                        data-ar="مرحباً، @ViewBag.UserName">
                    Welcome, @ViewBag.UserName
                </span>
                <a asp-controller="Home" asp-action="Index" class="auth-link-register" data-en="Go to Feed"
                    data-ar="الصفحة الرئيسية">
                    Go to Feed
                </a>
            }
            else
            {
                <!-- If User Not In System -- Login/Register -->
                <a asp-controller="Auth" asp-action="Login" class="auth-link-login" data-en="Login"
                    data-ar="تسجيل الدخول">Login</a>
                <a asp-controller="Auth" asp-action="Register" class="auth-link-register" data-en="Register"
                    data-ar="إنشاء حساب">Register</a>
            }
            <!-- Language Toggle -->
            <button class="lang-toggle" onclick="toggleLanguage()" id="langBtn">
                العربية
            </button>
        </div>
    </div>
</nav>

<!-- Hero Section - Updated -->
<section class="relative overflow-hidden">
    @* Background gradient *@
    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-background to-accent/30"></div>

    @* Decorative elements *@
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent/20 rounded-full blur-3xl"></div>

    <div class="container relative px-4 md:px-6 py-20 md:py-32">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            @* Content *@
            <div class="flex flex-col gap-6 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary w-fit mx-auto lg:mx-0">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                    </span>
                    New Features Available
                </div>

                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-foreground text-balance">
                    Connect, Share
                    <br />
                    <span class="text-primary">Build Your Community</span>
                </h1>

                <p class="text-lg text-muted-foreground leading-relaxed max-w-lg mx-auto lg:mx-0 text-pretty">
                    SOHBA is your gateway to a unique social experience, where technology meets real human connections in a safe and organized environment.
                </p>

                <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start pt-2">
                    <a asp-controller="Home" asp-action="Register" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg shadow-lg shadow-primary/25 hover:shadow-primary/40 transition-all font-medium">
                        Get Started Free
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                    <a href="#" class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-border bg-background rounded-lg hover:bg-muted transition-all font-medium">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path></svg>
                        Watch Demo
                    </a>
                </div>

                @* Social Proof *@
                <div class="flex items-center gap-4 pt-6 justify-center lg:justify-start">
                    <div class="flex -space-x-3">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary/60 to-primary border-2 border-background flex items-center justify-center text-xs font-medium text-primary-foreground">
