<section class="relative overflow-hidden">
    @* Background gradient *@
    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-background to-accent/30"></div>

    @* Decorative elements *@
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent/20 rounded-full blur-3xl"></div>

    <div class="container relative px-4 md:px-6 py-20 md:py-32">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            @* Content *@
            <div class="flex flex-col gap-6 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary w-fit mx-auto lg:mx-0">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                    </span>
                    New Features Available
                </div>

                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-foreground text-balance">
                    Connect, Share
                    <br />
                    <span class="text-primary">Build Your Community</span>
                </h1>

                <p class="text-lg text-muted-foreground leading-relaxed max-w-lg mx-auto lg:mx-0 text-pretty">
                    SOHBA is your gateway to a unique social experience, where technology meets real human connections in a safe and organized environment.
                </p>

                <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start pt-2">
                    <a asp-controller="Home" asp-action="Register" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg shadow-lg shadow-primary/25 hover:shadow-primary/40 transition-all font-medium">
                        Get Started Free
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                    <a href="#" class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-border bg-background rounded-lg hover:bg-muted transition-all font-medium">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path></svg>
                        Watch Demo
                    </a>
                </div>

                @* Social Proof *@
                <div class="flex items-center gap-4 pt-6 justify-center lg:justify-start">
                    <div class="flex -space-x-3">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary/60 to-primary border-2 border-background flex items-center justify-center text-xs font-medium text-primary-foreground">
                                @((char)(64 + i))
                            </div>
                        }
                    </div>
                    <div class="text-sm text-muted-foreground">
                        <span class="font-semibold text-foreground">1,200+</span> users joined this month
                    </div>
                </div>
            </div>

            @* Hero Image/Mockup *@
            <div class="relative lg:pl-8">
                <div class="relative bg-card rounded-2xl shadow-2xl border border-border overflow-hidden">
                    @* Browser Chrome *@
                    <div class="flex items-center gap-2 px-4 py-3 bg-muted/50 border-b border-border">
                        <div class="flex gap-1.5">
                            <div class="w-3 h-3 rounded-full bg-red-400"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                            <div class="w-3 h-3 rounded-full bg-green-400"></div>
                        </div>
                        <div class="flex-1 mx-4">
                            <div class="bg-background rounded-md px-3 py-1 text-xs text-muted-foreground">
                                sohba.app/feed
                            </div>
                        </div>
                    </div>

                    @* Mock Feed Content *@
                    <div class="p-4 space-y-4 bg-gradient-to-b from-background to-muted/20 min-h-[300px]">
                        @* Post Card *@
                        <div class="bg-card rounded-xl p-4 shadow-sm border border-border">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary font-semibold">
                                    SA
                                </div>
                                <div>
                                    <p class="font-medium text-sm text-foreground">Samir Ahmed</p>
                                    <p class="text-xs text-muted-foreground">Just now</p>
                                </div>
                            </div>
                            <p class="text-sm text-foreground mb-3">Welcome to SOHBA! Excited to connect with everyone here.</p>
                            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <span class="text-red-500">❤</span> 24 reactions
                                </span>
                                <span>8 comments</span>
                            </div>
                        </div>

                        @* Story Bar *@
                        <div class="flex gap-3">
                            @{
                                string[] labels = { "Add Story", "User 1", "User 2" };
                            }
                            @for (int i = 0; i < labels.Length; i++)
                            {
                                <div class="flex flex-col items-center gap-1">
                                    <div class="w-14 h-14 rounded-xl @(i == 0 ? "bg-primary/10 border-2 border-dashed border-primary/30" : "bg-gradient-to-br from-primary to-primary/60") flex items-center justify-center">
                                        @if (i == 0)
                                        {
                                            <span class="text-primary text-xl">+</span>
                                        }
                                        else
                                        {
                                            <span class="text-primary-foreground text-xs font-medium">@labels[i][0]</span>
                                        }
                                    </div>
                                    <span class="text-[10px] text-muted-foreground">@labels[i]</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Floating Elements *@
                <div class="absolute -right-4 top-1/4 bg-card rounded-lg shadow-lg border border-border p-3 animate-pulse">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
                            <span class="text-green-600 text-sm">✓</span>
                        </div>
                        <span class="text-xs font-medium text-foreground">New Friend Request</span>
                    </div>
                </div>

                <div class="absolute -left-4 bottom-1/4 bg-card rounded-lg shadow-lg border border-border p-3">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center">
                            <span class="text-primary text-sm">★</span>
                        </div>
                        <span class="text-xs font-medium text-foreground">Trending Now</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

