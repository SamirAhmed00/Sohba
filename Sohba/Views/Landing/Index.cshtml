                </div>
                <div class="stack-chip" data-anim="reveal">
                    <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5z"></path><path d="m9 12 2 2 4-4"></path></svg></div>
                    <span class="name">FluentValidation</span><span class="role">Validation</span>
                </div>
                <div class="stack-chip" data-anim="reveal">
                    <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.5"></circle><path d="m21 16-5-5-9 9"></path></svg></div>
                    <span class="name">ImageSharp</span><span class="role">Media pipeline</span>
                </div>
                <div class="stack-chip" data-anim="reveal">
                    <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l5 5v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"></path><path d="M9 12h6"></path><path d="M9 16h6"></path><path d="M9 8h2"></path></svg></div>
                    <span class="name">Serilog</span><span class="role">Observability</span>
                </div>
                <div class="stack-chip" data-anim="reveal">
                    <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 1 4 7.5"></path><path d="M3 19v-5h5"></path></svg></div>
