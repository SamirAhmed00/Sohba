@* File: Sohba/Views/Landing/Index.cshtml *@
@{
    ViewData["Title"] = "Sohba — Where Real Connections Live";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<!-- Open Graph & SEO Metadata -->
<head>
    <meta name="description" content="Sohba is a modern, privacy-first social platform: real-time notifications, 24-hour stories, threaded conversations, groups, pages, and enterprise-grade moderation — built end-to-end on ASP.NET Core." />
    <meta property="og:title" content="Sohba — Where Real Connections Live" />
    <meta property="og:description" content="A full-stack ASP.NET Core social platform engineered for authenticity, privacy, and real-time speed." />
    <meta property="og:type" content="website" />
</head>

<div class="landing-wrapper">

    <!-- ============================================================
         1. NAVIGATION HEADER
         ============================================================ -->
    <header class="glass-header" id="landingHeader">
        <div class="nav-container">
            <!-- Brand Logo -->
            <a asp-controller="Landing" asp-action="Index" class="logo-link" aria-label="Sohba Home">
                <div class="logo-icon">
                    <span>S</span>
                </div>
                <span class="logo-text">SOHBA</span>
            </a>

            <nav class="nav-menu" aria-label="Page Sections">
                <a href="#showcase" class="nav-anchor-link">Features</a>
                <a href="#community" class="nav-anchor-link">Community</a>
                <a href="#security" class="nav-anchor-link">Privacy</a>
                <a href="#stack" class="nav-anchor-link">Technology</a>
            </nav>

            <div class="auth-links">
                @if (ViewBag.IsAuthenticated == true)
                {
                    <span class="welcome-tag">Welcome back, <strong>@ViewBag.UserName</strong></span>
                    <a asp-controller="Home" asp-action="Index" class="btn-nav-primary">
                        <span>Go to Feed</span>
                        <i data-lucide="arrow-right" style="width:16px;height:16px"></i>
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn-nav-ghost">Sign In</a>
                    <a asp-controller="Auth" asp-action="Register" class="btn-nav-primary">
                        <span>Join Sohba</span>
                        <i data-lucide="sparkles" style="width:14px;height:14px"></i>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- ============================================================
         2. HERO
         ============================================================ -->
    <section class="hero-section" id="hero">
        <div id="hero-canvas-container" aria-hidden="true">
            <canvas id="hero-canvas"></canvas>
        </div>

        <div class="container hero-inner">
            <div class="hero-grid">

                <div class="hero-copy">
                    <div class="hero-pill" data-anim="fade-up">
                        <span class="pill-dot"><span class="ping"></span><span class="dot"></span></span>
                        <span>Full-stack ASP.NET Core social platform</span>
                    </div>

                    <h1 class="hero-title">
                        <span class="line" data-anim="mask-line">Where real connections</span>
                        <span class="line" data-anim="mask-line"><em>find their home.</em></span>
                    </h1>

                    <p class="hero-subtitle" data-anim="fade-up">
                        A social space for sharing moments, finding your people, and joining communities. Explore a chronological feed, 24-hour stories, threaded conversations, groups, pages, and real-time notifications.
                    </p>

                    <div class="hero-cta-group" data-anim="fade-up">
                        @if (ViewBag.IsAuthenticated == true)
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn-hero-primary">
                                <span>Go to your feed</span>
                                <i data-lucide="arrow-right" style="width:18px;height:18px"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Register" class="btn-hero-primary">
                                <span>Create free account</span>
                                <i data-lucide="arrow-right" style="width:18px;height:18px"></i>
                            </a>
                        }
                        <a href="#showcase" class="btn-hero-secondary">
                            <i data-lucide="layout-grid" style="width:18px;height:18px"></i>
                            <span>Explore the platform</span>
                        </a>
                    </div>

                    <div class="hero-proof" data-anim="fade-up">
                        <div class="stack">
                            <span style="background:#345e6a">M</span>
                            <span style="background:#79b9a9">A</span>
                            <span style="background:#1f414b">S</span>
                            <span style="background:#ddaa76">Y</span>
                        </div>
                        <span>Built on a real Clean Architecture solution — Domain, Application, Infrastructure &amp; Web</span>
                    </div>
                </div>

                <div class="hero-visual" data-anim="fade-left">
                    <div class="hero-mockup-wrapper" style="position:relative; padding: 20px 0;">

                        <div class="floating-badge top-badge animate-float" data-anim="pop">
                            <i data-lucide="zap" style="width:18px;height:18px"></i>
                            <div>
                                <strong>Live now</strong>
                                <span>SignalR notification</span>
                            </div>
                        </div>

                        <div class="mockup-card">
                            <div class="mockup-header">
                                <div class="mockup-avatar">M</div>
                                <div class="mockup-meta">
                                    <strong>Mona Adel</strong>
                                    <span>Posted in <strong>UX Circle</strong> · 2m ago</span>
                                </div>
                            </div>
                            <div class="mockup-body">
                                <p>Just shipped the new onboarding flow 🎉 Feedback welcome — tagging the design crew.</p>
                                <div class="mockup-image"></div>
                            </div>
                            <div class="mockup-reactions">
                                <span class="reaction-chip">❤️ 42</span>
                                <span class="reaction-chip">😂 8</span>
                                <span>12 comments</span>
                            </div>
                        </div>

                        <div class="floating-badge bottom-badge animate-float-delayed" data-anim="pop">
                            <i data-lucide="shield-check" style="width:18px;height:18px"></i>
                            <div>
                                <strong>Private by default</strong>
                                <span>Blocking + soft-delete</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Marquee -->
    <div class="marquee-section" aria-hidden="true">
        <div class="marquee-track">
            <span>6 reaction emotions</span><span>24-hour protected stories</span><span>4-level threaded comments</span><span>Real-time SignalR notifications</span><span>Groups with role hierarchy</span><span>Automatic WebP optimisation</span><span>Policy-based rate limiting</span><span>Immutable admin audit log</span>
            <span>6 reaction emotions</span><span>24-hour protected stories</span><span>4-level threaded comments</span><span>Real-time SignalR notifications</span><span>Groups with role hierarchy</span><span>Automatic WebP optimisation</span><span>Policy-based rate limiting</span><span>Immutable admin audit log</span>
        </div>
    </div>

    <!-- ============================================================
         3. BENTO FEATURE SHOWCASE
         ============================================================ -->
    <section class="showcase-section" id="showcase">
        <div class="container">
            <div class="section-head" data-anim="fade-up">
                <span class="eyebrow">The platform</span>
                <h2>A social experience built around the way people connect.</h2>
                <p>Explore the core experiences available in Sohba, from everyday sharing to community spaces and thoughtful controls.</p>
            </div>

            <div class="bento-grid">

                <div class="bento-card dark span-2" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="layout-list" style="width:22px;height:22px"></i></div>
                    <span class="bento-tag">Core feed</span>
                    <h3>One chronological timeline, three sources</h3>
                    <p>Personal posts, group posts, and page posts merge into a single feed — sorted strictly by time, filtered by privacy and membership, never by an engagement algorithm.</p>
                </div>

                <div class="bento-card" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="smile" style="width:22px;height:22px"></i></div>
                    <span class="bento-tag">Engagement</span>
                    <h3>Six reaction emotions</h3>
                    <p>Like, Love, Haha, Wow, Sad, Angry — one reaction per person, toggled instantly.</p>
                </div>

                <div class="bento-card" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="message-square" style="width:22px;height:22px"></i></div>
                    <span class="bento-tag">Conversations</span>
                    <h3>Threaded, 4 levels deep</h3>
                    <p>Nested replies with a domain-enforced depth guard, so threads stay readable.</p>
                </div>

                <div class="bento-card span-row-2" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="clock" style="width:22px;height:22px"></i></div>
                    <span class="bento-tag">Stories</span>
                    <h3>24-hour stories, protected media</h3>
                    <p>Photos, video, and text stories that expire on the hour. Media lives outside the public web root and streams only after a live authorization check — friendship, blocking, and privacy are all verified per request.</p>
                </div>

                <div class="bento-card" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="users" style="width:22px;height:22px"></i></div>
                    <span class="bento-tag">Groups</span>
                    <h3>Groups with real roles</h3>
                    <p>Member, Co-Admin, Admin — join requests reviewed, not just rubber-stamped.</p>
                </div>

                <div class="bento-card" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="flag" style="width:22px;height:22px"></i></div>
                    <span class="bento-tag">Pages</span>
                    <h3>Creator &amp; business pages</h3>
                    <p>Four-tier roles up to Page Owner, with safe ownership transfer.</p>
                </div>

                <div class="bento-card dark span-2" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="bookmark" style="width:22px;height:22px"></i></div>
                    <span class="bento-tag">Saved</span>
                    <h3>Custom saved collections</h3>
                    <p>Bookmark posts into Favorites, Watch Later, Work, or your own folders — tagged and grouped for effortless retrieval later.</p>
                </div>

                <div class="bento-card span-2" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="search" style="width:22px;height:22px"></i></div>
                    <span class="bento-tag">Discovery</span>
                    <h3>One search bar, four entities</h3>
                    <p>Posts, people, groups, and pages — with live autocomplete and privacy-aware results that never leak what you shouldn't see.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- ============================================================
         4. COMMUNITY EXPERIENCE
         ============================================================ -->
    <section class="community-section" id="community">
        <div class="container">
            <div class="section-head center" data-anim="fade-up">
                <span class="eyebrow">Find your people</span>
                <h2>One place for your moments, conversations, and communities.</h2>
                <p>Keep up with friends, share what matters, and take part in spaces built around shared interests.</p>
            </div>
            <div class="community-grid">
                <article class="community-card community-card-large" data-anim="reveal">
                    <div class="community-art feed-art"><span class="art-bubble bubble-one">A little moment worth sharing.</span><span class="art-bubble bubble-two"><i data-lucide="heart"></i> Loved by your circle</span><div class="art-orbit"></div></div>
                    <div class="community-card-copy"><span class="bento-tag">Your feed</span><h3>Catch up in your own time.</h3><p>A chronological timeline brings together personal, group, and page posts, so updates are presented by time rather than an engagement ranking.</p></div>
                </article>
                <article class="community-card" data-anim="reveal">
                    <div class="community-art stories-art"><div class="story-ring"><i data-lucide="clock-3"></i></div><span class="story-label">24 hours</span></div>
                    <div class="community-card-copy"><span class="bento-tag">Stories</span><h3>Small updates, shared in the moment.</h3><p>Post photo, video, or text stories that are designed to expire after 24 hours, with media access protected by authorization checks.</p></div>
                </article>
                <article class="community-card" data-anim="reveal">
                    <div class="community-art groups-art"><div class="people-stack"><span>J</span><span>N</span><span>M</span><span>+</span></div><div class="group-art-lines"><i></i><i></i><i></i></div></div>
                    <div class="community-card-copy"><span class="bento-tag">Groups &amp; pages</span><h3>Make room for shared interests.</h3><p>Join groups, follow pages, and participate in spaces with role-based management for members, co-admins, admins, and owners.</p></div>
                </article>
                <article class="community-card community-card-wide" data-anim="reveal">
                    <div class="community-art discover-art"><div class="search-orb"><i data-lucide="search"></i></div><span class="discover-chip chip-a">People</span><span class="discover-chip chip-b">Groups</span><span class="discover-chip chip-c">Posts</span><span class="discover-chip chip-d">Pages</span></div>
                    <div class="community-card-copy"><span class="bento-tag">Discovery &amp; saved posts</span><h3>Find it now. Keep it for later.</h3><p>Search across posts, people, groups, and pages with privacy-aware results. Save posts into named collections to return to them when you need them.</p></div>
                </article>
            </div>
        </div>
    </section>

    <!-- ============================================================
         5. DEEP DIVE — REAL-TIME ENGINE
         ============================================================ -->
    <section class="deepdive-section" id="realtime">
        <div class="container">
            <div class="deepdive-row">
                <div class="deepdive-copy" data-anim="fade-right">
                    <span class="eyebrow">Real-time engine</span>
                    <h2>Notifications that arrive before you refresh.</h2>
                    <p>A dedicated SignalR hub, authenticated over a hybrid cookie + JWT handshake, pushes every meaningful event straight to the browser — no polling, no delay.</p>
                    <ul class="deepdive-list">
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Hybrid authentication.</strong> A secure HTTP-only cookie serves page navigation, while a signed JWT — extracted from the query string on handshake — authorizes the WebSocket.</div></li>
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Seven event types.</strong> Reactions, comments, friend requests, group invitations, page follows, story likes, and system alerts — each targeted at the exact recipient.</div></li>
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Resilient client.</strong> Automatic reconnection with backoff, live toast messages, and an unread badge that updates without a page reload.</div></li>
                    </ul>
                </div>
                <div class="deepdive-visual" data-anim="fade-left">
                    <div class="panel-card">
                        <div class="panel-head"><span></span><span></span><span></span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="heart" style="width:16px;height:16px"></i>PostLike</span><span class="value">Clients.User(id)</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="message-circle" style="width:16px;height:16px"></i>PostComment</span><span class="value">ReceiveNotification</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="user-plus" style="width:16px;height:16px"></i>FriendRequest</span><span class="value">SignalR Hub</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="users" style="width:16px;height:16px"></i>GroupInvitation</span><span class="value">/notificationHub</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="flag" style="width:16px;height:16px"></i>PageFollow</span><span class="value">Instant</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="clock" style="width:16px;height:16px"></i>StoryLike</span><span class="value">Realtime</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         5. DEEP DIVE — SECURITY & PRIVACY
         ============================================================ -->
    <section class="deepdive-section" id="security">
        <div class="container">
            <div class="deepdive-row reverse">
                <div class="deepdive-copy" data-anim="fade-left">
                    <span class="eyebrow">Security &amp; privacy</span>
                    <h2>Guarded at every layer, not bolted on after.</h2>
                    <p>From brute-force protection to file-upload spoofing, Sohba treats security as architecture, not an afterthought.</p>
                    <ul class="deepdive-list">
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Eight rate-limit policies.</strong> Auth, feed, search, story creation, and friend requests each get their own partitioned window — by IP or by user.</div></li>
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Two-way blocking, separate from bans.</strong> Peer-to-peer blocking hides content instantly; platform bans are a distinct administrative action with a full lineage trail.</div></li>
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Magic-byte upload validation.</strong> Every image is decoded and re-encoded to WebP — spoofed extensions are rejected before they ever touch disk.</div></li>
                    </ul>
                </div>
                <div class="deepdive-visual" data-anim="fade-right">
                    <div class="panel-card">
                        <div class="panel-head"><span></span><span></span><span></span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="lock" style="width:16px;height:16px"></i>Auth</span><span class="value">15 req / min · IP</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="rss" style="width:16px;height:16px"></i>Feed</span><span class="value">60 req / min</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="image" style="width:16px;height:16px"></i>StoryCreate</span><span class="value">10 req / min · user</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="user-plus" style="width:16px;height:16px"></i>FriendRequest</span><span class="value">30 req / min</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="search" style="width:16px;height:16px"></i>Search</span><span class="value">60 req / min</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="shield" style="width:16px;height:16px"></i>Rejected</span><span class="value">HTTP 429 JSON</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         7. DEEP DIVE — ADMIN COMMAND CENTER
         ============================================================ -->
    <section class="deepdive-section" id="admin">
        <div class="container">
            <div class="deepdive-row">
                <div class="deepdive-copy" data-anim="fade-right">
                    <span class="eyebrow">Moderation</span>
                    <h2>A command center for keeping the community healthy.</h2>
                    <p>A dedicated dashboard gives administrators the tools to act fast — and every action leaves a permanent, auditable trace.</p>
                    <ul class="deepdive-list">
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Live analytics.</strong> User growth, blocked accounts, posts, groups, and pending reports — charted by day.</div></li>
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Reports queue.</strong> Spam, harassment, and inappropriate content routed to admins, with resolve, dismiss, or remove-and-resolve actions.</div></li>
                        <li><span class="check"><i data-lucide="check" style="width:13px;height:13px"></i></span><div><strong>Admin lineage.</strong> Every admin tracks who promoted them, so a sub-admin can never demote or block the platform owner.</div></li>
                    </ul>
                </div>
                <div class="deepdive-visual" data-anim="fade-left">
                    <div class="panel-card">
                        <div class="panel-head"><span></span><span></span><span></span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="bar-chart-3" style="width:16px;height:16px"></i>Dashboard</span><span class="value">Live counts</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="flag" style="width:16px;height:16px"></i>Reports</span><span class="value">Pending → Resolved</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="eye-off" style="width:16px;height:16px"></i>HidePost</span><span class="value">Soft moderation</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="user-x" style="width:16px;height:16px"></i>BlockUser</span><span class="value">Ban ≠ delete</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="file-clock" style="width:16px;height:16px"></i>AuditLog</span><span class="value">Immutable</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         8. TECH STACK
         ============================================================ -->
    <section class="stack-section" id="stack">
        <div class="container">
            <div class="section-head center" data-anim="fade-up">
                <span class="eyebrow">Under the hood</span>
                <h2>Built on a real, layered .NET architecture.</h2>
                <p>Domain, Application, Infrastructure, and Web projects — each with a single responsibility.</p>
            </div>
            <div class="stack-grid">
                <div class="stack-chip" data-anim="reveal"><span class="name">.NET 10</span><span class="role">Runtime</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">EF Core</span><span class="role">ORM</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">SQL Server</span><span class="role">Database</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">SignalR</span><span class="role">Real-time</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">Identity</span><span class="role">Auth</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">AutoMapper</span><span class="role">Mapping</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">FluentValidation</span><span class="role">Validation</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">ImageSharp</span><span class="role">Media pipeline</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">Serilog</span><span class="role">Observability</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">GSAP</span><span class="role">Motion</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">Three.js</span><span class="role">3D canvas</span></div>
                <div class="stack-chip" data-anim="reveal"><span class="name">Razor MVC</span><span class="role">Views</span></div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         9. METRICS
         ============================================================ -->
    <section class="metrics-section" id="metrics">
        <div class="container">
            <div class="metrics-grid">
                <div class="metric-block" data-anim="fade-up">
                    <div class="metric-number counter" data-value="21" data-suffix="">0</div>
                    <div class="metric-label">Domain entities</div>
                </div>
                <div class="metric-block" data-anim="fade-up">
                    <div class="metric-number counter" data-value="6" data-suffix="">0</div>
                    <div class="metric-label">Reaction emotions</div>
                </div>
                <div class="metric-block" data-anim="fade-up">
                    <div class="metric-number counter" data-value="8" data-suffix="">0</div>
                    <div class="metric-label">Rate-limit policies</div>
                </div>
                <div class="metric-block" data-anim="fade-up">
                    <div class="metric-number counter" data-value="24" data-suffix="h">0</div>
                    <div class="metric-label">Story lifespan</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         10. TOPICS / ADVANCED TOPICS
         ============================================================ -->
    <section class="topics-section" id="topics">
        <div class="container">
            <div class="section-head center" data-anim="fade-up">
                <span class="eyebrow">How Sohba was engineered</span>
                <h2>From solid foundations to production-grade systems.</h2>
                <p>Every concept below is implemented in the codebase — not a checklist, a build log.</p>
            </div>

            <div class="topics-grid" data-anim="fade-up">
                <div class="topics-col">
                    <div class="topics-col-head foundations">
                        <div class="badge"><i data-lucide="layers" style="width:19px;height:19px"></i></div>
                        <div>
                            <h3>Foundations</h3>
                            <span>The architecture everything else stands on</span>
                        </div>
                    </div>
                    <div class="topic-list">
                        <div class="topic-item"><span class="dot"></span><div><strong>Clean / layered architecture</strong> — Domain, Application, Infrastructure, and Web kept strictly separate.</div></div>
                        <div class="topic-item"><span class="dot"></span><div><strong>ASP.NET Core MVC &amp; Razor Views</strong> — server-rendered pages with AJAX-aware controllers.</div></div>
                        <div class="topic-item"><span class="dot"></span><div><strong>Entity Framework Core</strong> — code-first modelling with Fluent API configurations.</div></div>
                        <div class="topic-item"><span class="dot"></span><div><strong>ASP.NET Core Identity</strong> — role-based authorization for Users, Admins, and Owners.</div></div>
                        <div class="topic-item"><span class="dot"></span><div><strong>Repository &amp; Unit of Work</strong> — a consistent data-access boundary across every feature.</div></div>
                        <div class="topic-item"><span class="dot"></span><div><strong>DTOs &amp; AutoMapper</strong> — domain entities never leak directly into views.</div></div>
                        <div class="topic-item"><span class="dot"></span><div><strong>FluentValidation</strong> — declarative, testable input rules on every form.</div></div>
                    </div>
                </div>

