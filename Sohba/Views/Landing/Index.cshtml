@* File: Sohba/Views/Landing/Index.cshtml *@
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Sohba — Where Real Connections Live";
    ViewData["Description"] = "A privacy-first social platform: real-time notifications, 24h stories, threaded conversations, groups & pages — built end-to-end on ASP.NET Core.";
}

<div class="landing-wrapper">

    <!-- Scroll progress bar -->
    <div class="scroll-progress" aria-hidden="true"></div>

    <!-- ================= 1. HEADER ================= -->
    <header class="glass-header" id="landingHeader">
        <div class="nav-container">
            <a asp-controller="Landing" asp-action="Index" class="logo-link" aria-label="Sohba Home">
                <div class="logo-icon"><span>S</span></div>
                <span class="logo-text letter-fx">SOHBA</span>
            </a>

            <nav class="nav-menu" id="navMenu" aria-label="Page Sections">
                <a href="#showcase" class="nav-anchor-link">Features</a>
                <a href="#community" class="nav-anchor-link">Community</a>
                <a href="#security" class="nav-anchor-link">Privacy</a>
                <a href="#stack" class="nav-anchor-link">Technology</a>
            </nav>

            <div class="auth-links">
                @if (ViewBag.IsAuthenticated == true)
                {
                    <span class="welcome-tag">Welcome back, <strong>@ViewBag.UserName</strong></span>
                    <a asp-controller="Home" asp-action="Index" class="btn-nav-primary">
                        <span>Go to Feed</span>
                        <i data-lucide="arrow-right"></i>
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn-nav-ghost">Sign In</a>
                    <a asp-controller="Auth" asp-action="Register" class="btn-nav-primary">
                        <span>Join Sohba</span>
                        <i data-lucide="sparkles"></i>
                    </a>
                }
            </div>

            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="navMenu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <!-- ================= 2. HERO ================= -->
    <section class="hero-section" id="hero">
        <div id="hero-canvas-container" aria-hidden="true">
            <canvas id="hero-canvas"></canvas>
        </div>

        <div class="container hero-inner">
            <div class="hero-grid">

                <div class="hero-copy">
                    <div class="hero-pill">
                        <span class="pill-dot"><span class="ping"></span><span class="dot"></span></span>
                        <span>New Features Available</span>
                    </div>

                    <h1 class="hero-title">
                        <span class="line">Connect, Share</span>
                        <span class="line"><em>Build Your Community</em></span>
                    </h1>

                    <p class="hero-subtitle">
                        SOHBA is your gateway to a unique social experience, where technology meets
                        real human connections in a safe and organized environment.
                    </p>

                    <div class="hero-cta-group">
                        @if (ViewBag.IsAuthenticated == true)
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn-hero-primary">
                                <span>Go to your feed</span>
                                <i data-lucide="arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Register" class="btn-hero-primary">
                                <span>Get Started Free</span>
                                <i data-lucide="arrow-right"></i>
                            </a>
                        }
                        <a href="#showcase" class="btn-hero-secondary">
                            <i data-lucide="play"></i>
                            <span>Watch Demo</span>
                        </a>
                    </div>

                    <div class="hero-proof">
                        <div class="stack">
                            <span style="background:#2fae8f">A</span>
                            <span style="background:#0f7a5f">B</span>
                            <span style="background:#12795f">C</span>
                            <span style="background:#0c5f4b">D</span>
                        </div>
                        <span><strong>1,200+</strong> users joined this month</span>
                    </div>
                </div>

                <div class="hero-visual" data-anim="fade-left">
                    <div class="hero-mockup-wrapper">

                        <div class="mockup-card">
                            <div class="browser-bar">
                                <div class="browser-dots"><span></span><span></span><span></span></div>
                                <div class="browser-url">sohba.app/feed</div>
                            </div>
                            <div class="mockup-body-wrap">
                                <div class="mockup-header">
                                    <div class="mockup-avatar">SA</div>
                                    <div class="mockup-meta">
                                        <strong>Samir Ahmed</strong>
                                        <span>Just now</span>
                                    </div>
                                </div>
                                <div class="mockup-body">
                                    <p>Welcome to SOHBA! Excited to connect with everyone here.</p>
                                </div>
                                <div class="mockup-reactions">
                                    <span class="reaction-chip">❤️ 24 reactions</span>
                                    <span>8 comments</span>
                                </div>
                            </div>
                            <div class="story-row">
                                <div class="story-item">
                                    <div class="story-avatar add">+</div>
                                    <span class="story-label">Add Story</span>
                                </div>
                                <div class="story-item">
                                    <div class="story-avatar">U</div>
                                    <span class="story-label">User 1</span>
                                </div>
                                <div class="story-item">
                                    <div class="story-avatar">U</div>
                                    <span class="story-label">User 2</span>
                                </div>
                            </div>
                        </div>

                        <div class="floating-badge top-badge animate-float" data-anim="pop">
                            <div class="badge-orb mint"><i data-lucide="check"></i></div>
                            <strong>New Friend Request</strong>
                        </div>

                        <div class="floating-badge bottom-badge animate-float-delayed" data-anim="pop">
                            <div class="badge-orb teal"><i data-lucide="star"></i></div>
                            <strong>Trending Now</strong>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 3. MARQUEE ================= -->
    <div class="marquee-section" aria-hidden="true">
        <div class="marquee-track">
            <span>6 reaction emotions</span><span>24-hour protected stories</span><span>4-level threaded comments</span><span>Real-time SignalR notifications</span><span>Groups with role hierarchy</span><span>Automatic WebP optimisation</span><span>Policy-based rate limiting</span><span>Immutable admin audit log</span><span>Hashtag discovery</span>
            <span>6 reaction emotions</span><span>24-hour protected stories</span><span>4-level threaded comments</span><span>Real-time SignalR notifications</span><span>Groups with role hierarchy</span><span>Automatic WebP optimisation</span><span>Policy-based rate limiting</span><span>Immutable admin audit log</span><span>Hashtag discovery</span>
            <span>6 reaction emotions</span><span>24-hour protected stories</span><span>4-level threaded comments</span><span>Real-time SignalR notifications</span><span>Groups with role hierarchy</span><span>Automatic WebP optimisation</span><span>Policy-based rate limiting</span><span>Immutable admin audit log</span><span>Hashtag discovery</span>
        </div>
    </div>

    <!-- ================= 4. BENTO SHOWCASE ================= -->
    <section class="showcase-section" id="showcase">
        <div class="container">
            <div class="section-head" data-anim="fade-up">
                <span class="eyebrow">The platform</span>
                <h2>A social experience built around the way people connect.</h2>
                <p>Explore the core experiences available in Sohba, from everyday sharing to community spaces and thoughtful controls.</p>
            </div>

            <div class="bento-grid">
                <div class="bento-card dark span-2" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="layout-list"></i></div>
                    <span class="bento-tag">Core feed</span>
                    <h3>One chronological timeline, three sources</h3>
                    <p>Personal posts, group posts, and page posts merge into a single feed — sorted strictly by time, filtered by privacy and membership, never by an engagement algorithm.</p>
                </div>

                <div class="bento-card" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="smile"></i></div>
                    <span class="bento-tag">Engagement</span>
                    <h3>Six reaction emotions</h3>
                    <p>Like, Love, Haha, Wow, Sad, Angry — one reaction per person, toggled instantly.</p>
                </div>

                <div class="bento-card" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="message-square"></i></div>
                    <span class="bento-tag">Conversations</span>
                    <h3>Threaded, 4 levels deep</h3>
                    <p>Nested replies with a domain-enforced depth guard, so threads stay readable.</p>
                </div>

                <div class="bento-card span-row-2" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="clock"></i></div>
                    <span class="bento-tag">Stories</span>
                    <h3>24-hour stories, protected media</h3>
                    <p>Photos, video, and text stories that expire on the hour. Media lives outside the public web root and streams only after a live authorization check — friendship, blocking, and privacy are all verified per request.</p>
                </div>

                <div class="bento-card" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="users"></i></div>
                    <span class="bento-tag">Groups</span>
                    <h3>Groups with real roles</h3>
                    <p>Member, Co-Admin, Admin — join requests reviewed, not just rubber-stamped.</p>
                </div>

                <div class="bento-card" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="flag"></i></div>
                    <span class="bento-tag">Pages</span>
                    <h3>Creator &amp; business pages</h3>
                    <p>Four-tier roles up to Page Owner, with safe ownership transfer.</p>
                </div>

                <div class="bento-card dark span-2" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="bookmark"></i></div>
                    <span class="bento-tag">Saved</span>
                    <h3>Custom saved collections</h3>
                    <p>Bookmark posts into Favorites, Watch Later, Work, or your own folders — tagged and grouped for effortless retrieval later.</p>
                </div>

                <div class="bento-card span-2" data-anim="reveal">
                    <div class="bento-icon"><i data-lucide="search"></i></div>
                    <span class="bento-tag">Discovery</span>
                    <h3>One search bar, five entities</h3>
                    <p>Posts, people, groups, pages, and hashtags — with live autocomplete and privacy-aware results that never leak what you shouldn't see.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 5. COMMUNITY ================= -->
    <section class="community-section" id="community">
        <div class="container">
            <div class="section-head center" data-anim="fade-up">
                <span class="eyebrow">Find your people</span>
                <h2>One place for your moments, conversations, and communities.</h2>
                <p>Keep up with friends, share what matters, and take part in spaces built around shared interests.</p>
            </div>
            <div class="community-grid">
                <article class="community-card community-card-large" data-anim="reveal">
                    <div class="community-art feed-art"><span class="art-bubble bubble-one">A little moment worth sharing.</span><span class="art-bubble bubble-two"><i data-lucide="heart"></i> Loved by your circle</span><div class="art-orbit"></div></div>
                    <div class="community-card-copy"><span class="bento-tag">Your feed</span><h3>Catch up in your own time.</h3><p>A chronological timeline brings together personal, group, and page posts, so updates are presented by time rather than an engagement ranking.</p></div>
                </article>
                <article class="community-card" data-anim="reveal">
                    <div class="community-art stories-art"><div class="story-ring"><i data-lucide="clock-3"></i></div><span class="story-label">24 hours</span></div>
                    <div class="community-card-copy"><span class="bento-tag">Stories</span><h3>Small updates, shared in the moment.</h3><p>Post photo, video, or text stories that are designed to expire after 24 hours, with media access protected by authorization checks.</p></div>
                </article>
                <article class="community-card" data-anim="reveal">
                    <div class="community-art groups-art"><div class="people-stack"><span>J</span><span>N</span><span>M</span><span>+</span></div><div class="group-art-lines"><i></i><i></i><i></i></div></div>
                    <div class="community-card-copy"><span class="bento-tag">Groups &amp; pages</span><h3>Make room for shared interests.</h3><p>Join groups, follow pages, and participate in spaces with role-based management for members, co-admins, admins, and owners.</p></div>
                </article>
                <article class="community-card community-card-wide" data-anim="reveal">
                    <div class="community-art discover-art"><div class="search-orb"><i data-lucide="search"></i></div><span class="discover-chip chip-a">People</span><span class="discover-chip chip-b">Groups</span><span class="discover-chip chip-c">Posts</span><span class="discover-chip chip-d">Pages</span><span class="discover-chip chip-e">Hashtags</span></div>
                    <div class="community-card-copy"><span class="bento-tag">Discovery &amp; saved posts</span><h3>Find it now. Keep it for later.</h3><p>Search across posts, people, groups, and pages with privacy-aware results. Save posts into named collections to return to them when you need them.</p></div>
                </article>
            </div>
        </div>
    </section>

    <!-- ================= 6. DEEP DIVE — REAL-TIME ================= -->
    <section class="deepdive-section" id="realtime">
        <div class="container">
            <div class="deepdive-row">
                <div class="deepdive-copy" data-anim="fade-right">
                    <span class="eyebrow">Real-time engine</span>
                    <h2>Notifications that arrive before you refresh.</h2>
                    <p>A dedicated SignalR hub, authenticated over a hybrid cookie + JWT handshake, pushes every meaningful event straight to the browser — no polling, no delay.</p>
                    <ul class="deepdive-list">
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Hybrid authentication.</strong> A secure HTTP-only cookie serves page navigation, while a signed JWT — extracted from the query string on handshake — authorizes the WebSocket.</div></li>
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Seven event types.</strong> Reactions, comments, friend requests, group invitations, page follows, story likes, and system alerts — each targeted at the exact recipient.</div></li>
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Resilient client.</strong> Automatic reconnection with backoff, live toast messages, and an unread badge that updates without a page reload.</div></li>
                    </ul>
                </div>
                <div class="deepdive-visual" data-anim="fade-left">
                    <div class="panel-card">
                        <div class="panel-head"><span></span><span></span><span></span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="heart"></i>PostLike</span><span class="value">Clients.User(id)</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="message-circle"></i>PostComment</span><span class="value">ReceiveNotification</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="user-plus"></i>FriendRequest</span><span class="value">SignalR Hub</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="users"></i>GroupInvitation</span><span class="value">/notificationHub</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="flag"></i>PageFollow</span><span class="value">Instant</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="clock"></i>StoryLike</span><span class="value">Realtime</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 7. DEEP DIVE — SECURITY ================= -->
    <section class="deepdive-section" id="security">
        <div class="container">
            <div class="deepdive-row reverse">
                <div class="deepdive-copy" data-anim="fade-left">
                    <span class="eyebrow">Security &amp; privacy</span>
                    <h2>Guarded at every layer, not bolted on after.</h2>
                    <p>From brute-force protection to file-upload spoofing, Sohba treats security as architecture, not an afterthought.</p>
                    <ul class="deepdive-list">
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Eight rate-limit policies.</strong> Auth, feed, search, story creation, and friend requests each get their own partitioned window — by IP or by user.</div></li>
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Two-way blocking, separate from bans.</strong> Peer-to-peer blocking hides content instantly; platform bans are a distinct administrative action with a full lineage trail.</div></li>
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Magic-byte upload validation.</strong> Every image is decoded and re-encoded to WebP — spoofed extensions are rejected before they ever touch disk.</div></li>
                        <li><span class="check"><i data-lucide="key-round"></i></span><div><strong>Refresh-token rotation + reuse detection.</strong> Every refresh token works exactly once — replaying a stolen token instantly revokes the entire session family, not just the replayed token.</div></li>
                    </ul>
                </div>
                <div class="deepdive-visual" data-anim="fade-right">
                    <div class="panel-card">
                        <div class="panel-head"><span></span><span></span><span></span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="lock"></i>Auth</span><span class="value">15 req / min · IP</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="rss"></i>Feed</span><span class="value">60 req / min</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="image"></i>StoryCreate</span><span class="value">10 req / min · user</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="user-plus"></i>FriendRequest</span><span class="value">30 req / min</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="search"></i>Search</span><span class="value">60 req / min</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="shield"></i>Rejected</span><span class="value">HTTP 429 JSON</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 8. DEEP DIVE — ADMIN ================= -->
    <section class="deepdive-section" id="admin">
        <div class="container">
            <div class="deepdive-row">
                <div class="deepdive-copy" data-anim="fade-right">
                    <span class="eyebrow">Moderation</span>
                    <h2>A command center for keeping the community healthy.</h2>
                    <p>A dedicated dashboard gives administrators the tools to act fast — and every action leaves a permanent, auditable trace.</p>
                    <ul class="deepdive-list">
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Live analytics.</strong> User growth, blocked accounts, posts, groups, and pending reports — charted by day.</div></li>
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Reports queue.</strong> Spam, harassment, and inappropriate content routed to admins, with resolve, dismiss, or remove-and-resolve actions.</div></li>
                        <li><span class="check"><i data-lucide="check"></i></span><div><strong>Admin lineage.</strong> Every admin tracks who promoted them, so a sub-admin can never demote or block the platform owner.</div></li>
                    </ul>
                </div>
                <div class="deepdive-visual" data-anim="fade-left">
                    <div class="panel-card">
                        <div class="panel-head"><span></span><span></span><span></span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="bar-chart-3"></i>Dashboard</span><span class="value">Live counts</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="flag"></i>Reports</span><span class="value">Pending → Resolved</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="eye-off"></i>HidePost</span><span class="value">Soft moderation</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="user-x"></i>BlockUser</span><span class="value">Ban ≠ delete</span></div>
                        <div class="panel-row"><span class="label"><i data-lucide="file-clock"></i>AuditLog</span><span class="value">Immutable</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 9. TECH STACK ================= -->
    <section class="stack-section" id="stack">
        <div class="container">
            <div class="section-head center" data-anim="fade-up">
                <span class="eyebrow">Under the hood</span>
                <h2>Built on a real, layered .NET architecture.</h2>
                <p>Domain, Application, Infrastructure, and Web projects — each with a single responsibility.</p>
            </div>
            <div class="stack-grid">
                <div class="stack-chip" data-anim="reveal">
                    <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 21 7v10l-9 5-9-5V7z"></path><path d="M12 12 21 7"></path><path d="M12 12v10"></path><path d="M12 12 3 7"></path></svg></div>
