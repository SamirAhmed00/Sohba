@* File: Sohba/Views/Landing/Index.cshtml *@
@{
    ViewData["Title"] = "Connect with the World";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<!-- Open Graph & SEO Metadata -->
<head>
    <meta name="description" content="Sohba is a modern, privacy-focused social platform where real human connections happen. Share stories, join thriving groups, and interact authentically." />
    <meta property="og:title" content="Sohba — Connect with the World" />
    <meta property="og:description" content="Share stories, discover thriving communities, and build genuine social connections on Sohba." />
    <meta property="og:type" content="website" />
</head>

<div class="landing-wrapper selection:bg-[#345e69] selection:text-white">

    <!-- 1. NAVIGATION HEADER -->
    <header class="glass-header" id="landingHeader">
        <div class="nav-container">
            <!-- Brand Logo -->
            <a asp-controller="Landing" asp-action="Index" class="logo-link" aria-label="Sohba Home">
                <div class="logo-icon">
                    <span>S</span>
                </div>
                <span class="logo-text">SOHBA</span>
            </a>

            <!-- Section Navigation Anchors (Desktop) -->
            <nav class="hidden md:flex items-center gap-8 nav-menu" aria-label="Page Sections">
                <a href="#features" class="nav-anchor-link">Features</a>
                <a href="#showcase" class="nav-anchor-link">Experience</a>
                <a href="#metrics" class="nav-anchor-link">Metrics</a>
                <a href="#about" class="nav-anchor-link">About</a>
            </nav>

            <!-- Authentication Actions -->
            <div class="auth-links">
                @if (ViewBag.IsAuthenticated == true)
                {
                    <div class="flex items-center gap-3">
                        <span class="text-sm font-semibold text-slate-600 hidden sm:inline-block">
                            Welcome back, <span class="text-[#345e69] font-bold">@ViewBag.UserName</span>
                        </span>
                        <a asp-controller="Home" asp-action="Index" class="btn-nav-primary">
                            <span>Go to Feed</span>
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-3">
                        <a asp-controller="Auth" asp-action="Login" class="btn-nav-ghost">Sign In</a>
                        <a asp-controller="Auth" asp-action="Register" class="btn-nav-primary">
                            <span>Join Sohba</span>
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- 2. HERO SECTION -->
    <section class="hero-section" id="hero">
        <!-- Interactive Three.js Background Canvas -->
        <div id="hero-canvas-container" aria-hidden="true">
            <canvas id="hero-canvas"></canvas>
        </div>

        <div class="container hero-inner">
            <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center min-h-[calc(100vh-5rem)] py-16 sm:py-24">

                <!-- Left Column: Copy & CTAs -->
                <div class="lg:col-span-7 flex flex-col gap-6 text-center lg:text-left z-10">

                    <!-- Pill Tag -->
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#345e69]/10 border border-[#345e69]/20 text-[#345e69] text-xs sm:text-sm font-bold w-fit mx-auto lg:mx-0 shadow-sm animate-fade-in">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#345e69] opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#345e69]"></span>
                        </span>
                        <span>Next-Generation Social Community</span>
                    </div>

                    <!-- Main Headline -->
                    <h1 class="hero-title text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.15]">
                        Where Real Connections
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#345e69] via-[#4a8291] to-[#2a4a52] block sm:inline">
                            Find Their Home.
                        </span>
                    </h1>

                    <!-- Body Paragraph -->
                    <p class="hero-subtitle text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl mx-auto lg:mx-0">
                        Share your world with friends, dive into focused community groups, and experience social media engineered with authenticity, privacy, and speed at its core.
                    </p>

                    <!-- Hero CTA Buttons -->
                    <div class="hero-cta-group flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
                        @if (ViewBag.IsAuthenticated == true)
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn-hero-primary w-full sm:w-auto">
                                <span>Go to Your Feed</span>
                                <i data-lucide="arrow-right" class="w-5 h-5"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Register" class="btn-hero-primary w-full sm:w-auto">
                                <span>Get Started Free</span>
                                <i data-lucide="arrow-right" class="w-5 h-5"></i>
                            </a>
                        }
                        <a href="#showcase" class="btn-hero-secondary w-full sm:w-auto">
                            <i data-lucide="play-circle" class="w-5 h-5 text-[#345e69]"></i>
                            <span>Explore Features</span>
                        </a>
                    </div>

                    <!-- Social Proof / Community Counters -->
                    <div class="flex items-center gap-4 pt-4 justify-center lg:justify-start">
                        <div class="flex -space-x-3">
                            <div class="w-9 h-9 rounded-full ring-2 ring-white bg-[#345e69] text-white flex items-center justify-center text-xs font-bold">M</div>
                            <div class="w-9 h-9 rounded-full ring-2 ring-white bg-[#4a8291] text-white flex items-center justify-center text-xs font-bold">A</div>
                            <div class="w-9 h-9 rounded-full ring-2 ring-white bg-slate-700 text-white flex items-center justify-center text-xs font-bold">S</div>
                            <div class="w-9 h-9 rounded-full ring-2 ring-white bg-emerald-600 text-white flex items-center justify-center text-xs font-bold">Y</div>
                        </div>
                        <div class="text-left text-xs sm:text-sm text-slate-500">
                            <span class="font-black text-slate-800">12,000+</span> interactions this week
                        </div>
                    </div>
                </div>

                <!-- Right Column: Interactive Product Showcase Composition -->
                <div class="lg:col-span-5 relative z-10">
                    <div class="hero-mockup-wrapper">

                        <!-- Floating Post Card Preview -->
                        <div class="mockup-card shadow-2xl rounded-3xl p-5 bg-white/95 backdrop-blur-xl border border-slate-200/80 transform hover:-translate-y-1 transition-all duration-300">

                            <!-- Author Header -->
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#345e69] to-[#4a8291] p-0.5 shadow-sm">
                                        <div class="w-full h-full bg-white rounded-[14px] flex items-center justify-center font-black text-[#345e69] text-sm">
                                            SA
                                        </div>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <h2 class="font-bold text-slate-900 text-sm">Samir Ahmed</h2>
                                            <span class="text-emerald-500 text-xs" title="Verified Member">✓</span>
                                        </div>
                                        <p class="text-[11px] text-slate-400">Just now • 🌐 Public</p>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 text-xs font-medium">#Technology</span>
                            </div>

                            <!-- Post Content -->
                            <p class="text-sm text-slate-700 leading-relaxed mb-4">
                                Welcome to <strong class="text-[#345e69]">Sohba</strong>! Connect with your friends, build community groups, and share stories that matter.
                            </p>

                            <!-- Reaction Pills Row (6 Real Sohba Reactions) -->
                            <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs text-slate-500">
                                <div class="flex items-center gap-1">
                                    <span class="text-base">👍</span>
                                    <span class="text-base">❤️</span>
                                    <span class="text-base">🔥</span>
                                    <span class="font-bold text-slate-700 ml-1.5">48 reactions</span>
                                </div>
                                <span class="font-medium text-slate-500 hover:text-[#345e69] cursor-pointer">12 comments</span>
                            </div>
                        </div>

                        <!-- Floating Live Story Rail Preview -->
                        <div class="story-preview-pill shadow-xl rounded-2xl p-3 bg-white/95 backdrop-blur-md border border-slate-200/80 flex items-center gap-3 mt-4">
                            <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-[#345e69] to-[#4a8291] p-0.5">
                                <div class="w-full h-full bg-slate-50 rounded-[10px] flex items-center justify-center text-xs font-bold text-[#345e69]">
                                    + Add
                                </div>
                            </div>
                            <div class="flex-1">
                                <p class="text-xs font-bold text-slate-800">24-Hour Ephemeral Stories</p>
                                <p class="text-[11px] text-slate-400">Share moments with custom privacy control</p>
                            </div>
                        </div>

                        <!-- Floating Interaction Badge -->
                        <div class="floating-badge top-badge hidden sm:flex items-center gap-2.5 p-3 rounded-2xl bg-white shadow-xl border border-slate-100 animate-float">
                            <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-sm">
                                <i data-lucide="user-check" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">Friend Request Accepted</p>
                                <p class="text-[10px] text-slate-400">2 seconds ago</p>
                            </div>
                        </div>

                        <!-- Floating Live Connection Badge -->
                        <div class="floating-badge bottom-badge hidden sm:flex items-center gap-2.5 p-3 rounded-2xl bg-white shadow-xl border border-slate-100 animate-float-delayed">
                            <div class="w-8 h-8 rounded-xl bg-[#345e69]/10 text-[#345e69] flex items-center justify-center font-bold text-sm">
                                <i data-lucide="message-circle" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">Real-Time SignalR</p>
                                <p class="text-[10px] text-slate-400">Zero-refresh notifications</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 3. PLATFORM CAPABILITIES / EXPERIENCE SHOWCASE -->
    <section class="py-24 bg-white border-y border-slate-100" id="showcase">
        <div class="container">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-xs font-bold uppercase tracking-wider text-[#345e69]">Engineered for Modern Humans</span>
                <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-2 mb-4">
                    The Complete Social Media Experience
                </h2>
                <p class="text-slate-600 text-base sm:text-lg">
                    Everything you need to publish, discover, interact, and organize your digital life without noise or algorithmic fatigue.
                </p>
            </div>

            <!-- Bento-Style Feature Grid -->
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">

                <!-- Card 1: Expressive Posts -->
                <div class="bento-card group">
                    <div class="bento-icon-box bg-blue-50 text-blue-600">
                        <i data-lucide="layout-grid" class="w-6 h-6"></i>
                    </div>
                    <h3 class="bento-title">Expressive Feed</h3>
                    <p class="bento-desc">
                        Publish rich text, multi-image posts, and hashtags. React using 6 distinct emotions and engage with nested comment threads up to 4 levels deep.
                    </p>
                </div>

                <!-- Card 2: Communities & Pages -->
                <div class="bento-card group">
                    <div class="bento-icon-box bg-emerald-50 text-emerald-600">
                        <i data-lucide="users" class="w-6 h-6"></i>
                    </div>
                    <h3 class="bento-title">Groups & Pages</h3>
                    <p class="bento-desc">
                        Create public or private communities. Manage members with tiered roles (Owner, Admin, Member), membership requests, and group-exclusive discussions.
                    </p>
                </div>

                <!-- Card 3: Ephemeral Stories -->
                <div class="bento-card group">
                    <div class="bento-icon-box bg-purple-50 text-purple-600">
                        <i data-lucide="camera" class="w-6 h-6"></i>
                    </div>
                    <h3 class="bento-title">24-Hour Stories</h3>
                    <p class="bento-desc">
                        Share moments with media and photos. Control story privacy with Friends-Only mode, track real-time viewer lists, and react instantly.
                    </p>
                </div>

                <!-- Card 4: Smart Organization -->
                <div class="bento-card group">
                    <div class="bento-icon-box bg-amber-50 text-amber-600">
                        <i data-lucide="bookmark" class="w-6 h-6"></i>
                    </div>
                    <h3 class="bento-title">Saved Collections</h3>
                    <p class="bento-desc">
                        Organize valuable content into custom folders such as Work, Favorites, and Education. Never lose an important post or resource again.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. DETAILED FEATURES OVERVIEW -->
    <section class="py-24 bg-slate-50/70" id="features">
        <div class="container">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-xs font-bold uppercase tracking-wider text-[#345e69]">Robust Architecture</span>
                <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-2 mb-4">
                    Security, Privacy, and Control
                </h2>
                <p class="text-slate-600 text-base">
                    Built upon modern enterprise standards with full respect for your personal boundary.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Architecture Feature 1 -->
                <div class="feature-detail-card">
                    <div class="w-12 h-12 rounded-xl bg-[#345e69]/10 text-[#345e69] flex items-center justify-center mb-5">
                        <i data-lucide="shield-check" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Private & Secure</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Granular account privacy, peer-to-peer user blocking, email verification, and rate limiting ensure your community remains safe and spam-free.
                    </p>
                </div>

                <!-- Architecture Feature 2 -->
                <div class="feature-detail-card">
                    <div class="w-12 h-12 rounded-xl bg-[#345e69]/10 text-[#345e69] flex items-center justify-center mb-5">
                        <i data-lucide="search" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Universal Search</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Instant discovery across users, posts, trending hashtags, pages, and groups with unified global search and instant keyboard shortcuts.
                    </p>
                </div>

                <!-- Architecture Feature 3 -->
                <div class="feature-detail-card">
                    <div class="w-12 h-12 rounded-xl bg-[#345e69]/10 text-[#345e69] flex items-center justify-center mb-5">
                        <i data-lucide="bell" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Live SignalR Hubs</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Experience real-time notifications for reactions, comments, friend requests, and group invites delivered directly without refreshing your browser.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. VERIFIED PLATFORM METRICS -->
    <section class="py-20 bg-[#345e69] text-white" id="metrics">
        <div class="container">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">

                <div class="metric-block">
                    <div class="metric-number counter" data-value="1200" data-suffix="+">0</div>
                    <div class="metric-label">Active Members</div>
                </div>

                <div class="metric-block">
                    <div class="metric-number counter" data-value="6" data-suffix="">0</div>
                    <div class="metric-label">Reaction Emotions</div>
                </div>

                <div class="metric-block">
                    <div class="metric-number counter" data-value="100" data-suffix="%">0</div>
                    <div class="metric-label">Private & Clean</div>
                </div>

                <div class="metric-block">
                    <div class="metric-number counter" data-value="24" data-suffix="h">0</div>
                    <div class="metric-label">Story Lifespan</div>
                </div>

            </div>
        </div>
    </section>

    <!-- 6. ABOUT CREATOR / TECH STACK SECTION -->
    <section class="py-24 bg-white" id="about">
        <div class="container">
            <div class="max-w-3xl mx-auto bg-slate-50 border border-slate-200/80 rounded-3xl p-8 sm:p-12 text-center shadow-sm">

                <!-- Avatar Emblem -->
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-[#345e69] to-[#4a8291] text-white text-2xl font-black flex items-center justify-center mx-auto mb-6 shadow-md shadow-[#345e69]/20">
                    SA
                </div>

                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mb-3">
                    Crafted with Pride by Samir Ahmed
                </h2>

                <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-xl mx-auto mb-8">
                    Sohba is engineered as an enterprise-grade social application built with <strong class="text-slate-800">ASP.NET Core 10</strong>, <strong class="text-slate-800">Entity Framework Core</strong>, and <strong class="text-slate-800">Tailwind CSS</strong>, blending scalable backend patterns with an intuitive, modern user experience.
                </p>

                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition-colors shadow-sm">
                        <i data-lucide="github" class="w-4 h-4"></i>
                        <span>Explore on GitHub</span>
                    </a>
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#345e69] hover:bg-[#2a4a52] text-white text-sm font-semibold transition-colors shadow-sm">
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            <span>Go to Feed</span>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Register" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#345e69] hover:bg-[#2a4a52] text-white text-sm font-semibold transition-colors shadow-sm">
                            <i data-lucide="user-plus" class="w-4 h-4"></i>
                            <span>Create Account</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- 7. FOOTER -->
    <footer class="landing-footer">
        <div class="container footer-content">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-[#345e69] text-white flex items-center justify-center font-bold text-sm">
                    S
                </div>
                <span class="font-black tracking-tight text-slate-800 text-lg">SOHBA</span>
            </div>

            <p class="text-xs text-slate-500 text-center sm:text-left">
                &copy; @DateTime.UtcNow.Year Sohba Platform. Built by Samir Ahmed.
            </p>

            <div class="flex items-center gap-4 text-xs font-semibold text-slate-600">
                <a href="#hero" class="hover:text-[#345e69] transition-colors">Back to Top</a>
            </div>
        </div>
    </footer>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="~/js/features/landing.js" asp-append-version="true"></script>
}