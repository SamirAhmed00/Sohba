                    <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h8"></path><path d="M9 4l3 3-3 3"></path><path d="M20 17h-8"></path><path d="M15 14l-3 3 3 3"></path></svg></div>
