@model Sohba.Application.DTOs.Common.PagedResult<Sohba.Application.DTOs.UserAggregate.FriendDto>
@{
    ViewData["Title"] = "Friends";
    Layout = "_AppLayout";
    var searchQuery = ViewBag.SearchQuery as string;
}

<div class="max-w-7xl mx-auto page-transition">
    <!-- Header (Fully Responsive) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 sm:p-6 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-xl sm:text-2xl font-black text-gray-900">Friends</h1>
                <p class="text-gray-500 text-xs sm:text-sm mt-1">@Model.TotalCount friends in your network</p>
            </div>

            <!-- Action Buttons (Responsive Wrapping) -->
            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                <a asp-action="Requests" class="flex-1 sm:flex-initial justify-center px-3 sm:px-4 py-2 bg-slate-100 text-gray-700 text-xs sm:text-sm font-semibold rounded-xl hover:bg-slate-200 transition-colors flex items-center gap-1.5 sm:gap-2">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    <span>Requests</span>
                    <span id="pendingRequestsBadge" class="hidden bg-red-500 text-white text-[10px] sm:text-xs rounded-full w-4 h-4 sm:w-5 sm:h-5 flex items-center justify-center font-bold"></span>
                </a>
                <a asp-action="Blocked" class="flex-1 sm:flex-initial justify-center px-3 sm:px-4 py-2 bg-slate-100 text-gray-700 text-xs sm:text-sm font-semibold rounded-xl hover:bg-slate-200 transition-colors flex items-center gap-1.5 sm:gap-2">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                    </svg>
                    <span>Blocked</span>
                </a>
                <a asp-controller="Friends" asp-action="Suggestions" class="w-full sm:w-auto justify-center px-3 sm:px-4 py-2 bg-[#345e69] text-white text-xs sm:text-sm font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors flex items-center gap-1.5 sm:gap-2">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                    </svg>
                    <span>Find Friends</span>
                </a>
            </div>
        </div>

        <!-- Backend Search Bar with Perfect SVG Alignment -->
        <form method="get" asp-action="Index" class="mt-4">
            <div class="relative flex items-center">
                <div class="pointer-events-none absolute inset-y-0 left-0 pl-3.5 flex items-center">
                    <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input type="text" name="q" value="@searchQuery" placeholder="Search friends by name..."
                       class="w-full pl-10 pr-24 py-2.5 sm:py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all" />
                <button type="submit"
                        class="absolute right-1.5 px-3 py-1.5 sm:py-2 bg-[#345e69] hover:bg-[#2a4b55] text-white text-xs sm:text-sm font-semibold rounded-lg transition-colors">
                    Search
                </button>
            </div>
        </form>
    </div>

    <!-- Friends Grid -->
    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var friend in Model.Items)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 hover-lift group user-card">
                    <!-- Clickable Profile Link -->
                    <a href="/Profile/Index/@friend.FriendUserId" class="flex items-center gap-4 group/profile">
                        <div class="relative shrink-0">
                            <img src="@(friend.ProfilePictureUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(friend.FriendName)}&background=345e69&color=fff")"
                                 class="w-16 h-16 rounded-2xl object-cover border-2 border-slate-100 group-hover/profile:border-[#345e69] transition-colors"
                                 alt="@friend.FriendName" />
                            <span class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white"></span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate group-hover/profile:text-[#345e69] transition-colors">@friend.FriendName</h3>
                            <p class="text-sm text-gray-500">@friend.Status</p>
                        </div>
                    </a>

                    <!-- Action Buttons -->
                    <div class="flex gap-2 mt-4">
                        <a href="/Profile/Index/@friend.FriendUserId" class="flex-1 py-2 text-center bg-[#345e69]/10 text-[#345e69] font-semibold rounded-xl hover:bg-[#345e69] hover:text-white transition-colors text-sm">
                            View Profile
                        </a>
                        <button onclick="unfriend('@friend.FriendUserId')" class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-colors" title="Remove Friend">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                        <button onclick="blockUser('@friend.FriendUserId')" class="p-2 text-gray-400 hover:text-orange-500 hover:bg-orange-50 rounded-xl transition-colors" title="Block">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="mt-8 flex justify-center items-center gap-2">
                @if (Model.HasPreviousPage)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-q="@searchQuery"
                       class="px-3.5 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-semibold rounded-xl hover:bg-slate-50 transition">
                        Previous
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.Page)
                    {
                        <span class="w-9 h-9 flex items-center justify-center bg-[#345e69] text-white text-sm font-bold rounded-xl shadow-sm">
                            @i
                        </span>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-page="@i" asp-route-q="@searchQuery"
                           class="w-9 h-9 flex items-center justify-center bg-white border border-slate-200 text-slate-700 text-sm font-semibold rounded-xl hover:bg-slate-50 transition">
                            @i
                        </a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-q="@searchQuery"
                       class="px-3.5 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-semibold rounded-xl hover:bg-slate-50 transition">
                        Next
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="text-center py-16 sm:py-20 bg-white rounded-2xl border border-slate-100 mt-4">
            <div class="bg-slate-50 w-20 h-20 sm:w-24 sm:h-24 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-10 h-10 sm:w-12 sm:h-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            </div>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <h3 class="text-lg font-bold text-gray-900">No friends found</h3>
                <p class="text-gray-500 text-sm mt-1">No friends match "@searchQuery"</p>
                <a asp-action="Index" class="inline-block mt-4 px-4 py-2 bg-[#345e69] text-white text-sm font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">
                    Clear Search
                </a>
            }
            else
            {
                <h3 class="text-lg font-bold text-gray-900">No friends yet</h3>
                <p class="text-gray-500 text-sm mt-1">Start connecting with people!</p>
                <a asp-action="Suggestions" class="inline-block mt-4 px-4 py-2 bg-[#345e69] text-white text-sm font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">
                    Find Friends
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function unfriend(userId) {
            window.showConfirmModal({
                title: 'Remove Friend',
                message: 'Are you sure you want to remove this friend?',
                type: 'warning',
                confirmText: 'Remove',
                onConfirm: async function () {
                    const result = await SohbaApp.post('/Friends/Unfriend', { friendId: userId });
                    if (result.success) {
                        SohbaApp.toast('Friend removed', 'success');
                        location.reload();
                    } else {
                        SohbaApp.toast(result.error || 'Failed to remove friend', 'error');
                    }
                }
            });
        }

        function blockUser(userId) {
            window.showConfirmModal({
                title: 'Block User',
                message: 'Are you sure you want to block this user? They will be removed from your friends list.',
                type: 'warning',
                confirmText: 'Block',
                onConfirm: async function () {
                    const result = await SohbaApp.post('/Friends/BlockUser', { userId });
                    if (result.success) {
                        SohbaApp.toast('User blocked', 'success');
                        location.reload();
                    } else {
                        SohbaApp.toast(result.error || 'Failed to block user', 'error');
                    }
                }
            });
        }

        async function loadPendingRequestsCount() {
            const response = await fetch('/Friends/GetPendingRequestsCount');
            const data = await response.json();
            const count = data.data ?? data.Data ?? 0;
            const badge = document.getElementById('pendingRequestsBadge');
            if (count > 0 && badge) {
                badge.textContent = count > 99 ? '99+' : count;
                badge.classList.remove('hidden');
            }
        }

        loadPendingRequestsCount();
    </script>
}