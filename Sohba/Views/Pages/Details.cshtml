@model Sohba.Application.DTOs.GroupAndPageAggregate.PageResponseDto
@using Sohba.Domain.Enums
@{
    ViewData["Title"] = Model.Name;
    Layout = "_AppLayout";

    var currentUserRole = ViewBag.CurrentUserRole as PageRole?;
    var isPageOwner = currentUserRole == PageRole.PageOwner || (ViewBag.CurrentUserId != null && Model.AdminId == (Guid)ViewBag.CurrentUserId);
    var canEditPage = isPageOwner || (currentUserRole.HasValue && currentUserRole.Value >= PageRole.Admin);
    var canPostAsPage = isPageOwner || (currentUserRole.HasValue && currentUserRole.Value >= PageRole.CoAdmin);
    var isAuthorizedMember = isPageOwner || (currentUserRole.HasValue);
    var isUnauthorizedPrivateViewer = Model.IsPrivate && !isAuthorizedMember;
}

<div class="max-w-7xl mx-auto page-transition py-4 px-4">
    <!-- Header Card -->
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden mb-6">
        <!-- Cover Banner (Click to open fullscreen lightbox) -->
        <div class="h-52 relative @(string.IsNullOrEmpty(Model.BackgroundImageUrl) ? "bg-slate-700" : "cursor-pointer")"
             onclick="openPageImageFullscreen('@Model.BackgroundImageUrl')"
            @if (!string.IsNullOrEmpty(Model.BackgroundImageUrl))
            {
                <text>style="background-image: url('@Model.BackgroundImageUrl'); background-size: cover; background-position: center;"</text>
            }
            >
                <!-- Avatar positioned overlapping the bottom edge -->
                <div class="absolute -bottom-12 left-8 z-10" onclick="event.stopPropagation()">
                    <div class="w-32 h-32 bg-white p-2 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-center cursor-pointer"
                         onclick="openPageImageFullscreen('@Model.ImageUrl')">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="w-full h-full rounded-xl object-cover" alt="@Model.Name" />
                        }
                        else
                        {
                            <div class="w-full h-full bg-slate-100 rounded-xl flex items-center justify-center text-slate-700 text-3xl font-bold">
                                @Model.Name[0]
                            </div>
                        }
                    </div>
                </div>

                <!-- Privacy indicator badge in top right -->
                <div class="absolute top-4 right-4 z-10" onclick="event.stopPropagation()">
                    @if (Model.IsPrivate)
                    {
                        <span class="px-3 py-1 bg-amber-100 text-amber-900 text-xs font-semibold rounded-lg shadow-sm">
                            Private Page
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1 bg-emerald-100 text-emerald-900 text-xs font-semibold rounded-lg shadow-sm">
                            Public Page
                        </span>
                    }
                </div>
            </div>

            <!-- Header Info & Controls -->
            <div class="pt-16 pb-6 px-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">@Model.Name</h1>
                    <p class="text-xs text-gray-500 mt-1">Administrator: @Model.AdminName</p>
                </div>

                <div class="flex items-center gap-3">
                    @if (canEditPage)
                    {
                        <a asp-action="PageRequests" asp-route-pageId="@Model.Id"
                           class="px-4 py-2 bg-slate-100 text-gray-700 font-semibold rounded-xl text-xs hover:bg-slate-200">
                            Review Requests
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id"
                           class="px-4 py-2 bg-slate-100 text-gray-700 font-semibold rounded-xl text-xs hover:bg-slate-200">
                            Edit Page
                        </a>
                    }

                    @if (isPageOwner)
                    {
                        <button onclick="leavePage()" id="leavePageBtn" class="px-4 py-2 bg-slate-100 text-gray-700 font-semibold rounded-xl text-xs hover:bg-slate-200">
                            Leave Page
                        </button>
                        <button onclick="openPageDeleteReasonModal()" class="px-4 py-2 bg-red-50 text-red-600 font-semibold rounded-xl text-xs hover:bg-red-100">
                            Delete Page
                        </button>
                    }
                    else if (Model.IsPrivate && !isAuthorizedMember)
                    {
                        @if (Model.HasPendingRequest)
                        {
                            <button id="followRequestBtn" disabled class="px-5 py-2.5 bg-slate-100 text-gray-500 font-bold rounded-xl text-xs cursor-not-allowed">
                                Request Pending
                            </button>
                        }
                        else
                        {
                            <button onclick="openFollowRequestModal()" id="followRequestBtn" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl text-xs">
                                Follow Request
                            </button>
                        }
                    }
                    else
                    {
                        <button onclick="leavePage()" id="leavePageBtn" class="px-4 py-2 bg-slate-100 text-gray-700 font-semibold rounded-xl text-xs hover:bg-slate-200 @(!Model.IsFollowing ? "hidden" : "")">
                            Leave Page
                        </button>

                        <button onclick="toggleFollow()" id="followBtn"
                                class="px-5 py-2.5 font-bold rounded-xl text-xs flex items-center gap-2 @(Model.IsFollowing ? "bg-slate-200 hover:bg-slate-300 text-gray-700" : "bg-emerald-600 hover:bg-emerald-700 text-white")">
                            <span>@(Model.IsFollowing ? "Following" : "Follow Page")</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="px-8 border-t border-slate-100 flex gap-8">
                <button type="button" data-tab="posts" onclick="Page_SwitchTab('posts')"
                        class="tab-btn active py-3 border-b-2 border-emerald-600 text-emerald-600 font-bold text-xs">
                    Posts
                </button>
                <button type="button" data-tab="about" onclick="Page_SwitchTab('about')"
                        class="tab-btn py-3 border-b-2 border-transparent text-gray-500 hover:text-gray-700 font-bold text-xs">
                    About & Rules
                </button>
                @if (!isUnauthorizedPrivateViewer)
                {
                    <button type="button" data-tab="followers" onclick="Page_SwitchTab('followers')"
                            class="tab-btn py-3 border-b-2 border-transparent text-gray-500 hover:text-gray-700 font-bold text-xs">
                        Followers
                    </button>
                }
            </div>
        </div>

        <!-- Tab Contents -->
        <div id="tab-content">
            <!-- 1. Posts Tab -->
            <div id="posts-tab" class="tab-pane">
                @if (isUnauthorizedPrivateViewer)
                {
                    <!-- Private page protection placeholder -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center max-w-2xl mx-auto my-6">
                        <h2 class="text-xl font-bold text-gray-900 mb-2">This Page is Private</h2>
                        <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                            Access to posts, updates, and members is restricted to approved followers. Submit a follow request to view this page's content.
                        </p>
                        @if (Model.HasPendingRequest)
                        {
                            <button disabled class="px-6 py-2.5 bg-slate-100 text-gray-500 font-semibold rounded-xl text-sm cursor-not-allowed">
                                Request Pending Approval
                            </button>
                        }
                        else
                        {
                            <button onclick="openFollowRequestModal()" class="px-6 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-xl text-sm">
                                Follow Request
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-2 space-y-6">
                            @if (canPostAsPage)
                            {
                                <div class="bg-white rounded-2xl p-4 border border-slate-200 flex items-center gap-3">
                                    <button type="button"
                                            onclick="openPageCreatePostModal('@Model.Id', '@System.Web.HttpUtility.JavaScriptStringEncode(Model.Name)')"
                                            class="flex-1 bg-slate-50 hover:bg-slate-100 text-left px-4 py-2.5 rounded-xl text-gray-500 text-xs font-medium border border-slate-200">
                                        Publish an announcement or update for your followers...
                                    </button>
                                </div>
                            }

                            <div id="page-posts">
                                <div class="text-center py-10 text-gray-500">Loading posts...</div>
                            </div>
                        </div>

                        <!-- Right Column Preview -->
                        <div class="space-y-6">
                            <div class="bg-white rounded-2xl p-6 border border-slate-200">
                                <h3 class="font-bold text-gray-900 text-sm mb-3">About</h3>
                                <p class="text-gray-600 text-xs leading-relaxed">@Model.Description</p>
                                @if (!string.IsNullOrEmpty(Model.Rules))
                                {
                                    <div class="mt-4 pt-4 border-t border-slate-100">
                                        <h4 class="text-xs font-bold text-gray-700 uppercase mb-1">Rules</h4>
                                        <p class="text-xs text-gray-500 whitespace-pre-line leading-relaxed">@Model.Rules</p>
                                    </div>
                                }
                            </div>

                            <div class="bg-white rounded-2xl p-6 border border-slate-200">
                                <div class="flex items-center justify-between mb-3">
                                    <h3 class="font-bold text-gray-900 text-sm">Followers</h3>
                                    <a href="#followers" onclick="Page_SwitchTab('followers'); return false;" class="text-emerald-700 text-xs font-semibold hover:underline">
                                        View All
                                    </a>
                                </div>
                                <div id="followersPreview" class="grid grid-cols-5 gap-2">
                                    <div class="text-xs text-center text-slate-400 py-4 col-span-5">Loading...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- 2. About & Rules Tab -->
            <div id="about-tab" class="tab-pane hidden">
                <div class="bg-white rounded-2xl p-8 border border-slate-200 space-y-6">
                    <div>
                        <h2 class="text-xl font-bold text-gray-900 mb-3">About @Model.Name</h2>
                        <p class="text-gray-700 text-sm leading-relaxed whitespace-pre-line">@Model.Description</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Rules))
                    {
                        <div class="pt-6 border-t border-slate-200">
                            <h3 class="text-base font-bold text-gray-900 mb-2">Community Guidelines & Rules</h3>
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs text-gray-700 whitespace-pre-line leading-relaxed">
                                @Model.Rules
                            </div>
                        </div>
                    }

                    @if (!isUnauthorizedPrivateViewer)
                    {
                        <div class="pt-6 border-t border-slate-200 grid grid-cols-2 gap-4 max-w-sm">
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                                <span class="text-2xl font-bold text-emerald-800" id="followersCount">0</span>
                                <span class="text-xs text-gray-600 block mt-0.5">Followers</span>
                            </div>
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                                <span class="text-2xl font-bold text-emerald-800" id="postsCount">0</span>
                                <span class="text-xs text-gray-600 block mt-0.5">Posts</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 3. Followers Tab -->
            @if (!isUnauthorizedPrivateViewer)
            {
                <div id="followers-tab" class="tab-pane hidden">
                    <div class="bg-white rounded-2xl p-6 border border-slate-200">
                        <h2 class="text-base font-bold text-gray-900 mb-4">Followers</h2>
                        <div id="followersList" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                            <div class="text-center text-gray-500 py-8 col-span-full">Loading followers...</div>
                        </div>
                        <div id="followersLoadMoreContainer" class="text-center mt-6 hidden">
                            <button type="button" onclick="loadMoreFollowers()" id="loadMoreFollowersBtn"
                                    class="px-5 py-2 bg-slate-100 hover:bg-slate-200 text-gray-700 font-semibold rounded-xl text-xs">
                                Load More Followers
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Private Page Follow Request Modal -->
    <div id="pageFollowRequestModal" class="fixed inset-0 z-[100] hidden">
        <div class="absolute inset-0 bg-black/60" onclick="closeFollowRequestModal()"></div>
        <div class="absolute inset-0 flex items-center justify-center p-4">
            <div class="bg-white w-full max-w-lg rounded-2xl border border-slate-200 shadow-xl overflow-hidden">
                <div class="p-6 border-b border-slate-200">
                    <h3 class="text-lg font-bold text-gray-900">Request Access to @Model.Name</h3>
                    <p class="text-xs text-gray-500 mt-0.5">This page is private. Please review the rules and introduce yourself.</p>
                </div>

                <div class="p-6 space-y-4">
                    <!-- Rules display at top -->
                    @if (!string.IsNullOrEmpty(Model.Rules))
                    {
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Page Rules</label>
                            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs text-gray-600 max-h-36 overflow-y-auto whitespace-pre-line leading-relaxed">
                                @Model.Rules
                            </div>
                        </div>
                    }

                    <!-- Request Message -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">
                            Request Message <span class="text-red-600">*</span>
                        </label>
                        <textarea id="pageFollowRequestMessage" rows="3"
                                  class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-1 focus:ring-[#345e69] focus:border-[#345e69]"
                                  placeholder="Explain why you would like to follow this page..."></textarea>
                    </div>
                </div>

                <div class="p-6 border-t border-slate-200 bg-slate-50 flex items-center gap-3">
                    <button type="button" onclick="closeFollowRequestModal()" class="flex-1 py-2 border border-slate-300 text-gray-700 font-semibold rounded-xl text-xs hover:bg-white">
                        Cancel
                    </button>
                    <button type="button" id="submitFollowRequestBtn" onclick="submitFollowRequest()" class="flex-1 py-2 bg-[#345e69] hover:bg-[#2a4b55] text-white font-semibold rounded-xl text-xs">
                        Submit Request
                    </button>
                </div>
            </div>
        </div>
    </div>

    <partial name="Partials/_CreatePost" />

    @section Scripts {
        <script>
            window.__pagesCurrentPageId = '@Model.Id';
            window.__pagesCurrentUserId = '@ViewBag.CurrentUserId';
            window.__pagesCurrentUserRole = '@(ViewBag.CurrentUserRole?.ToString() ?? "None")';
            window.__pagesIsOwner = @(isPageOwner ? "true" : "false");
            window.__pagesIsFollowing = @(Model.IsFollowing ? "true" : "false");
            window.__pagesIsPrivate = @(Model.IsPrivate ? "true" : "false");
            window.__pagesIsAuthorized = @(isAuthorizedMember ? "true" : "false");

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initializePageDetails);
            } else {
                initializePageDetails();
            }
        </script>
    }