@model IEnumerable<Sohba.Application.DTOs.GroupAndPageAggregate.PageResponseDto>
@{
ViewData["Title"] = "Pages";
Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition py-4">
<!-- Header banner -->
<div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Pages</h1>
            <p class="text-sm text-gray-500 mt-1">Discover public organizations and request access to private communities.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="PageRequests" class="px-4 py-2 bg-slate-100 text-gray-700 text-sm font-semibold rounded-xl hover:bg-slate-200">
                Requests
            </a>
            <a asp-action="Create" class="px-4 py-2 bg-[#345e69] text-white text-sm font-semibold rounded-xl hover:bg-[#2a4b55]">
                Create Page
            </a>
        </div>
    </div>
</div>

<!-- Pages Grid -->
<div id="pagesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden flex flex-col justify-between">
                <div>
                    <!-- Cover Thumbnail -->
                    <div class="h-24 w-full bg-slate-100 relative"
                        @if (!string.IsNullOrEmpty(item.BackgroundImageUrl))
                        {
                            <text>style="background-image: url('@item.BackgroundImageUrl'); background-size: cover; background-position: center;"</text>
                        }
                        >
                            <div class="absolute top-3 right-3">
                                @if (item.IsPrivate)
                                {
                                    <span class="px-2 py-0.5 bg-amber-100 text-amber-800 text-xs font-semibold rounded">
                                        Private
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 text-xs font-semibold rounded">
                                        Public
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-5 pt-0 relative">
                            <!-- Avatar Overlap -->
                            <div class="-mt-10 mb-3">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="w-16 h-16 rounded-xl object-cover border-2 border-white shadow-sm" alt="@item.Name" />
                                }
                                else
                                {
                                    <div class="w-16 h-16 bg-slate-200 text-gray-700 font-bold text-xl rounded-xl flex items-center justify-center border-2 border-white shadow-sm">
                                        @item.Name[0]
                                    </div>
                                }
                            </div>

                            <a href="/Pages/Details/@item.Id" class="font-bold text-gray-900 hover:text-emerald-700 text-base line-clamp-1">
                                @item.Name
                            </a>
                            <p class="text-xs text-gray-400 mt-0.5">Administrator: @item.AdminName</p>
                            <p class="text-xs text-gray-600 mt-2 line-clamp-2 leading-relaxed">
                                @item.Description
                            </p>
                        </div>
                    </div>

                    <!-- Card Actions -->
                    <div class="p-5 pt-0">
                        @if (item.AdminId == (Guid)ViewBag.CurrentUserId)
                        {
                            <a href="/Pages/Details/@item.Id" class="block text-center w-full py-2 bg-slate-100 text-gray-700 font-semibold rounded-xl text-sm hover:bg-slate-200">
                                Manage Page
                            </a>
                        }
                        else if (item.IsPrivate)
                        {
                            @if (item.IsFollowing)
                            {
                                <a href="/Pages/Details/@item.Id" class="block text-center w-full py-2 bg-slate-200 text-slate-700 font-semibold rounded-xl text-sm">
                                    Following
                                </a>
                            }
                            else
                            {
                                <a href="/Pages/Details/@item.Id" class="block text-center w-full py-2 bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100 font-semibold rounded-xl text-sm">
                                    Request Access
                                </a>
                            }
                        }
                        else
                        {
                            @if (item.IsFollowing)
                            {
                                <button onclick="toggleFollow('@item.Id', this)" class="w-full py-2 bg-slate-200 text-slate-700 font-semibold rounded-xl text-sm">
                                    Following
                                </button>
                            }
                            else
                            {
                                <button onclick="toggleFollow('@item.Id', this)" class="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl text-sm">
                                    Follow
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        }
    else
        {
            <div class="col-span-full text-center py-16 bg-white rounded-2xl border border-slate-200">
                <h3 class="text-base font-bold text-gray-900">No pages found</h3>
                <p class="text-sm text-gray-500 mt-1">Create an organization page or explore public communities.</p>
            </div>
        }
    </div>
</div>