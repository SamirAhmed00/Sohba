@model Sohba.ViewModels.Page.PageCreateViewModel
@{
    ViewData["Title"] = "Create Page";
    Layout = "_AppLayout";
}

<div class="max-w-4xl mx-auto page-transition py-4">
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
        <!-- Header -->
        <div class="p-8 border-b border-slate-200 bg-slate-50">
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Create Page</h1>
            <p class="text-sm text-gray-600 mt-1 font-medium">Set up a professional presence for your community or organization.</p>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="p-8 space-y-8">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm font-semibold"></div>

            <!-- 1. Basic Information -->
            <div class="space-y-4">
                <h2 class="text-base font-bold text-gray-900 uppercase tracking-wide border-b border-slate-100 pb-2">1. Basic Information</h2>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Page Name <span class="text-red-500">*</span></label>
                    <input asp-for="Name"
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-1 focus:ring-[#345e69] focus:border-[#345e69] text-sm"
                           placeholder="Enter official page name" />
                    <span asp-validation-for="Name" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Description <span class="text-red-500">*</span></label>
                    <textarea asp-for="Description" rows="4"
                              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-1 focus:ring-[#345e69] focus:border-[#345e69] text-sm resize-none"
                              placeholder="Describe the objective and content of this page"></textarea>
                    <span asp-validation-for="Description" class="text-red-600 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- 2. Page Privacy Selection -->
            <div class="space-y-4">
                <h2 class="text-base font-bold text-gray-900 uppercase tracking-wide border-b border-slate-100 pb-2">2. Page Privacy</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Public Option -->
                    <label class="cursor-pointer">
                        <input type="radio" asp-for="IsPrivate" value="false" class="peer hidden" checked />
                        <div class="p-5 border-2 border-slate-200 rounded-xl peer-checked:border-emerald-600 peer-checked:bg-emerald-50/20 transition-colors">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm font-bold text-gray-900">Public Page</span>
                                <span class="text-xs px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-semibold">Standard</span>
                            </div>
                            <p class="text-xs text-gray-500 leading-relaxed">
                                Anyone can find this page, view published posts, and follow without prior approval.
                            </p>
                        </div>
                    </label>

                    <!-- Private Option -->
                    <label class="cursor-pointer">
                        <input type="radio" asp-for="IsPrivate" value="true" class="peer hidden" />
                        <div class="p-5 border-2 border-slate-200 rounded-xl peer-checked:border-amber-600 peer-checked:bg-amber-50/20 transition-colors">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm font-bold text-gray-900">Private Page</span>
                                <span class="text-xs px-2 py-0.5 bg-amber-100 text-amber-800 rounded font-semibold">Protected</span>
                            </div>
                            <p class="text-xs text-gray-500 leading-relaxed">
                                Posts and followers are protected. Users must submit a follow request with a message to gain access.
                            </p>
                        </div>
                    </label>
                </div>
            </div>

            <!-- 3. Page Rules -->
            <div class="space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <h2 class="text-base font-bold text-gray-900 uppercase tracking-wide">3. Page Rules</h2>
                    <span class="text-xs text-gray-400">Optional</span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Community Guidelines</label>
                    <textarea asp-for="Rules" rows="3"
                              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-1 focus:ring-[#345e69] focus:border-[#345e69] text-sm resize-none"
                              placeholder="Outline code of conduct and criteria for membership (shown to requesters on private pages)"></textarea>
                    <p class="text-xs text-gray-500 mt-1">These rules will be displayed to prospective members before they submit a follow request.</p>
                </div>
            </div>

            <!-- 4. Media -->
            <div class="space-y-6">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <h2 class="text-base font-bold text-gray-900 uppercase tracking-wide">4. Visual Assets</h2>
                    <span class="text-xs text-gray-400">Optional</span>
                </div>

                <!-- Avatar -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Page Avatar</label>
                    <input asp-for="ImageFile" type="file" accept="image/*"
                           class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-200 file:text-slate-800 hover:file:bg-slate-300 cursor-pointer" />
                    <p class="text-xs text-gray-500 mt-1">PNG, JPG, WebP up to 5MB.</p>
                    <span asp-validation-for="ImageFile" class="text-red-600 text-xs"></span>
                    <div id="pageImagePreviewContainer" class="hidden mt-3">
                        <img id="pageImagePreview" class="w-24 h-24 rounded-xl object-cover border border-slate-200" alt="Avatar preview" />
                    </div>
                </div>

                <!-- Cover -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Page Cover Image</label>
                    <input asp-for="BackgroundImageFile" type="file" accept="image/*"
                           class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-200 file:text-slate-800 hover:file:bg-slate-300 cursor-pointer" />
                    <p class="text-xs text-gray-500 mt-1">PNG, JPG, WebP up to 5MB.</p>
                    <span asp-validation-for="BackgroundImageFile" class="text-red-600 text-xs"></span>
                    <div id="pageCoverPreviewContainer" class="hidden mt-3">
                        <img id="pageCoverPreview" class="w-full h-36 rounded-xl object-cover border border-slate-200" alt="Cover preview" />
                    </div>
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="flex items-center gap-3 pt-4 border-t border-slate-200">
                <a asp-action="Index" class="flex-1 py-2.5 border border-slate-300 text-gray-700 font-semibold rounded-xl hover:bg-slate-50 text-center text-sm">
                    Cancel
                </a>
                <button type="submit" class="flex-1 py-2.5 bg-[#345e69] hover:bg-[#2a4b55] text-white font-semibold rounded-xl text-sm">
                    Create Page
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        setupLiveImagePreview('ImageFile', 'pageImagePreview', 'pageImagePreviewContainer', 5);
        setupLiveImagePreview('BackgroundImageFile', 'pageCoverPreview', 'pageCoverPreviewContainer', 5);
    </script>
}