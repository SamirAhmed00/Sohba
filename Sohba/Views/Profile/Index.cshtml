@model Sohba.ViewModels.Profile.ProfileViewModel
@{
    ViewData["Title"] = Model.Profile.Name;
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <!-- Cover & Profile Header -->
    <div class="relative mb-20">
        <!-- Cover Image -->
        <div class="h-64 bg-gradient-to-r from-[#345e69] via-[#4a8291] to-[#345e69] rounded-2xl overflow-hidden @(!string.IsNullOrEmpty(Model.Profile.BackgroundImageUrl) ? "cursor-pointer" : "")"
             @(!string.IsNullOrEmpty(Model.Profile.BackgroundImageUrl) ? $"onclick=\"SohbaApp.openImageLightbox('{Model.Profile.BackgroundImageUrl}')\"" : "")>
            @if (!string.IsNullOrEmpty(Model.Profile.BackgroundImageUrl))
            {
                <img src="@Model.Profile.BackgroundImageUrl" class="w-full h-full object-cover" alt="Profile background" />
            }
            else
            {
                <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' ...');"></div>
            }
        </div>

        <!-- Profile Picture -->
        <div class="absolute -bottom-12 left-8">
            <div class="relative">
                <img src="@(Model.Profile.ProfilePictureUrl ?? $"https://ui-avatars.com/api/?name={Model.Profile.Name}&background=345e69&color=fff")"
                     class="w-36 h-36 rounded-2xl object-cover border-4 border-white shadow-xl cursor-pointer"
                     onclick="SohbaApp.openImageLightbox('@(Model.Profile.ProfilePictureUrl ?? $"https://ui-avatars.com/api/?name={Model.Profile.Name}&background=345e69&color=fff")')" />
                @if (Model.IsOwnProfile)
                {
                    <button class="absolute -bottom-2 -right-2 bg-white p-2 rounded-full shadow-lg hover:scale-110 transition-transform">
                        <svg class="w-5 h-5 text-[#345e69]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </button>
                }
                @if (Model.HasActiveStory)
                {
                    <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 bg-[#345e69] text-white text-[10px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap cursor-pointer"
                          onclick="openStoryViewer('@Model.Profile.Id')">
                        View Story
                    </span>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="absolute bottom-4 right-8 flex gap-3">
            @if (Model.IsOwnProfile)
            {
                <a asp-action="Edit" class="px-6 py-2.5 bg-white/90 backdrop-blur text-[#345e69] font-bold rounded-xl hover:bg-white transition-colors shadow-lg flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Edit Profile
                </a>
            }
            else
            {
                 @if (!Model.IsBlocked)
                {
                    @if (Model.FriendshipStatus == "accepted")
                    {
                        <button class="px-6 py-2.5 bg-green-600 text-white font-bold rounded-xl shadow-lg flex items-center gap-2 cursor-not-allowed" disabled>
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>Friends</span>
                        </button>
                    }
                    else if (Model.FriendshipStatus == "pending")
                    {
                        <button class="px-6 py-2.5 bg-yellow-600 text-white font-bold rounded-xl shadow-lg flex items-center gap-2 cursor-not-allowed" disabled>
                            <span>Pending</span>
                        </button>
                    }
                    else
                    {
                        <button onclick="sendFriendRequestFromProfile('@Model.Profile.Id')"
                                class="px-6 py-2.5 bg-[#345e69] text-white font-bold rounded-xl hover:bg-[#2a4b55] transition-colors shadow-lg flex items-center gap-2"
                                id="addFriendBtn">
                            <span>Add Friend</span>
                        </button>
                    }

                    <button onclick="blockUserFromProfile('@Model.Profile.Id')"
                            class="px-6 py-2.5 bg-red-50 text-red-600 font-bold rounded-xl hover:bg-red-100 transition-colors shadow-sm flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>
                            <span>Block</span>
                    </button>
                }
                else
                {
                    <button onclick="unblockUserFromProfile('@Model.Profile.Id')"
                            class="px-6 py-2.5 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 transition-colors shadow-sm flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                            <span>Unblock</span>
                    </button>
                }
            }
        </div>
    </div>

    <!-- Profile Info -->
    <div class="px-8 mb-8">
        <h1 class="text-3xl font-black text-gray-900">@Model.Profile.Name</h1>
        <p class="text-gray-500 mt-1">@Model.Profile.Email</p>
        <p class="text-gray-600 mt-3 max-w-2xl">@(Model.Profile.Bio ?? "No bio yet.")</p>

        <div class="flex gap-6 mt-4 text-sm">
            <span class="text-gray-500">
                <strong class="text-gray-900">@Model.Friends.Count()</strong> Friends
            </span>
            <span class="text-gray-500">
                <strong class="text-gray-900">@Model.Posts.Count()</strong> Posts
            </span>
            <span class="text-gray-500">
                Joined <strong class="text-gray-900">@Model.Profile.CreatedAt.ToString("MMMM yyyy")</strong>
            </span>
        </div>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 px-8 pb-8">
        <!-- Left: Friends -->
        @if (Model.CanViewFriends)
        {
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 hover-lift">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-bold text-gray-900">Friends</h3>
                        <a href="#" class="text-[#345e69] text-sm font-semibold hover:underline">See All</a>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        @foreach (var friend in Model.Friends.Take(6))
                        {
                            <div class="text-center group cursor-pointer">
                                <img src="@(friend.ProfilePictureUrl ?? $"https://ui-avatars.com/api/?name={friend.FriendName}&background=random")"
                                     class="w-full aspect-square rounded-xl object-cover group-hover:scale-105 transition-transform" />
                                <p class="text-xs font-semibold text-gray-700 mt-1 truncate">@friend.FriendName</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 text-center">
                    <svg class="w-8 h-8 text-slate-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    <p class="text-sm text-slate-500">This profile's friends list is private</p>
                </div>
            </div>
        }

        <!-- Right: Posts -->
        <div class="lg:col-span-2 space-y-6">
            @if (Model.IsOwnProfile)
            {
                // TODO: Move This To A Shared Folder
                <partial name="Partials/_CreatePost" />
            }

            <partial name="Partials/_PostCard" model="Model.Posts" />
        </div>
    </div>
</div>




@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const profileUserId = '@Model.Profile.Id';
            if (!@Json.Serialize(Model.IsOwnProfile) && typeof window.checkFriendshipStatus === 'function') {
                window.checkFriendshipStatus(profileUserId);
            }
        });
    </script>
}