@model dynamic
@{
    ViewData["Title"] = "Private Profile";
    Layout = "_AppLayout";
}

<div class="max-w-4xl mx-auto py-12">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-12 text-center">
        <div class="w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-12 h-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>
        <h1 class="text-2xl font-black text-gray-900">This Profile is Private</h1>
        <p class="text-gray-500 mt-2">You need to be friends to view this profile.</p>
        <a asp-controller="Home" asp-action="Index"
           class="inline-block mt-6 px-6 py-2 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">
            Back to Feed
        </a>
    </div>
</div>