
@model Sohba.ViewModels.Dashboard.DashboardPagesViewModel
@{
    ViewData["Title"] = "Manage Pages";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-6 mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-black text-gray-900">Pages</h1>
                <p class="text-gray-500 mt-1">Manage public and private pages</p>
            </div>
            <span class="text-sm text-gray-500">Total: <strong class="text-gray-900">@Model.TotalCount</strong></span>
        </div>

        <form method="get" asp-action="Pages" class="mt-6 flex gap-3">
            <div class="relative flex-1">
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by page name or description..."
                       class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#345e69]/20" />
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
            </div>
            <button type="submit" class="px-6 py-2 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">Filter</button>
        </form>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Page</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Owner</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Privacy</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Created</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Pages.Any())
                    {
                        @foreach (var p in Model.Pages)
                        {
                            <tr class="hover:bg-slate-50 transition-colors" data-page-id="@p.Id">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" class="w-10 h-10 rounded-xl object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-emerald-600 font-bold">
                                                @(string.IsNullOrEmpty(p.Name) ? "P" : p.Name[0].ToString().ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <div class="font-bold text-gray-900 text-sm">@p.Name</div>
                                            <div class="text-xs text-gray-400 truncate max-w-xs">@p.Description</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700 font-medium">@p.AdminName</td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold @(p.IsPrivate ? "bg-amber-50 text-amber-700" : "bg-emerald-50 text-emerald-700")">
                                        @(p.IsPrivate ? "Private" : "Public")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-500">@p.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4">
                                    <button onclick="adminDeletePage('@p.Id')" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-colors" title="Delete Page">
                                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-gray-500">No pages found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/features/dashboard.js" asp-append-version="true"></script>
    <script>
        function adminDeletePage(pageId) {
        showConfirmModal({
        title: 'Delete Page',
        message: 'Are you sure you want to delete this page? All page posts will be soft-deleted.',
        type: 'delete',
        confirmText: 'Delete Page',
        showReasonInput: true,
        onConfirm: async function(reason) {
        if (!reason) {
        SohbaApp.toast('A deletion reason is required.', 'error');
        return;
        }
        const result = await SohbaApp.post('/Dashboard/DeletePage', { pageId, reason });
        if (result.success) {
        SohbaApp.toast('Page deleted successfully', 'success');
        document.querySelector(`tr[data-page-id="${pageId}"]`)?.remove();
        } else {
        SohbaApp.toast(result.error || 'Failed to delete page', 'error');
        }
        }
        });
        }
    </script>
}