@model Sohba.ViewModels.Dashboard.DashboardCommentsViewModel
@{
    ViewData["Title"] = "Manage Comments";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-6 mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-black text-gray-900">Comments Queue</h1>
                <p class="text-gray-500 mt-1">Platform-wide comment moderation</p>
            </div>
            <span class="text-sm text-gray-500">Total Comments: <strong class="text-gray-900">@Model.TotalCount</strong></span>
        </div>

        <form method="get" asp-action="Comments" class="mt-6 flex gap-3">
            <div class="relative flex-1">
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by content or author..."
                       class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#345e69]/20" />
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
            </div>
            <button type="submit" class="px-6 py-2 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">Filter</button>
        </form>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Author</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Content</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Post</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Date</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Comments.Any())
                    {
                        @foreach (var c in Model.Comments)
                        {
                            <tr class="hover:bg-slate-50 transition-colors" data-comment-id="@c.Id">
                                <td class="px-6 py-4 text-sm font-bold text-gray-800">@c.UserName</td>
                                <td class="px-6 py-4 text-sm text-gray-700 max-w-md break-words">@c.Content</td>
                                <td class="px-6 py-4 text-xs text-blue-600">
                                    <a asp-controller="Posts" asp-action="Details" asp-route-id="@c.PostId" class="hover:underline">View Post</a>
                                </td>
                                <td class="px-6 py-4 text-xs text-gray-500">@c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="px-6 py-4">
                                    <button onclick="adminDeleteComment('@c.Id')" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-colors" title="Delete Comment">
                                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="px-6 py-12 text-center text-gray-500">No comments found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/features/dashboard.js" asp-append-version="true"></script>
    <script>
        function adminDeleteComment(commentId) {
        showConfirmModal({
        title: 'Delete Comment',
        message: 'Are you sure you want to remove this comment?',
        type: 'delete',
        confirmText: 'Delete',
        onConfirm: async function() {
        const result = await SohbaApp.post('/Dashboard/DeleteComment', { commentId });
        if (result.success) {
        SohbaApp.toast('Comment deleted successfully', 'success');
        document.querySelector(`tr[data-comment-id="${commentId}"]`)?.remove();
        } else {
        SohbaApp.toast(result.error || 'Failed to delete comment', 'error');
        }
        }
        });
        }
    </script>
}