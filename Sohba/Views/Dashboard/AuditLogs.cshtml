
@model Sohba.ViewModels.Dashboard.DashboardAuditLogsViewModel
@{
    ViewData["Title"] = "Admin Audit Logs";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-6 mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-black text-gray-900">Audit Logs</h1>
                <p class="text-gray-500 mt-1">Traceability log for administrative mutations</p>
            </div>
            <span class="text-sm text-gray-500">Total Events: <strong class="text-gray-900">@Model.TotalCount</strong></span>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Timestamp (UTC)</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Admin</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Action</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Target</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Details</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-mono text-xs">
                    @if (Model.Logs.Any())
                    {
                        @foreach (var log in Model.Logs)
                        {
                            <tr class="hover:bg-slate-50">
                                <td class="px-6 py-4 text-gray-500 whitespace-nowrap">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="px-6 py-4 font-bold text-gray-800">@log.AdminEmail</td>
                                <td class="px-6 py-4 text-indigo-600 font-bold">@log.Action</td>
                                <td class="px-6 py-4 text-gray-700">@log.TargetEntity (@log.TargetId.ToString().Substring(0, 8)...)</td>
                                <td class="px-6 py-4 text-gray-600 font-sans">@(log.Details ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="px-6 py-12 text-center text-gray-500 font-sans">No audit events recorded.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>