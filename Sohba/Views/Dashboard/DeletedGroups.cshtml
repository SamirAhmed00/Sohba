@model Sohba.ViewModels.Dashboard.DashboardDeletedGroupsViewModel
@{
    ViewData["Title"] = "Deleted Groups";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <!-- Header -->
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-6 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-black text-gray-900">Deleted Groups Moderation</h1>
                <p class="text-gray-500 mt-1">Audit log of removed groups and deletion reasons</p>
            </div>
            <div class="text-sm text-gray-500">
                Total Deleted: <span class="font-bold text-gray-900">@Model.TotalCount</span>
            </div>
        </div>

        <!-- Search Bar -->
        <div class="mt-6">
            <form method="get" asp-action="DeletedGroups" class="flex gap-3">
                <div class="relative flex-1">
                    <input type="text"
                           name="search"
                           value="@Model.SearchTerm"
                           placeholder="Search by group name, deletion reason, or owner..."
                           class="w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-[#345e69]/20" />
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </span>
                </div>
                <button type="submit" class="px-6 py-2.5 bg-[#345e69] text-white font-bold rounded-2xl text-sm hover:bg-[#2a4b55] transition-colors shrink-0">
                    Filter
                </button>
            </form>
        </div>
    </div>

    <!-- Deleted Groups Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Group</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Owner</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Deletion Reason</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Deleted By</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Deleted At</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Privacy</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.DeletedGroups.Any())
                    {
                        @foreach (var group in Model.DeletedGroups)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(group.ImageUrl))
                                        {
                                            <img src="@group.ImageUrl" class="w-10 h-10 rounded-xl object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-slate-400 font-bold">
                                                @(string.IsNullOrEmpty(group.Name) ? "G" : group.Name[0].ToString().ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <div class="font-bold text-gray-900 text-sm">@group.Name</div>
                                            <div class="text-xs text-gray-400">ID: @group.Id.ToString().Substring(0, 8)...</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700 font-medium">
                                    @group.OwnerName
                                </td>
                                <td class="px-6 py-4">
                                    <div class="max-w-xs text-sm text-red-700 bg-red-50/80 border border-red-100 px-3 py-1.5 rounded-xl font-medium">
                                        @group.DeletionReason
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-600 font-medium">
                                    @group.DeletedByName
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-500">
                                    @(group.DeletedAt?.ToString("MMM dd, yyyy HH:mm") ?? "N/A")
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold @(group.IsPrivate ? "bg-amber-50 text-amber-700 border border-amber-200" : "bg-emerald-50 text-emerald-700 border border-emerald-200")">
                                        @(group.IsPrivate ? "Private" : "Public")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                                No deleted groups found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalCount > Model.PageSize)
        {
            <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between">
                <div class="text-sm text-gray-500">
                    Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) of @Model.TotalCount deleted groups
                </div>
                <div class="flex gap-2">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="DeletedGroups" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm"
                           class="px-4 py-2 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-sm font-semibold">
                            Previous
                        </a>
                    }
                    @if (Model.CurrentPage < (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize))
                    {
                        <a asp-action="DeletedGroups" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm"
                           class="px-4 py-2 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-sm font-semibold">
                            Next
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>