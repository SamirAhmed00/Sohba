@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full text-center space-y-8">
        <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8 sm:p-12">
            <!-- Shield Lock Icon -->
            <div class="w-24 h-24 bg-rose-50 rounded-3xl flex items-center justify-center mx-auto mb-6 ring-8 ring-rose-50/50">
                <svg class="w-12 h-12 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>

            <span class="inline-block px-3.5 py-1 bg-rose-100/80 text-rose-700 text-xs font-bold rounded-full mb-3 tracking-wider">403 FORBIDDEN</span>
            <h1 class="text-3xl font-black text-slate-900 mb-3 tracking-tight">Access Denied</h1>
            <p class="text-slate-500 text-base leading-relaxed mb-8">You don't have permission to access this resource. If you believe this is an error, please contact your administrator.</p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
                <a asp-controller="Home" asp-action="Index"
                   class="w-full sm:w-auto px-6 py-3 bg-[#345e69] hover:bg-[#2a4b55] text-white font-bold rounded-xl shadow-lg shadow-[#345e69]/20 transform active:scale-95 transition-all">
                    Return to Home
                </a>
                <button onclick="window.history.back()"
                        class="w-full sm:w-auto px-6 py-3 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 font-bold rounded-xl transition-all">
                    Go Back
                </button>
            </div>
        </div>
    </div>
</div>