
@model Sohba.Application.DTOs.UserAggregate.ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <div class="flex justify-center">
                <div class="bg-[#345e69] w-16 h-16 flex items-center justify-center rounded-2xl shadow-lg">
                    <span class="text-white text-3xl font-black">S</span>
                </div>
            </div>
            <h2 class="mt-6 text-center text-3xl font-black text-gray-900">Reset Password</h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Enter your new password below.
            </p>
        </div>

        <form asp-action="ResetPassword" method="post" class="mt-8 space-y-6">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="NewPassword" class="block text-sm font-bold text-gray-700 mb-2">New Password</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-4 text-gray-400 flex items-center justify-center pointer-events-none">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </span>
                        <input asp-for="NewPassword" type="password"
                               class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all"
                               placeholder="Enter your new password" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-bold text-gray-700 mb-2">Confirm New Password</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-4 text-gray-400 flex items-center justify-center pointer-events-none">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </span>
                        <input asp-for="ConfirmPassword" type="password"
                               class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all"
                               placeholder="Confirm your new password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1"></span>
                </div>
            </div>

            <button type="submit"
                    class="w-full py-3 bg-[#345e69] hover:bg-[#2a4b55] text-white font-bold rounded-xl shadow-lg shadow-[#345e69]/30 transform active:scale-95 transition-all">
                Update Password
            </button>

            <div class="text-center">
                <a asp-action="Login" class="text-sm font-semibold text-[#345e69] hover:text-[#2a4b55] transition-colors">
                    Back to Sign In
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}