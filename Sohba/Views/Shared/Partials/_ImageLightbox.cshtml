<div id="imageLightbox" class="fixed inset-0 z-[1000] hidden">
    <div class="absolute inset-0 bg-black/85" onclick="SohbaApp.closeImageLightbox()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <button onclick="SohbaApp.closeImageLightbox()"
                class="absolute top-4 right-4 z-10 p-2 bg-black/50 hover:bg-black/70 text-white rounded-full transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <img id="imageLightboxImg" src="" alt="" class="max-w-full max-h-full rounded-lg object-contain" onclick="event.stopPropagation()" />
    </div>
</div>