@using System.Globalization
@using System.Text.RegularExpressions
@using Sohba.Application.DTOs.PostAggregate
@using Sohba.Domain.Enums
@model IEnumerable<PostResponseDto>

@functions {
    private string GetTimeAgo(DateTime createdAt)
    {
        var timeSpan = DateTime.UtcNow - createdAt;

        if (timeSpan.TotalSeconds < 60)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)(timeSpan.TotalDays / 7)}w ago";
        if (timeSpan.TotalDays < 365)
            return $"{(int)(timeSpan.TotalDays / 30)}mo ago";

        return $"{(int)(timeSpan.TotalDays / 365)}y ago";
    }

    private string GetPrivacyIcon(PostPrivacy privacy)
    {
        return privacy switch
        {
            PostPrivacy.Private => "<svg class='w-3 h-3' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z' /></svg> Private" ,
            PostPrivacy.Friends => "<svg class='w-3 h-3' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' /></svg> Public",
            _ => "<svg ...> Public"

        };
    }
    private string GetReactionClass(string? type)
    {
        if (string.IsNullOrEmpty(type)) return "text-slate-600 hover:bg-slate-100";
        return type switch
        {
            "Like" => "text-blue-700 bg-blue-100 hover:bg-blue-200",     
            "Love" => "text-rose-700 bg-rose-100 hover:bg-rose-200",     
            "Haha" => "text-amber-600 bg-amber-100 hover:bg-amber-200",  
            "Wow" => "text-orange-700 bg-orange-100 hover:bg-orange-200",
            "Sad" => "text-indigo-700 bg-indigo-100 hover:bg-indigo-200",
            "Angry" => "text-red-700 bg-red-100 hover:bg-red-200",       
            _ => "text-slate-600 hover:bg-slate-100"
        };
    }
}
<div class="page-transition">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-2xl mb-6 flex items-center gap-3">
            <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span class="font-medium">@ViewBag.ErrorMessage</span>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="flex flex-col items-center justify-center py-16 text-center bg-white rounded-3xl border border-dashed border-slate-200">
            <div class="bg-slate-100 p-6 rounded-3xl mb-5">
                <svg class="w-16 h-16 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-2">No posts yet</h3>
            <p class="text-slate-500 text-sm max-w-xs mx-auto">Start following friends or create your first post!</p>
            <a asp-controller="Posts" asp-action="Create" class="mt-5 px-6 py-2.5 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">
                Create Post
            </a>
        </div>
    }
    else
    {
        <div class="space-y-5">
            @foreach (var post in Model)
            {
                var menuId = $"menu-{post.Id}";
                var timeAgo = GetTimeAgo(post.CreatedAt);
                var hasImage = !string.IsNullOrEmpty(post.ImageUrl);

                <article class="bg-white rounded-3xl border border-slate-200 overflow-hidden" data-post-id="@post.Id" data-reactions="@post.ReactionsCount">

                    @* Header *@
                    <div class="p-4 sm:p-5 flex items-center justify-between">
                        <div class="flex items-center gap-3.5">
                            <div class="relative">
                                <div class="w-12 h-12 rounded-2xl overflow-hidden ring-2 ring-slate-100">
                                    <img src="https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(post.AuthorName ?? "User"))&background=345e69&color=fff&size=128"
                                         class="w-full h-full object-cover"
                                         alt="@post.AuthorName"
                                         onerror="this.src='https://ui-avatars.com/api/?name=User&background=345e69&color=fff'">
                                </div>
                                <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-emerald-500 border-2 border-white rounded-full"></span>
                            </div>

                            <div>
                                <h4 class="font-bold text-slate-800 text-sm sm:text-base">@post.AuthorName</h4>
                                <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-500">
                                    <span title="@post.CreatedAt.ToString("MMM dd, yyyy HH:mm")">@timeAgo</span>

                                    @if (post.SourceType != "User")
                                    {
                                        <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
                                        <span class="flex items-center gap-1">
                                            @if (post.SourceType == "Group")
                                            {
                                                <svg class="w-3 h-3 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                                </svg>
                                            }
                                            else if (post.SourceType == "Page")
                                            {
                                                <svg class="w-3 h-3 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                                                </svg>
                                            }
                                            <a asp-controller="@post.SourceType" asp-action="Details" asp-route-id="@post.SourceId"
                                               class="hover:underline font-medium">
                                                @post.SourceName
                                            </a>
                                        </span>
                                    }
                                    <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
                                    <span class="flex items-center gap-1">@Html.Raw(GetPrivacyIcon(post.Privacy))</span>
                                </div>
                            </div>
                        </div>

                        @* Menu *@
                        <div class="relative">
                            <button aria-label="Post options" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl" onclick="SohbaApp.toggleMenu('@menuId')">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
                                </svg>
                            </button>

                            <div id="@menuId" class="hidden absolute right-0 top-11 w-52 bg-white rounded-2xl shadow-xl border border-slate-200 z-50 overflow-hidden">
                                <div class="py-1.5">
                                    <button data-save-button="@post.Id"
                                            onclick="SohbaApp.toggleSavePost('@post.Id', @(post.IsSaved ? "true" : "false"))"
                                            class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 text-slate-700 text-sm @(post.IsSaved ? "text-amber-600 bg-amber-50" : "")">
                                        @if (post.IsSaved)
                                        {
                                            @if (post.IsFavorite)
                                            {
                                                <svg class="w-5 h-5 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                                                </svg>
                                            }
                                        }
                                        else
                                        {
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                                            </svg>
                                        }

                                        <span class="btn-text">
                                            @(post.IsSaved ? "Saved" : "Save Post")
                                        </span>
                                    </button>

                                    <button data-fav-button="@post.Id"
                                            onclick="SohbaApp.addToFavorites('@post.Id')"
                                            class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 text-slate-700 text-sm @(post.IsFavorite ? "text-pink-600 bg-pink-50" : "")">
                                        @if (post.IsFavorite)
                                        {
                                            <svg class="w-5 h-5 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                            </svg>
                                        }

                                        <span class="btn-text">
                                            @(post.IsFavorite ? "Favorited" : "Add to Favorites")
                                        </span>
                                    </button>
                                    <hr class="border-slate-100 my-1">
                                    @if (post.IsAuthor || User.IsInRole("Admin"))
                                    {
                                        <button onclick="SohbaApp.editPostModal('@post.Id')" class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 text-slate-700 text-sm">
                                            <!-- edit icon -->
                                            Edit Post
                                        </button>
                                        <button onclick="SohbaApp.deletePost('@post.Id')" class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-red-50 text-red-600 text-sm">
                                            <!-- delete icon -->
                                            Delete Post
                                        </button>
                                        <hr class="border-slate-100 my-1">
                                    }

                                    <button data-report-button="@post.Id"
                                            onclick="SohbaApp.reportPost('@post.Id')"
                                            class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-red-50 text-red-600 text-sm @(post.IsReportedByCurrentUser ? "opacity-50 cursor-not-allowed" : "")"
                                            @(post.IsReportedByCurrentUser ? "disabled" : "")>

                                        @if (post.IsReportedByCurrentUser)
                                        {
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            <span>Reported</span>
                                        }
                                        else
                                        {
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                            </svg>
                                            <span>Report Post</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Content Section *@
                    <div class="px-4 sm:px-5 pb-3">
                        <h3 class="post-title font-bold text-slate-800 text-lg mb-2">@post.Title</h3>

                        @using System.Text.RegularExpressions
                        @{
                            var contentWithLinks = Regex.Replace(
                                post.Content ?? "",
                                                        @"#([A-Za-z_][A-Za-z0-9_]*)",
                                                    "<a href='/Posts/Hashtag?tag=$1' class='text-[#345e69] hover:underline font-bold'>#$1</a>"
                                );
                        }

                        <p class="post-content text-slate-600 leading-relaxed text-sm sm:text-base whitespace-pre-line">
                            @Html.Raw(contentWithLinks)
                        </p>
                    </div>

                    @* Media *@
                    @if (hasImage)
                    {
                        <div class="mt-2 bg-slate-100 cursor-pointer" onclick="SohbaApp.openPostModal('@post.Id')">
                            <div class="aspect-[16/9] overflow-hidden">
                                <img src="@post.ImageUrl" 
                                    class="post-image w-full h-full object-cover" 
                                    alt="Post image" 
                                    loading="lazy"
                                     onerror="this.style.display='none'">
                            </div>
                        </div>
                    }

                    @* Engagement Stats *@
                    <div class="px-4 sm:px-5 py-3 flex items-center justify-between border-b border-slate-100">
                        <div class="flex items-center gap-1.5">
                            <div class="flex -space-x-1.5">
                                <span class="w-5 h-5 rounded-full bg-blue-500 flex items-center justify-center text-white text-[8px] border border-white">👍</span>
                                <span class="w-5 h-5 rounded-full bg-red-500 flex items-center justify-center text-white text-[8px] border border-white">❤️</span>
                                @if (post.ReactionsCount > 2)
                                {
                                    <span class="w-5 h-5 rounded-full bg-slate-200 flex items-center justify-center text-[8px] text-slate-600 border border-white font-bold">+@(post.ReactionsCount - 2)</span>
                                }
                            </div>
                            <span class="text-xs text-slate-500 font-medium reaction-count-@post.Id">
                                @post.ReactionsCount @(post.ReactionsCount == 1 ? "reaction" : "reactions")
                            </span>
                        </div>

                        <div class="flex items-center gap-4 text-xs text-slate-500">
                            <button onclick="SohbaApp.openPostModal('@post.Id', 'comments')"
                                    class="hover:text-[#345e69]">

                                <span id="comments-count-@post.Id">
                                    @post.CommentsCount
                                </span>

                                <span id="comments-label-@post.Id">
                                    @(post.CommentsCount == 1 ? "comment" : "comments")
                                </span>

                            </button>


                            <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
                           
                        </div>
                    </div>

                    @* Action Buttons *@
                    <div class="px-2 py-1.5 flex items-center justify-between">
                        <div class="flex-1 relative">
                            @{
                                var currentReaction = post.CurrentUserReaction;
                                var likeIcon = currentReaction switch
                                {
                                                    "Like" => "👍",
                                                    "Love" => "❤️",
                                                    "Haha" => "😂",
                                                    "Wow" => "😮",
                                                    "Sad" => "😢",
                                                    "Angry" => "😠",
                                    _ => "React"
                                };
                                var likeText = currentReaction == "React" ? "" : currentReaction;
                                var reactionClass = GetReactionClass(currentReaction);
                            }

                            <button data-like-button="@post.Id"
                                    data-current-reaction="@currentReaction"
                                    aria-label="React to post"
                                    onclick="SohbaApp.toggleReactionPicker('@post.Id')"
                                    class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl transition-all duration-200 @reactionClass font-bold">
                                <span class="like-icon">@likeIcon</span>
                                <span class="like-text font-semibold text-sm">@likeText</span>
                            </button>


                            <div id="reaction-picker-@post.Id" class="hidden absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-2 bg-white rounded-2xl shadow-xl border border-slate-200 flex items-center gap-1 z-20">
                                <button onclick="SohbaApp.reactToPost('@post.Id', 'Like')" class="p-2 hover:scale-110 transition text-2xl" title="Like" aria-label="React with Like">👍</button>
                                <button onclick="SohbaApp.reactToPost('@post.Id', 'Love')" class="p-2 hover:scale-110 transition text-2xl" title="Love" aria-label="React with White Heart">❤️</button>
                                <button onclick="SohbaApp.reactToPost('@post.Id', 'Haha')" class="p-2 hover:scale-110 transition text-2xl" title="Haha" aria-label="React with Laugh">😂</button>
                                <button onclick="SohbaApp.reactToPost('@post.Id', 'Wow')" class="p-2 hover:scale-110 transition text-2xl" title="Wow" aria-label="React with WOW">😮</button>
                                <button onclick="SohbaApp.reactToPost('@post.Id', 'Sad')" class="p-2 hover:scale-110 transition text-2xl" title="Sad" aria-label="React with Sad">😢</button>
                                <button onclick="SohbaApp.reactToPost('@post.Id', 'Angry')" class="p-2 hover:scale-110 transition text-2xl" title="Angry" aria-label="React with Angry">😠</button>
                            </div>
                        </div>

                        <button onclick="SohbaApp.openPostModal('@post.Id', 'comments')" class="flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl hover:bg-slate-50 text-slate-600 transition-colors">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                            </svg>
                            <span class="font-semibold text-sm">Comment</span>
                        </button>

                        <button onclick="SohbaApp.sharePost('@post.Id')" class="flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl hover:bg-slate-50 text-slate-600 transition-colors">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                            </svg>
                            <span class="font-semibold text-sm">Share</span>
                        </button>
                    </div>
                </article>
            }
        </div>
    }




</div>
