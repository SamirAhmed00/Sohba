@* // Right Sidebar *@

<div class="hidden xl:block col-span-4 sticky top-24 space-y-6 h-[calc(100vh-6rem)] overflow-y-auto custom-scrollbar pb-10">

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
        <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-gray-900 text-base">People You May Know</h3>
            <a asp-controller="Friends" asp-action="Suggestions" class="text-[#345e69] text-xs font-bold hover:underline">See All</a>
        </div>
        <div id="friendSuggestionsContainer" class="space-y-4">
            <div class="text-xs text-center text-slate-400 py-2">Loading suggestions...</div>
        </div>
    </div>
    @* Trending Hashtags *@
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
        <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-gray-900 text-base">Trends For You</h3>
            <button class="text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </button>
        </div>

        <div id="trendingHashtagsContainer" class="space-y-4">
            @if (ViewBag.TrendingHashtags != null)
            {
                @foreach (var hashtag in ViewBag.TrendingHashtags)
                {
                    <div class="hover:bg-slate-50 p-2 rounded-lg cursor-pointer transition-colors -mx-2" data-hashtag-tag="@hashtag.Tag">
                        <div class="flex justify-between items-start">
                            <span class="text-xs text-gray-400 font-medium">Trending</span>
                        </div>
                        <a href="/Posts/Hashtag?tag=@Uri.EscapeDataString(hashtag.Tag)" class="block">
                            <h4 class="font-bold text-gray-800 text-sm mt-0.5 hover:text-[#345e69]">
                                #@hashtag.Tag
                            </h4>
                        </a>
                        <p class="text-xs text-gray-400 mt-1">@(hashtag.Count.ToString("N0")) posts</p>
                    </div>
                }
            }
            else
            {
                <div class="text-xs text-center text-slate-400 py-4">No trends available</div>
            }
        </div>

        <button type="button" id="showMoreHashtagsBtn" class="w-full text-[#345e69] text-sm font-bold mt-2 hover:bg-[#345e69]/5 p-2 rounded-lg transition-colors">
            Show More
        </button>
    </div>

    <div class="text-[11px] text-gray-400 px-2 leading-relaxed">
        <a href="#" class="hover:underline">Privacy</a> •
        <a href="#" class="hover:underline">Terms</a> •
        <a href="#" class="hover:underline">Advertising</a> •
        <a href="#" class="hover:underline">Cookies</a> •
        <span>Sohba © 2026</span>
    </div>
</div>

