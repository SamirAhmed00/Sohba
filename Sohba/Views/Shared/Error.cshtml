@model ErrorViewModel
@{
    var statusCode = Model.StatusCode ?? 500;
    Layout = null;
    var (title, badge, badgeColor, message) = statusCode switch
    {
        404 => ("Page Not Found", "ERROR 404", "#345e69", "We couldn't find the page you're looking for. It might have been moved or removed."),
        429 => ("Too Many Requests", "RATE LIMITED", "#b45309", "You're sending requests too quickly. Please wait a moment and try again."),
        _ => ("Something Went Wrong", "ERROR 500", "#be123c", "Something went wrong while processing your request. Please try again.")
    };
    ViewData["Title"] = title;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Sohba</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(160deg, #f0f4f3, #ffffff);
                color: #1e293b;
                padding: 24px;
            }

            .card {
                max-width: 460px;
                width: 100%;
                text-align: center;
                background: #fff;
                border: 1px solid #e8eef0;
                border-radius: 24px;
                padding: 48px 32px;
                box-shadow: 0 24px 60px -30px rgba(31, 65, 75, 0.25);
            }

            .icon {
                width: 88px;
                height: 88px;
                margin: 0 auto 24px;
                border-radius: 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #eef4f3;
            }

                .icon svg {
                    width: 42px;
                    height: 42px;
                    stroke: #345e69;
                }

            .badge {
                display: inline-block;
                padding: 5px 14px;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: .1em;
                color: #fff;
                background: var(--badge);
                margin-bottom: 14px;
            }

            h1 {
                font-size: 26px;
                font-weight: 800;
                letter-spacing: -.02em;
                margin-bottom: 10px;
            }

            p {
                font-size: 15px;
                color: #64748b;
                line-height: 1.65;
                margin-bottom: 28px;
            }

            .actions {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                justify-content: center;
            }

            .btn {
                padding: 12px 22px;
                border-radius: 12px;
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                cursor: pointer;
                border: 1px solid transparent;
                transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
            }

                .btn:active {
                    transform: scale(.96);
                }

            .btn-primary {
                background: #345e69;
                color: #fff;
            }

                .btn-primary:hover {
                    background: #2a4b55;
                    box-shadow: 0 10px 24px -10px rgba(52,94,105,.5);
                }

            .btn-ghost {
                background: #f1f5f9;
                color: #334155;
            }

                .btn-ghost:hover {
                    background: #e2e8f0;
                }

            .ref {
                margin-top: 28px;
                padding-top: 20px;
                border-top: 1px solid #f1f5f9;
                font-size: 12px;
                color: #94a3b8;
            }

                .ref code {
                    font-family: monospace;
                    color: #64748b;
                }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">
            @if (statusCode == 404)
            {
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            }
            else if (statusCode == 429)
            {
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            }
            else
            {
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            }
        </div>
        <span class="badge" style="--badge:@badgeColor">@badge</span>
        <h1>@title</h1>
        <p>@message</p>

        <div class="actions">
            @if (statusCode == 429 || statusCode == 500)
            {
                <button class="btn btn-primary" onclick="window.location.reload()">Try Again</button>
            }
            <a asp-controller="Home" asp-action="Index" class="btn @(statusCode == 404 ? "btn-primary" : "btn-ghost")">Back to Home</a>
            <button class="btn btn-ghost" onclick="window.history.back()">Go Back</button>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="ref">Support reference: <code>@Model.RequestId</code></div>
        }
    </div>
</body>
</html>