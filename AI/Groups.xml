        <!-- Right Column: About & Members -->
        <div class="space-y-6">
            <!-- About -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <h3 class="font-black text-gray-900 mb-4">About Community</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                    @Model.Group.Description
                </p>
                <div class="mt-6 pt-6 border-t border-slate-50 space-y-4">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-400">Privacy</span>
                        <span class="font-bold text-gray-700">Public Group</span>
                    </div>
                </div>
            </div>

            <!-- Members (Preview) -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-black text-gray-900">Members (@Model.Members.Count())</h3>
                    <button onclick="switchTab('members')" class="text-[#345e69] text-xs font-bold uppercase">
                        View All
                    </button>
                </div>
                <div class="grid grid-cols-5 gap-2">
                    @foreach (var member in Model.Members.Take(10))
                    {
                        <div class="group cursor-pointer" title="@member.UserName (@member.Role)">
                            <img src="https://ui-avatars.com/api/?name=@member.UserName&background=345e69&color=fff"
                                 class="w-10 h-10 rounded-xl object-cover group-hover:scale-105 transition-transform border-2 border-white shadow-sm" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load group posts when page loads
        document.addEventListener('DOMContentLoaded', function() {
            loadGroupPosts('@Model.Group.Id');
            updateActiveTab('posts');
        });

        function updateActiveTab(tab) {
            document.querySelectorAll('.px-8.border-t button').forEach(btn => {
                btn.classList.remove('border-[#345e69]', 'text-[#345e69]');
                btn.classList.add('border-transparent', 'text-gray-400');
            });

            const activeBtn = Array.from(document.querySelectorAll('.px-8.border-t button'))
                .find(btn => btn.textContent.toLowerCase().includes(tab));

            if (activeBtn) {
                activeBtn.classList.remove('border-transparent', 'text-gray-400');
                activeBtn.classList.add('border-[#345e69]', 'text-[#345e69]');
            }
        }

        async function loadGroupPosts(groupId) {
            try {
                const response = await fetch(`/Groups/GetGroupPosts?groupId=${groupId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const html = await response.text();
                document.getElementById('group-content-area').innerHTML = html;
            } catch (error) {
                console.error('Error loading posts:', error);
                document.getElementById('group-content-area').innerHTML =
                    '<div class="text-center py-10 text-red-500">Failed to load posts</div>';
            }
        }

        function switchTab(tab) {
            updateActiveTab(tab);

            if (tab === 'members') {
                loadAllMembers('@Model.Group.Id');
            } else if (tab === 'about') {
                loadAboutTab('@Model.Group.Id');
            } else {
                loadGroupPosts('@Model.Group.Id');
            }

            SohbaApp.toast('Switching to ' + tab, 'info');
        }

        async function loadAboutTab(groupId) {
            try {
                const response = await fetch(`/Groups/GetAboutTab?groupId=${groupId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const html = await response.text();
                document.getElementById('group-content-area').innerHTML = html;
            } catch (error) {
                console.error('Error loading about tab:', error);
                document.getElementById('group-content-area').innerHTML =
                    '<div class="text-center py-10 text-red-500">Failed to load about info</div>';
            }
        }

        async function loadAllMembers(groupId) {
            try {
                const response = await fetch(`/Groups/GetGroupMembers?groupId=${groupId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const html = await response.text();
                document.getElementById('group-content-area').innerHTML = html;
            } catch (error) {
                console.error('Error loading members:', error);
                document.getElementById('group-content-area').innerHTML =
                    '<div class="text-center py-10 text-red-500">Failed to load members</div>';
            }
        }

        async function leaveGroup(groupId) {
            if (!confirm('Are you sure you want to leave this group?')) return;

            const result = await SohbaApp.post('/Groups/Leave', { groupId });
            if (result.success) {
                SohbaApp.toast('Left group successfully', 'success');
                setTimeout(() => window.location.href = '/Groups', 1000);
            } else {
                SohbaApp.toast(result.error || 'Failed to leave group', 'error');
            }
        }

        async function leaveGroup(groupId) {
            showConfirmModal({
                title: 'Leave Group',
                message: 'Are you sure you want to leave this group? You will no longer see posts from this group.',
                type: 'warning',
                confirmText: 'Leave Group',
                onConfirm: async function() {
                    try {
                        const result = await SohbaApp.post('/Groups/Leave', { groupId });

                        if (result.success) {
                            SohbaApp.toast('Left group successfully', 'success');
                            setTimeout(() => window.location.href = '/Groups', 1000);
                        } else {
                            SohbaApp.toast(result.error || 'Failed to leave group', 'error');
                        }
                    } catch (error) {
                        console.error('Error leaving group:', error);
                        SohbaApp.toast('Network error', 'error');
                    }
                }
            });
        }
    </script>
}
</file>

