                          placeholder="What's this group about?"></textarea>
            </div>

            <!-- Current Image Preview -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Current Image</label>
                    <img src="@Model.ImageUrl" class="w-32 h-32 rounded-xl object-cover border border-slate-200" />
