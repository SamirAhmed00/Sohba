                        <h3 class="font-bold text-gray-900 mt-3 text-lg">@post.Title</h3>
                        
                        <p class="text-sm text-gray-600 mt-2 line-clamp-2">@post.Content</p>
                        
                        <div class="flex items-center gap-2 mt-4 text-xs text-gray-500">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>Saved @post.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>

                        <div class="flex items-center gap-2 mt-3">
                            <img src="https://ui-avatars.com/api/?name=@post.AuthorName&background=345e69&color=fff" class="w-6 h-6 rounded-full" />
                            <span class="text-xs text-gray-600">@post.AuthorName</span>
                        </div>

                        <div class="mt-4 pt-3 border-t border-slate-100">
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" 
                               class="text-sm text-[#345e69] font-semibold hover:underline">
                                View Post →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-20">
            <div class="bg-slate-50 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-12 h-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900">No saved posts</h3>
            <p class="text-gray-500 mt-2">Posts you save will appear here</p>
            <a asp-controller="Home" asp-action="Index" class="inline-block mt-4 px-6 py-2 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">
                Browse Feed
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterByTag(tag) {
            window.location.href = tag === 'all' ? '/Posts/SavedPosts' : `/Posts/SavedPosts?tag=${tag}`;
        }
        
        function toggleMenu(postId) {
            document.querySelectorAll('[id^="menu-"]').forEach(m => m.classList.add('hidden'));
            document.getElementById(`menu-${postId}`).classList.toggle('hidden');
        }
        
        async function changeTag(postId, tag) {
            const result = await SohbaApp.post('/Posts/ChangeSavedPostTag', { postId, tag });
            if (result.success) {
                SohbaApp.toast(`Moved to ${tag}`, 'success');
                location.reload();
            }
        }
        
        async function unsavePost(postId) {
            if (!confirm('Remove from saved?')) return;
            const result = await SohbaApp.post('/Posts/RemoveSavedPost', { postId });
            if (result.success) {
                SohbaApp.toast('Removed from saved', 'success');
                document.querySelector(`[data-post-id="${postId}"]`).remove();
                
                // Update count
                const remainingCount = document.querySelectorAll('[data-post-id]').length;
                document.querySelector('.text-gray-500.mt-1').textContent = `${remainingCount} posts saved`;
            }
        }
        
        // Close menus when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('[id^="menu-"]') && !e.target.closest('button[onclick*="toggleMenu"]')) {
                document.querySelectorAll('[id^="menu-"]').forEach(menu => menu.classList.add('hidden'));
            }
        });
    </script>
}
</file>

<file path="Sohba/Views/Shared/Partials/_PostCard.cshtml">
@using System.Globalization
@using Sohba.Application.DTOs.PostAggregate
@using System.Text.RegularExpressions
@model IEnumerable<PostResponseDto>

@functions {
    private string GetTimeAgo(DateTime createdAt)
    {
        var timeSpan = DateTime.UtcNow - createdAt.ToLocalTime();

        if (timeSpan.TotalSeconds < 60)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)(timeSpan.TotalDays / 7)}w ago";
        if (timeSpan.TotalDays < 365)
            return $"{(int)(timeSpan.TotalDays / 30)}mo ago";

        return $"{(int)(timeSpan.TotalDays / 365)}y ago";
    }

    private string GetPrivacyIcon(bool isPrivate)
    {
        return isPrivate ?
            "<svg class='w-3 h-3' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z' /></svg> Private" :
            "<svg class='w-3 h-3' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' /></svg> Public";
    }
    private string GetReactionClass(string? type)
    {
        if (string.IsNullOrEmpty(type)) return "text-slate-600 hover:bg-slate-100";
        return type switch
        {
            "Like" => "text-blue-700 bg-blue-100 hover:bg-blue-200",     
            "Love" => "text-rose-700 bg-rose-100 hover:bg-rose-200",     
            "Haha" => "text-amber-600 bg-amber-100 hover:bg-amber-200",  
            "Wow" => "text-orange-700 bg-orange-100 hover:bg-orange-200",
            "Sad" => "text-indigo-700 bg-indigo-100 hover:bg-indigo-200",
            "Angry" => "text-red-700 bg-red-100 hover:bg-red-200",       
            _ => "text-slate-600 hover:bg-slate-100"
        };
    }
}
