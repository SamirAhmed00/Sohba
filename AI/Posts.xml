                </div>

                <!-- Content Field -->
                <div class="space-y-2">
                    <label asp-for="Content" class="block text-sm font-semibold text-slate-700">
                        Content
                        <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="Content"
                              rows="5"
                              class="w-full px-5 py-4 bg-slate-50 border-2 border-slate-200 rounded-2xl text-slate-800 placeholder:text-slate-400 focus:bg-white focus:border-[#345e69] focus:ring-4 focus:ring-[#345e69]/10 transition-all duration-200 outline-none resize-none"
                              placeholder="What's on your mind? Share your ideas, stories, or questions..."></textarea>
                    <span asp-validation-for="Content" class="text-xs text-red-500 font-medium"></span>
                </div>

                <!-- Image Upload -->
                <div class="space-y-2">
                    <label asp-for="ImageFile" class="block text-sm font-semibold text-slate-700">Image (Optional)</label>
                    <div class="relative group">
                        <input asp-for="ImageFile" type="file" accept="image/*" id="imageInput"
                               class="w-full px-5 py-4 bg-slate-50 border-2 border-dashed border-slate-300 rounded-2xl text-slate-600 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-[#345e69] file:text-white hover:file:bg-[#2a4b55] file:transition-all file:duration-200 cursor-pointer focus:outline-none focus:border-[#345e69] focus:bg-white transition-all duration-200" />
                        <p class="mt-2 text-xs text-slate-500 flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Supported: JPG, PNG, GIF, WEBP • Max: 5MB
                        </p>
                    </div>
                    <span asp-validation-for="ImageFile" class="text-xs text-red-500 font-medium"></span>
                </div>

                <!-- Image Preview -->
                <div id="previewContainer" class="hidden space-y-2 animate-fade-in">
                    <label class="block text-sm font-semibold text-slate-700">Preview</label>
                    <div class="relative inline-block group">
                        <img id="imagePreview" src="" alt="Preview" class="max-h-72 rounded-2xl shadow-lg border border-slate-200 object-cover" />
                        <button type="button" onclick="removeImage()"
                                class="absolute -top-3 -right-3 p-2 bg-red-500 hover:bg-red-600 text-white rounded-full shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-200 group-hover:animate-bounce-subtle">
