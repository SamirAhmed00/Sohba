    .btn-secondary:hover {
        background: var(--soft-bg);
        border-color: var(--brand-color);
        color: var(--brand-color);
    }

.btn-primary {
    background: var(--brand-color);
    color: white;
    padding: 16px 32px;
    border-radius: 12px;
