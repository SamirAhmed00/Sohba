    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 10;
}

.hero-text h1 {
    font-size: 56px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 24px;
    letter-spacing: -1.5px;
}

.hero-text .highlight {
    background: linear-gradient(to right, var(--brand-color), var(--brand-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-text p {
    font-size: 18px;
    color: var(--text-secondary);
    margin-bottom: 32px;
    max-width: 480px;
    line-height: 1.7;
}

.hero-cta {
    display: flex;
    gap: 16px;
}

.btn-large {
    padding: 16px 32px;
    font-size: 16px;
    border-radius: 12px;
