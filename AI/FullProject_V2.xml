.hero-visual {
    position: relative;
    perspective: 1000px;
}

.phone-mockup {
    background: white;
    border-radius: 24px;
    padding: 16px;
    box-shadow: 0 25px 50px -12px rgba(52, 94, 105, 0.2), 0 0 0 1px rgba(52, 94, 105, 0.05);
    transform: rotateY(-8deg) rotateX(4deg);
    transition: transform 0.6s ease;
}

    .phone-mockup:hover {
        transform: rotateY(-4deg) rotateX(2deg);
