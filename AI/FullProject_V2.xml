<file path="Sohba/Views/Groups/Details.cshtml">
@model Sohba.ViewModels.Group.GroupDetailsViewModel
@{
    ViewData["Title"] = Model.Group.Name;
    Layout = "_AppLayout";
    var activeTab = ViewBag.ActiveTab ?? "posts";
}
@Html.AntiForgeryToken()
<div class="max-w-7xl mx-auto page-transition px-4">
    <!-- Header -->
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden mb-6">
        <div class="h-48 bg-gradient-to-r from-[#345e69] to-[#4a8291] relative">
            <div class="absolute -bottom-12 left-8">
                <div class="w-32 h-32 bg-white p-2 rounded-3xl shadow-lg">
                    @if (!string.IsNullOrEmpty(Model.Group.ImageUrl))
                    {
                        <img src="@Model.Group.ImageUrl" class="w-full h-full rounded-2xl object-cover" />
                    }
                    else
                    {
                        <div class="w-full h-full bg-slate-100 rounded-2xl flex items-center justify-center text-[#345e69] text-4xl font-black">
                            @Model.Group.Name[0]
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="pt-16 pb-6 px-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h1 class="text-3xl font-black text-gray-900">@Model.Group.Name</h1>
                <p class="text-gray-500 mt-1 flex items-center gap-2">
                    <span class="font-medium text-[#345e69]">@Model.Members.Count() Members</span>
                    <span>•</span>
                    <span>Created by @Model.Group.AdminName</span>
                </p>
            </div>

            <div class="flex items-center gap-3">
                @* @if (User.Identity?.Name == Model.Group.AdminName) *@
                @* { *@
                    <a asp-action="Edit" asp-route-id="@Model.Group.Id" class="px-5 py-2.5 bg-slate-100 text-gray-700 font-bold rounded-xl hover:bg-slate-200 transition-all flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                        Edit Group
                    </a>
                @* } *@
                <button onclick="leaveGroup('@Model.Group.Id')" class="px-5 py-2.5 bg-red-50 text-red-600 font-bold rounded-xl hover:bg-red-100 transition-all">
                    Leave
                </button>

                @*We Will Comment The Upper Button Leave And Uncomment That -- In Testing *@
                @* @if (Model.Group.IsCurrentUserMember)
                {
                    <button onclick="leaveGroup('@Model.Group.Id')"
                            class="px-5 py-2.5 bg-red-50 text-red-600 font-bold rounded-xl hover:bg-red-100 transition-all">
                        Leave Group
                    </button>
                }
                else
                {
                    <button onclick="joinGroup('@Model.Group.Id')"
                            class="px-5 py-2.5 bg-[#345e69] text-white font-bold rounded-xl hover:bg-[#2a4b55] transition-all">
                        Join Group
                    </button>
                } *@
            </div>
        </div>

        <!-- Tabs -->
        <div class="px-8 border-t border-slate-50 flex gap-8">
            <button onclick="switchTab('posts')" class="py-4 border-b-2 border-[#345e69] text-[#345e69] font-bold text-sm">Posts</button>
            <button onclick="switchTab('members')" class="py-4 border-b-2 border-transparent text-gray-400 hover:text-gray-600 font-bold text-sm">Members</button>
            <button onclick="switchTab('about')" class="py-4 border-b-2 border-transparent text-gray-400 hover:text-gray-600 font-bold text-sm">About</button>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column: Posts -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-[#345e69]/10 flex items-center justify-center text-[#345e69] font-bold">U</div>
                <a asp-controller="Posts" asp-action="Create" asp-route-groupId="@Model.Group.Id"
                   class="flex-1 bg-slate-50 hover:bg-slate-100 text-left px-5 py-2.5 rounded-xl text-gray-500 transition-all border border-slate-100">
                    Share something with the group...
                </a>
            </div>

            <div id="group-content-area">
                <partial name="Partials/_PostCard" model="ViewBag.Posts" />
            </div>
        </div>

        <!-- Right Column: About & Members -->
        <div class="space-y-6">
            <!-- About -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <h3 class="font-black text-gray-900 mb-4">About Community</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                    @Model.Group.Description
                </p>
                <div class="mt-6 pt-6 border-t border-slate-50 space-y-4">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-400">Privacy</span>
                        <span class="font-bold text-gray-700">Public Group</span>
                    </div>
                </div>
            </div>

            <!-- Members (Preview) -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-black text-gray-900">Members (@Model.Members.Count())</h3>
                    <button onclick="switchTab('members')" class="text-[#345e69] text-xs font-bold uppercase">
                        View All
                    </button>
                </div>
                <div class="grid grid-cols-5 gap-2">
                    @foreach (var member in Model.Members.Take(10))
                    {
                        <div class="group cursor-pointer" title="@member.UserName (@member.Role)">
                            <img src="https://ui-avatars.com/api/?name=@member.UserName&background=345e69&color=fff"
                                 class="w-10 h-10 rounded-xl object-cover group-hover:scale-105 transition-transform border-2 border-white shadow-sm" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load group posts when page loads
        document.addEventListener('DOMContentLoaded', function() {
            loadGroupPosts('@Model.Group.Id');
            updateActiveTab('posts');
        });

        function updateActiveTab(tab) {
            document.querySelectorAll('.px-8.border-t button').forEach(btn => {
                btn.classList.remove('border-[#345e69]', 'text-[#345e69]');
                btn.classList.add('border-transparent', 'text-gray-400');
            });

            const activeBtn = Array.from(document.querySelectorAll('.px-8.border-t button'))
                .find(btn => btn.textContent.toLowerCase().includes(tab));

            if (activeBtn) {
                activeBtn.classList.remove('border-transparent', 'text-gray-400');
                activeBtn.classList.add('border-[#345e69]', 'text-[#345e69]');
            }
        }

        async function loadGroupPosts(groupId) {
            try {
                const response = await fetch(`/Groups/GetGroupPosts?groupId=${groupId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const html = await response.text();
                document.getElementById('group-content-area').innerHTML = html;
            } catch (error) {
                console.error('Error loading posts:', error);
                document.getElementById('group-content-area').innerHTML =
                    '<div class="text-center py-10 text-red-500">Failed to load posts</div>';
            }
        }

        function switchTab(tab) {
            updateActiveTab(tab);

            if (tab === 'members') {
                loadAllMembers('@Model.Group.Id');
            } else if (tab === 'about') {
                loadAboutTab('@Model.Group.Id');
            } else {
                loadGroupPosts('@Model.Group.Id');
            }

            SohbaApp.toast('Switching to ' + tab, 'info');
        }

        async function loadAboutTab(groupId) {
            try {
                const response = await fetch(`/Groups/GetAboutTab?groupId=${groupId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const html = await response.text();
                document.getElementById('group-content-area').innerHTML = html;
            } catch (error) {
                console.error('Error loading about tab:', error);
                document.getElementById('group-content-area').innerHTML =
                    '<div class="text-center py-10 text-red-500">Failed to load about info</div>';
            }
        }

        async function loadAllMembers(groupId) {
            try {
                const response = await fetch(`/Groups/GetGroupMembers?groupId=${groupId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const html = await response.text();
                document.getElementById('group-content-area').innerHTML = html;
            } catch (error) {
                console.error('Error loading members:', error);
                document.getElementById('group-content-area').innerHTML =
                    '<div class="text-center py-10 text-red-500">Failed to load members</div>';
            }
        }

        async function leaveGroup(groupId) {
            if (!confirm('Are you sure you want to leave this group?')) return;

            const result = await SohbaApp.post('/Groups/Leave', { groupId });
            if (result.success) {
                SohbaApp.toast('Left group successfully', 'success');
                setTimeout(() => window.location.href = '/Groups', 1000);
            } else {
                SohbaApp.toast(result.error || 'Failed to leave group', 'error');
            }
        }

        async function leaveGroup(groupId) {
            showConfirmModal({
                title: 'Leave Group',
                message: 'Are you sure you want to leave this group? You will no longer see posts from this group.',
                type: 'warning',
                confirmText: 'Leave Group',
                onConfirm: async function() {
                    try {
                        const result = await SohbaApp.post('/Groups/Leave', { groupId });

                        if (result.success) {
                            SohbaApp.toast('Left group successfully', 'success');
                            setTimeout(() => window.location.href = '/Groups', 1000);
                        } else {
                            SohbaApp.toast(result.error || 'Failed to leave group', 'error');
                        }
                    } catch (error) {
                        console.error('Error leaving group:', error);
                        SohbaApp.toast('Network error', 'error');
                    }
                }
            });
        }
    </script>
}
</file>

<file path="Sohba/Views/Groups/Index.cshtml">
@model IEnumerable<Sohba.Application.DTOs.GroupAndPageAggregate.GroupResponseDto>
@{
    ViewData["Title"] = "Groups";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <!-- Header -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6 ">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-black text-gray-900">Groups</h1>
                <p class="text-gray-500 mt-1">Discover communities</p>
            </div>
            <a asp-action="Create" class="px-4 py-2 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Create Group
            </a>
        </div>
    </div>

    <!-- Groups List -->
    <div class="space-y-4">
        @foreach (var group in Model)
        {
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 hover-lift flex items-center gap-5 transition-all duration-300">
                <div class="relative group/icon">
                    @*TODO : ADD Image To Group Entity*@
                    @if (!string.IsNullOrEmpty(group.ImageUrl))
                    {
                        <img src="@group.ImageUrl" class="w-16 h-16 rounded-2xl object-cover shadow-md border border-slate-100 transform transition-transform group-hover/icon:scale-105" alt="@group.Name" />
                    }
                    else
                    { 
                        <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center relative overflow-hidden shadow-sm border border-slate-200 transform transition-transform group-hover/icon:scale-105">
                            <span class="relative z-10 text-[#345e69] text-2xl font-black tracking-tighter">
                                @group.Name[0].ToString().ToUpper()
                            </span>

                            <div class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent pointer-events-none"></div>
                        </div>
                     } 

                    @if (group.IsCurrentUserMember)
                    {
                        <div class="absolute -top-1 -right-1 w-4 h-4 bg-green-500 border-2 border-white rounded-full shadow-sm z-20"></div>
                    }
                </div>

                <div class="flex-1">
                    <div class="flex items-center gap-2">
                        <h3 class="font-black text-gray-800 text-lg leading-tight">@group.Name</h3>
                        @if (group.IsCurrentUserMember)
                        {
                            <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
                            </svg>
                        }
                    </div>
                    <p class="text-gray-500 text-sm line-clamp-1 mt-0.5">@group.Description</p>

                    <div class="flex items-center gap-3 mt-3">
                        <div class="flex items-center gap-1.5 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-100">
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                            <span class="text-xs font-bold text-slate-600">@group.MembersCount</span>
                        </div>
                        <span class="text-slate-300">•</span>
                        <span class="text-xs font-medium text-slate-400">Admin: <span class="text-[#345e69] font-bold">@group.AdminName</span></span>
                    </div>
                </div>

                <div class="flex items-center">
                    @if (group.IsCurrentUserMember)
                    {
                        <a asp-action="Details" asp-route-id="@group.Id" class="px-6 py-2.5 bg-green-50 text-green-700 font-bold rounded-xl hover:bg-green-100 transition-all border border-green-100">
                            View Group
                        </a>
                    }
                    else
                    {
                        <button onclick="joinGroup('@group.Id', this)" class="px-6 py-2.5 bg-[#345e69] text-white font-bold rounded-xl hover:bg-[#2a4b55] shadow-md shadow-[#345e69]/20 transition-all active:scale-95">
                            Join
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-20">
            <div class="bg-slate-50 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-12 h-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900">No groups yet</h3>
            <p class="text-gray-500 mt-2">Create or join a group!</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function joinGroup(groupId, button) {
            const result = await SohbaApp.post('/Groups/Join', { groupId });
            if (result.success) {
                SohbaApp.toast('Joined group successfully!', 'success');
                // Update button UI
                button.outerHTML = '<span class="px-6 py-2 bg-green-100 text-green-700 font-semibold rounded-xl">Member</span>';
            } else {
                SohbaApp.toast(result.error || 'Failed to join', 'error');
            }
        }
    </script>
}
