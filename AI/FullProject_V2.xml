<file path="Sohba/Views/Dashboard/Users.cshtml">
@model Sohba.ViewModels.Dashboard.DashboardUsersViewModel
@{
    ViewData["Title"] = "Manage Users";
    // Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <!-- Header -->
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-6 mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-black text-gray-900">Users</h1>
                <p class="text-gray-500 mt-1">Manage all users in the platform</p>
            </div>
            <div class="text-sm text-gray-500">
                Total: <span class="font-bold text-gray-900">@Model.TotalCount</span>
            </div>
        </div>

        <!-- Filters -->
        <div class="flex flex-wrap gap-4 mt-6">
            <div class="flex-1 min-w-[200px]">
                <div class="relative">
                    <input type="text"
                           id="searchInput"
                           value="@Model.SearchTerm"
                           placeholder="Search by name or email..."
                           class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20" />
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </span>
                </div>
            </div>
            <select id="statusFilter" class="px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20">
                <option value="all" selected="@(Model.StatusFilter == "all")">All Users</option>
                <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                <option value="blocked" selected="@(Model.StatusFilter == "blocked")">Blocked</option>
            </select>
            <button onclick="applyFilters()" class="px-6 py-2 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">
                Apply Filters
            </button>
        </div>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">User</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Email</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Joined</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Status</th>
                        <th class="px-6 py-4 text-left text-sm font-bold text-gray-600">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr class="hover:bg-slate-50 transition-colors" data-user-id="@user.Id">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <img src="@(user.ProfilePictureUrl ?? $"https://ui-avatars.com/api/?name={user.Name}&background=345e69&color=fff")"
                                             class="w-10 h-10 rounded-full object-cover" />
                                        <div>
                                            <div class="font-semibold text-gray-900">@user.Name</div>
                                            <div class="text-xs text-gray-500">ID: @user.Id.ToString().Substring(0, 8)...</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-600">@user.Email</td>
                                <td class="px-6 py-4 text-sm text-gray-600">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4">
                                    <span class="status-badge px-3 py-1 bg-green-100 text-green-700 text-xs font-bold rounded-full">Active</span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        <button onclick="viewUser('@user.Id')" class="p-2 text-blue-600 hover:bg-blue-50 rounded-xl transition-colors" title="View">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                        </button>
                                        <button onclick="blockUser('@user.Id')" class="p-2 text-orange-600 hover:bg-orange-50 rounded-xl transition-colors" title="Block">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                            </svg>
                                        </button>
                                        <button onclick="deleteUser('@user.Id')" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-colors" title="Delete">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                                No users found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalCount > Model.PageSize)
        {
            <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between">
                <div class="text-sm text-gray-500">
                    Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) of @Model.TotalCount users
                </div>
                <div class="flex gap-2">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="Users" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter"
                           class="px-4 py-2 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors">
                            Previous
                        </a>
                    }
                    @if (Model.CurrentPage < (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize))
                    {
                        <a asp-action="Users" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter"
                           class="px-4 py-2 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors">
                            Next
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- User Details Modal -->
<div id="userModal" class="fixed inset-0 z-[200] hidden">
    <div class="absolute inset-0 bg-black/60" onclick="closeUserModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden">
            <div class="flex items-center justify-between p-4 border-b">
                <h3 class="text-lg font-bold text-gray-900">User Details</h3>
                <button onclick="closeUserModal()" class="p-1 text-gray-400 hover:text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div id="userModalContent" class="max-h-[70vh] overflow-y-auto">
                <!-- Content will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            
            var searchTimeout;

            document.addEventListener('DOMContentLoaded', function () {

                const searchInput = document.getElementById('searchInput');
                const statusFilter = document.getElementById('statusFilter');

                if (searchInput) {
                    searchInput.addEventListener('input', function () {
                        clearTimeout(searchTimeout);
                        searchTimeout = setTimeout(function () {
                            window.applyFilters();
                        }, 500);
                    });
                }

                if (statusFilter) {
                    statusFilter.addEventListener('change', function () {
                        window.applyFilters();
                    });
                }

            });

            // =========================
            // Filters
            // =========================
            window.applyFilters = function () {
                const search = document.getElementById('searchInput')?.value || '';
                const status = document.getElementById('statusFilter')?.value || '';

                window.location.href =
                    `/Dashboard/Users?search=${encodeURIComponent(search)}&status=${status}`;
            };

            // =========================
            // Block User
            // =========================
            asyncwindow.blockUser = async function (userId) {
                showConfirmModal({
                    title: 'Block User',
                    message: 'Are you sure you want to block this user? They will not be able to interact with the platform.',
                    type: 'warning',
                    confirmText: 'Block User',
                    onConfirm: async function() {
                        const result = await SohbaApp.post('/Dashboard/BlockUser', { userId });
                        if (result.success) {
                            SohbaApp.toast('User blocked successfully', 'success');

                            const badge = document.querySelector(`tr[data-user-id="${userId}"] .status-badge`);
                            badge.textContent = 'Blocked';
                            badge.className = 'status-badge px-3 py-1 bg-orange-100 text-orange-700 text-xs font-bold rounded-full';

                            const blockBtn = document.querySelector(`tr[data-user-id="${userId}"] button[onclick*="blockUser"]`);
                            blockBtn.outerHTML = `
                                <button onclick="unblockUser('${userId}')" class="p-2 text-green-600 hover:bg-green-50 rounded-xl transition-colors" title="Unblock">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                    </svg>
                                </button>
                            `;
                        } else {
                            SohbaApp.toast(result.error || 'Failed to block user', 'error');
                        }
                    }
                });
            };

            // =========================
            // Unblock User
            // =========================
            window.unblockUser = async function (userId) {
                showConfirmModal({
                    title: 'Unblock User',
                    message: 'Are you sure you want to unblock this user? They will be able to interact with the platform again.',
                    type: 'info',
                    confirmText: 'Unblock User',
                    onConfirm: async function() {
                        const result = await SohbaApp.post('/Dashboard/UnblockUser', { userId });
                        if (result.success) {
                            SohbaApp.toast('User unblocked successfully', 'success');
                            const badge = document.querySelector(`tr[data-user-id="${userId}"] .status-badge`);
                            badge.textContent = 'Active';
                            badge.className = 'status-badge px-3 py-1 bg-green-100 text-green-700 text-xs font-bold rounded-full';
                        } else {
                            SohbaApp.toast(result.error || 'Failed to unblock user', 'error');
                        }
                    }
                });
            };

            // =========================
            // Delete User
            // =========================
            window.deleteUser = async function (userId) {
                showConfirmModal({
                    title: 'Delete User',
                    message: 'Are you sure you want to delete this user? This action cannot be undone.',
                    type: 'delete',
                    confirmText: 'Delete User',
                    onConfirm: async function() {
                        const result = await SohbaApp.post('/Dashboard/DeleteUser', { userId });
                        if (result.success) {
                            SohbaApp.toast('User deleted successfully', 'success');
                            document.querySelector(`tr[data-user-id="${userId}"]`).remove();
                        } else {
                            SohbaApp.toast(result.error || 'Failed to delete user', 'error');
                        }
                    }
                });
            };

            // =========================
            // View User
            // =========================
            window.viewUser = async function (userId) {
                try {
                    const response = await fetch(`/Dashboard/GetUserDetails?userId=${userId}`);
                    const html = await response.text();

                    const modal = document.getElementById('userModal');
                    const content = document.getElementById('userModalContent');

                    if (!modal || !content) return;

                    content.innerHTML = html;
                    modal.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';

                } catch (error) {
                    console.error(error);
                    SohbaApp.toast('Failed to load user details', 'error');
                }
            };

            window.closeUserModal = function () {
                const modal = document.getElementById('userModal');
                if (modal) modal.classList.add('hidden');
                document.body.style.overflow = '';
            };

        })();
    </script>
}
</file>

<file path="Sohba/Views/Friends/Find.cshtml">
@model IEnumerable<Sohba.Application.DTOs.UserAggregate.UserResponseDto>
@{
    ViewData["Title"] = "Find Friends";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <!-- Header -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-black text-gray-900">Find Friends</h1>
                <p class="text-gray-500 mt-1">Search and connect with people</p>
            </div>
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 text-gray-700 font-semibold rounded-xl hover:bg-slate-200 transition-colors">
                Back to Friends
            </a>
        </div>

        <!-- Search Bar -->
        <div class="mt-4 relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>
            <input type="text" id="searchInput" placeholder="Search by name..."
                   class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all" />
        </div>

        <!-- Filter Buttons -->
        <div class="flex gap-2 mt-4">
            <button onclick="filterUsers('all')" class="filter-btn active px-4 py-2 bg-[#345e69] text-white text-sm font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">
                All
            </button>
            <button onclick="filterUsers('mutual')" class="filter-btn px-4 py-2 bg-slate-100 text-gray-700 text-sm font-semibold rounded-xl hover:bg-slate-200 transition-colors">
                Mutual Friends
            </button>
            <button onclick="filterUsers('recent')" class="filter-btn px-4 py-2 bg-slate-100 text-gray-700 text-sm font-semibold rounded-xl hover:bg-slate-200 transition-colors">
                Recently Joined
            </button>
        </div>
    </div>

    <!-- Users Grid -->
    <div id="usersContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var user in Model)
            {
                <div class="user-card bg-white rounded-2xl shadow-sm border border-slate-100 p-5 hover-lift" data-user-id="@user.Id" data-name="@user.Name.ToLower()">
                    <div class="flex items-center gap-4">
                        <div class="relative">
                            <img src="@(user.ProfilePictureUrl ?? $"https://ui-avatars.com/api/?name={user.Name}&background=345e69&color=fff")"
                                 class="w-16 h-16 rounded-2xl object-cover border-2 border-slate-100" />
                            <span class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white"></span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate">@user.Name</h3>
                            <p class="text-sm text-gray-500 mt-1">@user.Bio</p>
                            <p class="text-xs text-gray-400 mt-1">Joined @user.CreatedAt.ToString("MMM yyyy")</p>
                        </div>
                    </div>
                    <div class="flex gap-2 mt-4">
                        <button onclick="sendFriendRequest('@user.Id')"
                                class="flex-1 py-2 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors">
                            Add Friend
                        </button>
                        <button onclick="viewProfile('@user.Id')"
                                class="p-2 text-gray-400 hover:text-[#345e69] hover:bg-slate-50 rounded-xl transition-colors">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    <!-- No Results Message (hidden by default) -->
    <div id="noResultsMessage" class="hidden text-center py-20 bg-white rounded-2xl border border-slate-100">
        <div class="bg-slate-50 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-12 h-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900">No users found</h3>
        <p class="text-gray-500 mt-2">Try searching with a different name</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/features/friends.js"></script>
}
</file>

<file path="Sohba/Views/Friends/Index.cshtml">
@model IEnumerable<Sohba.Application.DTOs.UserAggregate.FriendDto>
@{
    ViewData["Title"] = "Friends";
    Layout = "_AppLayout";
}

<div class="max-w-7xl mx-auto page-transition">
    <!-- Header -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6 ">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-black text-gray-900">Friends</h1>
                <p class="text-gray-500 mt-1">@Model.Count() friends in your network</p>
            </div>

            <div class="flex gap-2">
                <a asp-action="Requests" class="px-4 py-2 bg-slate-100 text-gray-700 font-semibold rounded-xl hover:bg-slate-200 transition-colors flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    Requests
                    <span id="pendingRequestsBadge" class="hidden bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"></span>
                </a>
                <a asp-controller="Friends" asp-action="Suggestions" class="px-4 py-2 bg-[#345e69] text-white font-semibold rounded-xl hover:bg-[#2a4b55] transition-colors flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                    </svg>
                    Find Friends
                </a>
            </div>
        </div>

        <!-- Search -->
        <div class="mt-4 relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>
            <input type="text" placeholder="Search friends..." 
                   class="w-full pl-12 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] transition-all" />
        </div>
    </div>

    <!-- Friends Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var friend in Model)
        {
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 hover-lift group">
                <div class="flex items-center gap-4">
                    <div class="relative">
                        <img src="@(friend.ProfilePictureUrl ?? $"https://ui-avatars.com/api/?name={friend.FriendName}&background=345e69&color=fff")" 
                             class="w-16 h-16 rounded-2xl object-cover border-2 border-slate-100 group-hover:border-[#345e69] transition-colors" />
                        <span class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white"></span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="font-bold text-gray-900 truncate">@friend.FriendName</h3>
                        <p class="text-sm text-gray-500">@friend.Status</p>
                    </div>
                </div>

                <div class="flex gap-2 mt-4">
                    <button class="flex-1 py-2 bg-[#345e69]/10 text-[#345e69] font-semibold rounded-xl hover:bg-[#345e69] hover:text-white transition-colors">
                        Message
                    </button>
                    <button onclick="unfriend('@friend.FriendUserId')" class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-colors">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                    <button onclick="blockUser('@friend.FriendUserId')" class="p-2 text-gray-400 hover:text-orange-500 hover:bg-orange-50 rounded-xl transition-colors" title="Block">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                    </button>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-20">
            <div class="bg-slate-50 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-12 h-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900">No friends yet</h3>
            <p class="text-gray-500 mt-2">Start connecting with people!</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function unfriend(userId) {
            if (!confirm('Are you sure you want to remove this friend?')) return;
            
            const result = await SohbaApp.post('/Friends/Unfriend', { friendId: userId });
            if (result.success) {
                SohbaApp.toast('Friend removed', 'success');
                location.reload();
            } else {
                SohbaApp.toast(result.error || 'Failed to remove friend', 'error');
            }
        }
        async function blockUser(userId) {
            if (!confirm('Are you sure you want to block this user? They will be removed from your friends list.')) return;

            const result = await SohbaApp.post('/Friends/BlockUser', { userId });
            if (result.success) {
                SohbaApp.toast('User blocked', 'success');
                location.reload();
            } else {
                SohbaApp.toast(result.error || 'Failed to block user', 'error');
            }
        }


        async function loadPendingRequestsCount() {
            const response = await fetch('/Friends/GetPendingRequestsCount');
            const data = await response.json();
            if (data.count > 0) {
                const badge = document.getElementById('pendingRequestsBadge');
                badge.textContent = data.count;
                badge.classList.remove('hidden');
            }
        }

        loadPendingRequestsCount();
    </script>
}
</file>

<file path="Sohba/Views/Friends/Suggestions.cshtml">
@model IEnumerable<Sohba.Application.DTOs.UserAggregate.UserResponseDto>
