    .hover-lift:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px -15px rgba(52, 94, 105, 0.15);
    }


.btn-ripple {
    position: relative;
    overflow: hidden;
}

    .btn-ripple::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.6s, height 0.6s;
    }

    .btn-ripple:active::after {
        width: 300px;
        height: 300px;
    }

/* Loading Skeleton Animation */
.skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
    0% {
        background-position: 200% 0;
    }

    100% {
        background-position: -200% 0;
    }
}

/* Story Ring Animation */
.story-ring {
    background: linear-gradient(45deg, #345e69, #4a8291, #345e69);
    background-size: 200% 200%;
    animation: gradientRotate 3s ease infinite;
}

@keyframes gradientRotate {
    0% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }
}

/* Notification Badge Pulse */
.notification-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }

    50% {
        opacity: 0.5;
    }
}

/* Like Heart Animation */
.like-animation {
    animation: heartBeat 0.3s ease-in-out;
}

@keyframes heartBeat {
    0% {
        transform: scale(1);
    }

    25% {
        transform: scale(1.3);
    }

    50% {
        transform: scale(0.95);
    }

    100% {
        transform: scale(1);
    }
}

/* Modal Slide In */
.modal-slide-in {
    animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: scale(0.95) translateY(-10px);
    }

    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

/* Toast Notification */
.toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    padding: 16px 24px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.2);
    transform: translateX(400px);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 9999;
}

    .toast.show {
        transform: translateX(0);
    }

/* Custom Scrollbar */
.custom-scrollbar::-webkit-scrollbar {
    width: 6px;
}

.custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
}

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

/* Glass Morphism Effect */
.glass {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

/* Gradient Text */
.gradient-text {
    background: linear-gradient(135deg, #345e69 0%, #4a8291 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}


/* Dropdown Menu Animation */
[id^="menu-"] {
    transform-origin: top right;
    animation: dropdownFade 0.2s ease;
}

@keyframes dropdownFade {
    from {
        opacity: 0;
        transform: scale(0.95);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* Dropdown Items Hover Effect */
[id^="menu-"] button {
    position: relative;
    overflow: hidden;
}

    [id^="menu-"] button::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        border-radius: 50%;
        background: rgba(52, 94, 105, 0.1);
        transform: translate(-50%, -50%);
        transition: width 0.3s, height 0.3s;
    }

    [id^="menu-"] button:hover::after {
        width: 200%;
        height: 200%;
    }

    [id^="menu-"] button svg {
        transition: transform 0.2s ease;
    }

    [id^="menu-"] button:hover svg {
        transform: scale(1.1);
    }


[id^="menu-"] .py-1.5 {
    padding: 0.5rem 0.25rem;
}

[id^="menu-"] button {
    margin: 0.125rem 0.5rem;
    width: calc(100% - 1rem);
    border-radius: 0.75rem;
}

.active-class {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    background-color: rgba(52, 94, 105, 0.1);
    color: #345e69;
    border-radius: 0.75rem;
    font-weight: 500;
    transition: all 0.2s;
}

    .active-class svg {
        color: #345e69;
        width: 1.5rem;
        height: 1.5rem;
        margin-right: 0.75rem;
    }

    .active-class:hover {
        background-color: rgba(52, 94, 105, 0.15);
    }
