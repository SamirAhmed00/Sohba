                       id="createPostTitle"
                       placeholder="Post title..."
                       class="w-full px-0 py-2 text-gray-900 font-semibold focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] text-xl placeholder:text-gray-400"
                       maxlength="200">
            </div>
            <!-- Post Content -->
            <div class="px-4">
                <textarea id="createPostContent" rows="4"
                          class="w-full px-0 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-[#345e69]/20 focus:border-[#345e69] text-lg resize-none placeholder:text-gray-400"
                          placeholder="What's on your mind, User?"></textarea>
            </div>

            <!-- Image Preview (Hidden by default) -->
            <div id="imagePreviewContainer" class="px-4 pb-4 hidden">
                <div class="relative inline-block">
                    <img id="imagePreview" src="" class="max-h-64 rounded-xl object-cover" alt="Preview">
                    <button onclick="SohbaApp.removeSelectedImage()"
                            class="absolute -top-2 -right-2 bg-gray-800 text-white rounded-full p-1 hover:bg-gray-900">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
